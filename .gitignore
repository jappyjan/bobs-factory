# Dependency directories
node_modules
**/node_modules

# This monorepo uses pnpm — npm/yarn lockfiles should never be committed
package-lock.json
yarn.lock

# Build output
dist/

tempdocs

# Environment variables
.env

# Logs
logs
*.log
npm-debug.log*

