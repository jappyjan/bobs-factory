        {
          "id": "takeover",
          "stepConfigVersion": "step-config-v1",
          "name": "Take over existing work",
          "icon": "🤝",
          "description": "Inspect an existing PR or ticket, clarify remaining work, then continue through the shared factory pipeline. Existing PRs stay draft for human review.",
          "labels": [
            "workflow:takeover",
            "takeover"
          ],
          "steps": [
            {
              "id": "existing-work",
              "configVersion": "step-config-v1",
              "reads": {
