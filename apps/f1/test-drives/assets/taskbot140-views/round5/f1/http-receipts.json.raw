        {
          "id": "factory-pipeline",
          "stepConfigVersion": "step-config-v1",
          "name": "Shared factory pipeline",
          "icon": "🏭",
          "description": "Clarify and plan, then review architecture before coding and deliver repository, external ticket or mixed work with independent evidence and explicit human acceptance.",
          "labels": [],
          "steps": [
            {
              "id": "clarify",
              "configVersion": "step-config-v1",
              "reads": {
                "scopeClarify": "clarify",
                "scopeDecisions": "decisions",
                "scopePlan": "plan",
                "scopeSource": "@source",
                "scopeTicket": "@ticket"
              },
              "output": {
                "format": "clarify-v1"
              },
              "rules": [],
              "checks": [
                "architecture-revision",
                {
                  "check": "scope-inputs",
                  "sources": {
                    "clarify": "scopeClarify",
                    "decisions": "scopeDecisions",
                    "plan": "scopePlan",
                    "existing-work": "scopeExistingWork",
                    "assess-existing": "scopeAssessment",
                    "source": "scopeSource",
                    "ticket": "scopeTicket"
                  }
                }
              ],
              "access": {
                "mode": "workspace"
              },
              "instructions": [
                "delivery",
                "delivery-clarify"
              ],
              "name": "Clarify requirements",
              "branches": [],
              "maxVisits": 16,
              "type": "agent",
              "prompt": "Read the input, all comments, metadata, assets and previous answers. Determine whether you fully understand the requirements. Ask only questions that materially affect implementation. If the input says backlog only, planning only, or do not implement yet, and no later user instruction explicitly authorizes implementation, ask whether to proceed with implementation now or retain that restriction before returning empty questions. Do not infer authorization from answers about feature scope. Do not assume answers or implement anything. Return {\"questions\":[\"...\"],\"questionRecommendations\":[{\"questionIndex\":0,\"answer\":\"recommended answer\",\"reason\":\"evidence-based explanation\"}],\"decisions\":[{\"question\":\"...\",\"answer\":\"...\",\"reason\":\"...\"}],\"requirements\":[\"...\"]}. For selectable alternatives, use questionChoices with questionIndex, selection (single or multiple), options (unique id, answer, optional reason) and optional preselectedOptionIds. Do not use questionRecommendations for the same question. Custom text is always available and defaults require explicit submission. Empty questions means everything is understood. Preserve all answered decisions across rounds.{{instruction:delivery}}{{instruction:delivery-clarify}}",
              "json": true,
              "askQuestions": true
            },
            {
              "id": "decisions",
              "configVersion": "step-config-v1",
              "reads": {
                "draftPr": "draft-pr",
                "ci": "ci",
                "guide": "guide",
                "reviewGate": "review-gate",
                "handoff": "handoff",
                "merge": "merge",
                "qaReview": "visual-review",
                "capture": "capture",
                "scope": "visual-scope",
                "qaGate": "visual-gate",
                "clarify": "clarify",
                "plan": "plan",
                "implementation": "implement",
                "scopeClarify": "clarify",
                "scopeDecisions": "decisions",
                "scopePlan": "plan",
                "scopeSource": "@source",
                "scopeTicket": "@ticket"
              },
              "rules": [],
              "checks": [
                {
                  "check": "scope-inputs",
                  "sources": {
                    "clarify": "scopeClarify",
                    "decisions": "scopeDecisions",
                    "plan": "scopePlan",
                    "existing-work": "scopeExistingWork",
                    "assess-existing": "scopeAssessment",
                    "source": "scopeSource",
                    "ticket": "scopeTicket"
                  }
                }
              ],
              "access": {
                "mode": "workspace"
              },
              "instructions": [],
              "name": "Record decisions",
              "branches": [],
              "maxVisits": 200,
              "type": "tool",
              "tool": "record-decisions",
              "args": []
            },
            {
              "id": "plan",
              "configVersion": "step-config-v1",
              "reads": {
                "scopeClarify": "clarify",
                "scopeDecisions": "decisions",
                "scopePlan": "plan",
                "scopeSource": "@source",
                "scopeTicket": "@ticket"
              },
              "output": {
                "format": "plan-v1"
              },
              "rules": [],
              "checks": [
                "architecture-revision",
                {
                  "check": "ticket-milestone",
                  "kind": "plan"
                },
                "delivery-contract",
                {
                  "check": "scope-inputs",
                  "sources": {
                    "clarify": "scopeClarify",
                    "decisions": "scopeDecisions",
                    "plan": "scopePlan",
                    "existing-work": "scopeExistingWork",
                    "assess-existing": "scopeAssessment",
                    "source": "scopeSource",
                    "ticket": "scopeTicket"
                  }
                }
              ],
              "access": {
                "mode": "workspace"
              },
              "instructions": [
                "delivery-plan",
                "implementation-scope",
                "delivery",
                "ticket-plan"
              ],
              "name": "Write implementation plan",
              "branches": [],
              "maxVisits": 16,
              "type": "agent",
              "prompt": "Write a lean, complete implementation plan from the original input, ALL comments/metadata, clarified requirements/decision records, and any plan-review feedback. When taking over, include the existing-work and assess-existing results and PR review discussion; preserve completed work and plan only the remaining changes. Include the existing PR URL/branch and require continuing it. Return {\"plan\":\"detailed self-contained Markdown implementation plan with acceptance criteria and validation\",\"assets\":[{\"path\":\"absolute downloaded asset path or URL\",\"purpose\":\"...\"}]}. Include everything the implementer needs: it will receive ONLY this result, never the ticket. Include repository scope, base branch and delivery expectations. {{instruction:implementation-scope}} Do not implement.{{instruction:ticket-plan}}{{instruction:delivery}}{{instruction:delivery-plan}}",
              "json": true,
              "askQuestions": false
            },
            {
              "id": "plan-review",
              "configVersion": "step-config-v1",
              "reads": {
                "scopeClarify": "clarify",
                "scopeDecisions": "decisions",
                "scopePlan": "plan",
                "scopeSource": "@source",
                "scopeTicket": "@ticket"
              },
              "output": {
                "format": "plan-review-v1"
              },
              "rules": [],
              "checks": [
                "architecture-revision",
                {
                  "check": "scope-inputs",
                  "sources": {
                    "clarify": "scopeClarify",
                    "decisions": "scopeDecisions",
                    "plan": "scopePlan",
                    "existing-work": "scopeExistingWork",
                    "assess-existing": "scopeAssessment",
                    "source": "scopeSource",
                    "ticket": "scopeTicket"
                  }
                }
              ],
              "access": {
                "mode": "workspace"
              },
              "instructions": [
                "implementation-scope",
                "delivery",
                "delivery-plan-review"
              ],
              "name": "Review implementation plan",
              "next": "delivery-route-accept",
              "branches": [
                {
                  "when": {
                    "path": "approved",
                    "equals": false
                  },
                  "next": "plan"
                }
              ],
              "maxVisits": 16,
              "type": "agent",
              "prompt": "Review the plan against ALL input/comments/metadata and decisions. {{instruction:implementation-scope}} Reject invented approval gates for routine dependency edits within the accepted requirements and architecture. Do not implement. Return {\"approved\":true,\"feedback\":[]} or {\"approved\":false,\"feedback\":[\"specific missing requirements or improvements\"]}. Approve a practical MVP plan when complete.{{instruction:delivery}}{{instruction:delivery-plan-review}}",
              "json": true,
              "askQuestions": false
            },
            {
              "id": "architecture",
              "configVersion": "step-config-v1",
              "reads": {
                "scopeClarify": "clarify",
                "scopeDecisions": "decisions",
                "scopePlan": "plan",
                "scopeSource": "@source",
                "scopeTicket": "@ticket"
              },
              "output": {
                "format": "architecture-checkin-v1"
              },
              "rules": [],
              "checks": [
                "architecture-revision",
                "architecture-proposal",
                {
                  "check": "scope-inputs",
                  "sources": {
                    "clarify": "scopeClarify",
                    "decisions": "scopeDecisions",
                    "plan": "scopePlan",
                    "existing-work": "scopeExistingWork",
                    "assess-existing": "scopeAssessment",
                    "source": "scopeSource",
                    "ticket": "scopeTicket"
                  }
                }
              ],
              "access": {
                "mode": "workspace"
              },
              "instructions": [
                "implementation-scope",
                "architecture-continuation"
              ],
              "name": "Prepare the check-in",
              "branches": [],
              "maxVisits": 16,
              "type": "agent",
              "prompt": "Before Bob builds anything, he checks his plan with the human, the way a good colleague walks over and says \"got two minutes before I start?\". Your output is that check-in, plus the complete plan and evidence the automated reviewer verifies.\n\nInspect the selected repositories, actual module boundaries and conventions, all requirements, comments, answers and decisions, the draft plan and prior candidate-review feedback. Preserve Takeover's completed work, PR URL and branch. Propose the smallest adequate design; do not implement or invent human acceptance. Routine unsplit changes using established patterns may bypass approval with a concrete rationale; meaningful responsibilities, boundaries, interfaces or trade-offs require human acceptance.\n\n{{instruction:implementation-scope}}\n\n{{instruction:architecture-continuation}}\n\nWHY THE HUMAN IS ASKED\nAn independent reviewer already checks that every requirement is traced, files are real and the plan is consistent. The human is asked only for what a human can catch while it is still cheap to change course: you misunderstood what they want; a call you made does not fit their product, customers or team; the consequences for people are unacceptable; or the work is the wrong size. Write the check-in for exactly that.\n\nTHE CHECK-IN (talk) - spoken, first person, everyday words, about two minutes to read in total (at most 350 words across all talk fields). No file paths, class names, endpoints or jargon a product owner would not use; say what people experience. Concrete numbers where they matter (\"every 30 seconds\", \"up to 128 waiting devices\").\n- understood (max 360): \"You want ... so that ...\", then what done looks like to them. This is the first thing the human confirms, so restate their goal in their terms, not your solution.\n- plan (max 480): \"I'd ...\" in two to four sentences: the approach, not the task list.\n- scenes: 1-3 whiteboard sketches of what a person or device experiences, before and after, as short steps (max 90 characters each; before 1-5 steps, after 1-6). Pick the moments the change is really about, e.g. title \"A new reader joins\": before [\"Reader connects\", \"It is registered automatically\"], after [\"Reader shows a code that changes every 30 seconds\", \"An administrator types or scans the code\", \"Only then is the reader registered\"].\n- notice: up to 5 groups of people, devices, integrations or operators that will notice once this ships, and how (who max 40, what max 200). Include upgrades, configuration they must set and anything that stops working. [] only when nobody outside the code notices.\n- checks: up to 3 calls you made that need human judgment (product, customers, cost, habits), the least certain first. say (max 260): \"I went with ... because ...\"; instead (max 220): the other way and what it would mean for people. Link decision when the call is one of decisions. Do not list calls the repository or the human's answers already settle; those stay in decisions. Open decisions are questions, never checks.\n- size (max 240): how big this is in human terms: how many separate things change, which parts of the product, rough effort. split (max 240, optional): a sensible way to split it into smaller deliveries if one exists, and what each would deliver first.\n\nWHAT THE REVIEWER CHECKS (Bob's notes; the human opens these only to dig)\n- title (max 80): what will be true afterwards. summary (max 320): current gap, proposed change, scope boundary.\n- problem: 1-3 findings about how things behave today, tied to inspected files. No invented defects.\n- decisions: every real choice with 2-4 concrete options. Decide it yourself (decidedBy=bob) when repository evidence or requirements settle it; mark it open only for human-dependent habits, scope or cost, give why, and set lean to the option you would take. Open decisions block approval; never hide a real choice or leave open one the repository settles.\n- criteria: EVERY original acceptance criterion, including independent/external/hardware checks this PR cannot complete; preserve meaning and source. Without explicit criteria, derive clearly sourced requirements. Coverage is what this plan will deliver, not completed evidence; partial means useful preparation with an explicit remaining part; deferred has no deliverable. The human sees partial and deferred items as \"what this will not fully prove\", so make their reason plain.\n- nonGoals: specific exclusions. acceptance: 3-6 measurable checks; never claim future physical tests or independent review have passed. risks: up to 6 concrete product/technical consequences with what limits each; workflow or ticket status is not a risk. Do not defer mandatory baseline security if the request makes it a prerequisite.\n- map: the system view for engineers: 1-4 areas, at most 10 parts (label max 24, note max 32), links with 1-2 word labels. unchanged parts give context only and cannot also be listed for file changes. Add option previews when an alternative changes the map.\n- evidence: why this design fits the existing architecture, tied to inspected paths.\n- candidate: the COMPLETE self-contained implementation plan; the implementer receives only the accepted plan and assets. Each step: what gets built and observable behavior, kind, relative size, traces ({\"criterion\":\"AC1\"} for requested work or {\"added\":\"concrete necessity and why it was not requested\"} for Bob-added work; never hide extras behind unrelated criteria) and every anticipated file change with exact repo-relative path and new/edit/delete, including tests, docs, configuration and known conditional edits with their triggers. Inspect callers and test wiring before estimating. Do not invent files or add UI/screenshots for a backend-only task without an explicit reason. Name the number and subject of documents. For limits chosen through measurement, state the selection rule and starting constraints; never invent measured values.\n\nNEW VERSIONS\nList every change to the plan since the previous version in changes (max 200 each; from=you when the human asked for it, bob when you added it) and set decidedBy=you for human-settled decisions. The human reads changes first on a new version, so say plainly what you did with each of their notes. Describe what changed in the plan, never approval or authorization status, reviewer process or what was not changed; the runtime tracks those. Read architectureProposals and architectureDecisions for feedback; explanation requests are not authorization.\n\nLIMITS\nproblem observations and nonGoals 320; criterion text 1200; criterion reason, deliverable what and acceptance checks 480; added-work reason 320; deliverable title and decision question 120; IDs and option name 60; option upside/catch 160; decision why, map detail and risks 240; evidence at most 6.\n\nReturn ONLY architecture-v1 with briefVersion=2:\n{\"architectureContract\":\"architecture-v1\",\"briefVersion\":2,\"classification\":\"meaningful or routine\",\"rationale\":\"concrete classification reason\",\"title\":\"...\",\"summary\":\"...\",\"talk\":{\"understood\":\"You want ...\",\"plan\":\"I'd ...\",\"scenes\":[{\"title\":\"...\",\"before\":[\"...\"],\"after\":[\"...\"]}],\"notice\":[{\"who\":\"...\",\"what\":\"...\"}],\"checks\":[{\"decision\":\"optional decision id\",\"say\":\"I went with ...\",\"instead\":\"...\"}],\"size\":\"...\",\"split\":\"optional\"},\"problem\":[{\"repository\":\"selected repo\",\"paths\":[\"inspected existing file\"],\"observation\":\"...\"}],\"decisions\":[{\"id\":\"storage\",\"question\":\"plain question\",\"why\":\"required when open\",\"status\":\"decided or open\",\"pick\":\"option id, only when decided\",\"decidedBy\":\"bob or you, only when decided\",\"lean\":\"option id, only when open\",\"options\":[{\"id\":\"a\",\"name\":\"concrete option\",\"upside\":\"...\",\"catch\":\"...\",\"preview\":{\"parts\":[],\"links\":[],\"hide\":[]}}]}],\"criteria\":[{\"id\":\"AC1\",\"text\":\"complete original criterion text\",\"source\":\"ticket identifier and criterion number, or user requirement\",\"url\":\"optional actual source HTTP URL\",\"status\":\"covered or partial or deferred\",\"reason\":\"...\"}],\"nonGoals\":[\"...\"],\"acceptance\":[\"...\"],\"changes\":[{\"text\":\"...\",\"from\":\"you or bob\"}],\"risks\":[\"...\"],\"map\":{\"areas\":[{\"id\":\"area\",\"name\":\"Area name\"}],\"parts\":[{\"id\":\"part\",\"label\":\"...\",\"note\":\"...\",\"detail\":\"plain sentence\",\"file\":\"optional repo-relative path\",\"area\":\"area\",\"status\":\"new or changed or unchanged or outside\"}],\"links\":[{\"from\":\"part\",\"to\":\"part\",\"label\":\"optional\"}]},\"evidence\":[{\"repository\":\"selected repo\",\"paths\":[\"actual inspected path\"],\"observation\":\"...\"}],\"candidate\":{\"plan\":\"COMPLETE self-contained implementation plan incorporating every accepted requirement/decision, repository/base/delivery targets, inherited Takeover PR/work and validation expectations\",\"steps\":[{\"id\":\"D1\",\"title\":\"...\",\"what\":\"...\",\"kind\":\"code or test or docs or config\",\"size\":\"S or M or L\",\"traces\":[{\"criterion\":\"AC1\"}],\"files\":[{\"path\":\"complete repo-relative file path\",\"change\":\"new or edit or delete\",\"repository\":\"selected repo id; required for grouped repositories\"}]}],\"assets\":[{\"path\":\"absolute path or HTTP URL\",\"purpose\":\"...\"}]}}\n\nMeaningful proposals need a map and at least one decision. Routine outputs may omit map and decisions but still need the check-in and scope fields. Never return footprint/counts or approval fields; the runtime computes footprint from listed files and actual repository boundaries. Independent child delivery is separate future work, not executable scheduling here.",
              "json": true,
              "askQuestions": false
            },
            {
              "id": "architecture-review",
              "configVersion": "step-config-v1",
              "reads": {
                "proposal": "architecture",
                "scopeClarify": "clarify",
                "scopeDecisions": "decisions",
                "scopePlan": "plan",
                "scopeSource": "@source",
                "scopeTicket": "@ticket"
              },
              "output": {
                "format": "architecture-review-v1"
              },
              "rules": [],
              "checks": [
                "architecture-revision",
                "architecture-candidate",
                {
                  "check": "scope-inputs",
                  "sources": {
                    "clarify": "scopeClarify",
                    "decisions": "scopeDecisions",
                    "plan": "scopePlan",
                    "existing-work": "scopeExistingWork",
                    "assess-existing": "scopeAssessment",
                    "source": "scopeSource",
                    "ticket": "scopeTicket"
                  }
                }
              ],
              "access": {
                "mode": "workspace"
              },
              "instructions": [
                "architecture-questions",
                "implementation-scope",
                "architecture-continuation",
                "architecture-questions-brief"
              ],
              "name": "Review the check-in",
              "branches": [
                {
                  "when": {
                    "path": "approved",
                    "equals": false
                  },
                  "next": "architecture"
                }
              ],
              "maxVisits": 16,
              "type": "agent",
              "prompt": "Review the check-in and its complete implementation plan against ALL requirements, comments, answers, decisions and inherited Takeover work. Require briefVersion=2 and a check-in a product owner can read in about two minutes: understood restates the human's goal in their terms; plan states the approach; scenes show what people or devices experience before and after as short observable steps; notice names every group that will notice, including upgrades, required configuration and anything that stops working; checks list only calls that need human judgment with the honest alternative; size and split are truthful. Reject jargon, file paths or class names in the check-in, benefit statements in place of behavior, consequences missing from notice, and calls that only the human can judge hidden in decisions. Also require concrete current-state findings, observable deliverables with anticipated files/operations/size estimates and criterion traces, every original acceptance criterion with honest covered/partial/deferred status and plain reason, justified Bob-added work, explicit non-goals, measurable acceptance checks and open decisions with Bob's lean. {{instruction:implementation-scope}} Reject invented approval gates for routine dependency edits within the accepted requirements and architecture. {{instruction:architecture-continuation}} Only when the COMPLETE candidate remains within that latest human acceptance, with no open decisions or unresolved uncertainty, include continuation:{proposalId:\"exact accepted proposal ID\",version:1,digest:\"exact accepted digest\",reason:\"concrete evidence that cumulative changes preserve the accepted requirements, decisions, boundaries, limits, exclusions and delivery targets\"}. This is an independent continuity assessment, never a new human acceptance. Omit continuation for initial proposals, material changes, explicit reapproval requirements, rejection or uncertainty. Compare the check-in to the full plan: reject hidden deliverables, omitted known conditional work or criteria, vague options, limits whose values or measurement selection rules appear only in the full plan, unsupported coverage claims, unnecessary packages or frontend work, and process status masquerading as technical risk. Inspect runtime footprint warnings, including invalid paths, operation mismatches and unchanged map parts listed for work; require correction or a concrete explanation of intentional cross-area/config changes. Assess repository evidence, decisions and options, map, readability and routine classification. Reject proposals that hide a real choice or leave a decision open that the repository already settles. Do not implement. {{instruction:architecture-questions-brief}} Return {\"approved\":true,\"feedback\":[]} or {\"approved\":false,\"feedback\":[\"concrete required changes\"]}.",
              "json": true,
              "askQuestions": false
            },
            {
              "id": "architecture-decision",
              "configVersion": "step-config-v1",
              "reads": {
                "proposal": "architecture",
                "review": "architecture-review",
                "plan": "plan",
                "revise": "architecture",
                "scopeClarify": "clarify",
                "scopeDecisions": "decisions",
                "scopePlan": "plan",
                "scopeSource": "@source",
                "scopeTicket": "@ticket",
                "draftPr": "draft-pr",
                "ci": "ci",
                "guide": "guide",
                "reviewGate": "review-gate",
                "handoff": "handoff",
                "merge": "merge"
              },
              "rules": [],
              "checks": [
                {
                  "check": "scope-inputs",
                  "sources": {
                    "clarify": "scopeClarify",
                    "decisions": "scopeDecisions",
                    "plan": "scopePlan",
                    "existing-work": "scopeExistingWork",
                    "assess-existing": "scopeAssessment",
                    "source": "scopeSource",
                    "ticket": "scopeTicket"
                  }
                }
              ],
              "access": {
                "mode": "workspace"
              },
              "instructions": [],
              "name": "Check in with you",
              "next": "implement",
              "branches": [
                {
                  "when": {
                    "path": "decision",
                    "equals": "revise"
                  },
                  "next": "architecture"
                }
              ],
              "maxVisits": 200,
              "type": "tool",
              "tool": "architecture-decision",
              "args": [],
              "arguments": {
                "proposal": "architecture",
                "review": "architecture-review",
                "planOutput": "plan",
                "revise": "architecture",
                "approval": "meaningful",
                "continueAccepted": true
              }
            },
            {
              "id": "implement",
              "configVersion": "step-config-v1",
              "reads": {
                "plan": "plan"
              },
              "output": {
                "format": "implement-v1"
              },
              "rules": [
                {
                  "id": "completion",
                  "message": "Blocked implementation requires a question to resolve the blocker; completed implementation must have no questions",
                  "require": {
                    "any": [
                      {
                        "all": [
                          {
                            "path": "/status",
                            "equals": "blocked"
                          },
                          {
                            "any": [
                              {
                                "path": "/questions",
                                "empty": false
                              },
                              {
                                "path": "/architectureRevision",
                                "equals": true
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "all": [
                          {
                            "path": "/status",
                            "notEquals": "blocked"
                          },
                          {
                            "path": "/questions",
                            "empty": true
                          },
                          {
                            "path": "/architectureRevision",
                            "notEquals": true
                          }
                        ]
                      }
                    ]
                  }
                }
              ],
              "checks": [
                "architecture-revision",
                {
                  "check": "ticket-milestone",
                  "kind": "implementation"
                }
              ],
              "access": {
                "mode": "workspace"
              },
              "instructions": [
                "implementation-scope",
                "implementation-architecture-revision"
              ],
              "name": "Implement accepted plan",
              "branches": [],
              "maxVisits": 16,
              "type": "agent",
              "prompt": "Implement the provided plan and use its assets. Read /answers alongside /plan for subsequent human responses, including resolution of implementation blockers. {{instruction:implementation-scope}} Follow repository conventions and appropriate verification. If implementation is forbidden, deferred, or blocked by missing access or a necessary decision, preserve completed work and return {\"status\":\"blocked\",\"summary\":\"concrete blocker\",\"checks\":[\"commands and outcomes\"],\"questions\":[\"specific question or action needed to unblock implementation\"]}. The workflow waits for an answer and resumes this role; do not report deferred or unfinished work as completed. Only after completing implementation return {\"status\":\"completed\",\"summary\":\"...\",\"checks\":[\"commands and outcomes\"],\"questions\":[]}. Do not create or publish a PR; the next step handles delivery.{{instruction:implementation-architecture-revision}}",
              "inputs": [
                "plan"
              ],
              "json": true,
              "askQuestions": true
            },
            {
              "id": "draft-pr",
              "configVersion": "step-config-v1",
              "reads": {
                "draftPr": "draft-pr",
                "ci": "ci",
                "guide": "guide",
                "reviewGate": "review-gate",
                "handoff": "handoff",
                "merge": "merge",
                "qaReview": "visual-review",
                "capture": "capture",
                "scope": "visual-scope",
                "qaGate": "visual-gate",
                "clarify": "clarify",
                "plan": "plan",
                "implementation": "implement",
                "scopeClarify": "clarify",
                "scopeDecisions": "decisions",
                "scopePlan": "plan",
                "scopeSource": "@source",
                "scopeTicket": "@ticket"
              },
              "rules": [],
              "checks": [
                {
                  "check": "scope-inputs",
                  "sources": {
                    "clarify": "scopeClarify",
                    "decisions": "scopeDecisions",
                    "plan": "scopePlan",
                    "existing-work": "scopeExistingWork",
                    "assess-existing": "scopeAssessment",
                    "source": "scopeSource",
                    "ticket": "scopeTicket"
                  }
                }
              ],
              "access": {
                "mode": "workspace"
              },
              "instructions": [],
              "name": "Push and create draft PR",
              "branches": [],
              "maxVisits": 200,
              "type": "tool",
              "tool": "draft-pr",
              "args": []
            },
            {
              "id": "assess-impact",
              "configVersion": "step-config-v1",
              "reads": {
                "inventory": "extract-requirements",
                "fanout": "specialist-review",
                "ci": "ci",
                "feedback": "@feedback",
                "scopeClarify": "clarify",
                "scopeDecisions": "decisions",
                "scopePlan": "plan",
                "scopeSource": "@source",
                "scopeTicket": "@ticket"
              },
              "output": {
                "format": "impact-v1"
              },
              "rules": [],
              "checks": [
                "architecture-revision",
                {
                  "check": "impact-reuse",
                  "maxUnchangedCycles": 3
                },
                {
                  "check": "scope-inputs",
                  "sources": {
                    "clarify": "scopeClarify",
                    "decisions": "scopeDecisions",
                    "plan": "scopePlan",
                    "existing-work": "scopeExistingWork",
                    "assess-existing": "scopeAssessment",
                    "source": "scopeSource",
                    "ticket": "scopeTicket"
                  }
                }
              ],
              "access": {
                "mode": "workspace"
              },
              "instructions": [],
              "name": "Assess changed work and retained evidence",
              "next": "impact-checks",
              "branches": [
                {
                  "when": {
                    "path": "correctionRequired",
                    "equals": true
                  },
                  "next": "ci-fix"
                },
                {
                  "when": {
                    "path": "readinessOnly",
                    "equals": true
                  },
                  "next": "ci"
                },
                {
                  "when": {
                    "path": "extractRequirements",
                    "equals": true
                  },
                  "next": "extract-requirements"
                }
              ],
              "maxVisits": 200,
              "type": "agent",
              "prompt": "Independently assess /impactSnapshot, actual repository diffs (including cumulative changes since prior explicit approval), prior original receipts and unresolved findings. Fixer summaries never authorize reuse. Discover commands and conventions in ALL selected repositories; never infer safety from filenames, line count or unchanged head alone. Inspect whether test changes weaken assertions or coverage. Assess combined merge trees and target-only changes separately from task regressions. Unknown dependencies, conflicts, migrations, security boundaries, changed scope or unavailable evidence require broader inspection and relevant validation. Select only configured reviewer IDs from the snapshot. First review executes all roles. Reuse only completed resolved receipts with runtime dependency provenance; supply their exact receipt digest, boundary and a concrete independence reason. Unaffected areas retain original evidence, never claim a new review executed. Track future QA/guide/human/provider obligations at their own gates. Optional cleanup remains visible and nonblocking. Prior explicit approval can continue for an evidenced safe minor correction, including production code, only after all required evidence passes; uncertain or meaningful changes and human rejection require renewed approval. Assess the cumulative delta. Return impact-v1 with status, summary, correctionRequired:boolean, readinessOnly:boolean, commentAssessments:[{id,repositoryId (required for grouped deliveries unless id is repositoryId:commentId),bodySha256,disposition:\"informational|consequential|accepted-unchanged\",reason}], classification:\"none|affected|full\", rationale, uncertainty:[], extractRequirements:boolean, scopeReuse:{inventoryDigest,originalSourceDigest,reason} only when independently inspecting new feedback proves accepted requirements unchanged, specialists:[configured IDs], requirementIds:[], checks:[{id,repositoryId,command,reason,environment:{isolation:\"worktree\"} or {isolation:\"shared\",resources:[stable identities]}}], qaCriteria:[criterion IDs], qaReuse:[{criterionId,originalDigest,reason}], reuse:[{reviewer,receiptDigest,reason,boundary:{requirementIds,areas,dependencies,independence}}], invalidate:[{receiptDigest,reason}], targetCompatible:boolean, testAssertions:{inspected,weakened,evidence}, humanReview:\"no-prior-approval|continue-after-checks|renew\", approvalRationale and questions:[]. Missing inputs require blocked and a specific question. commentAssessments may identify ONLY supplied PR feedback from /feedback/readiness/unassessedComments, using its exact IDs and bodySha256 values. Originating ticket comments, assignment notices and chat messages are task inputs, never PR comment assessments. Return commentAssessments:[] when no PR feedback is supplied. Do not mutate files or run corrective agents. Every original configured role needs fresh execution or explicit valid reuse. Missing legacy provenance requires fresh review.",
              "json": true,
              "askQuestions": true
            },
            {
              "id": "extract-requirements",
              "configVersion": "step-config-v1",
              "reads": {
                "scopeClarify": "clarify",
                "scopeDecisions": "decisions",
                "scopePlan": "plan",
                "scopeSource": "@source",
                "scopeTicket": "@ticket"
              },
              "output": {
                "format": "inventory-v1"
              },
              "rules": [],
              "checks": [
                "architecture-revision",
                "inventory-evidence",
                {
                  "check": "scope-inputs",
                  "sources": {
                    "clarify": "scopeClarify",
                    "decisions": "scopeDecisions",
                    "plan": "scopePlan",
                    "existing-work": "scopeExistingWork",
                    "assess-existing": "scopeAssessment",
                    "source": "scopeSource",
                    "ticket": "scopeTicket"
                  }
                }
              ],
              "revision": "bound",
              "access": {
                "mode": "workspace"
              },
              "instructions": [
                "review-stage-inventory",
                "impact-inventory"
              ],
              "name": "Extract requirements",
              "next": "impact-checks",
              "branches": [],
              "maxVisits": 16,
              "type": "agent",
              "prompt": "Extract scope independently of the implementation. Read complete originalInput (parse embedded JSON), ticket/acceptance criteria, ALL paginated comments, attachments/assets, clarification answers and accepted decisions/plan, later chat/human steering, takeover/PR discussions and past review rounds/dispositions through factory-context. Use /contextMemory/reviewLedger and /contextMemory/reviewRounds for historical claims and reasoning, following original outputPath records when scope or disagreement evidence is needed. Follow nextOffset to null. Missing source access requires a concrete questions entry; never omit unavailable scope. Read previous inventories, retain every historical ID and decision, and record amendments/supersessions with changeReason. Suggestions are not accepted scope. Contradictions stay in conflicts and questions until explicitly resolved outside fanout. Scope decisions require explicit human acceptance, rationale and source, not a reviewer preference. Follow the runtime decision-attribution rule: use a recorded name when available, otherwise identify the Factory operator with the name not recorded; do not ask for a name merely to complete attribution. Use kind:\"skip\" only for an explicit scope waiver, and list the precise requirementIds it authorizes skipping; other accepted scope decisions use kind:\"scope\". List considered sources and unavailable sources in sourceReceipt. Semantic extraction completeness needs source inspection; structural validation alone cannot prove it.\nReturn {\"schemaVersion\":1,\"requirements\":[{\"id\":\"R1\",\"criterion\":\"testable accepted outcome\",\"classification\":\"active or suggestion or superseded\",\"sources\":[{\"source\":\"originalInput or context record or source URL\",\"reference\":\"JSON Pointer/comment/attachment identifier\"}],\"changeReason\":\"required for an amendment\",\"supersedes\":[]}],\"decisions\":[{\"id\":\"D1\",\"acceptedBy\":\"recorded person or Factory operator (name not recorded)\",\"kind\":\"scope or skip\",\"requirementIds\":[\"R1\"],\"rationale\":\"accepted scope rationale\",\"source\":{\"source\":\"source\",\"reference\":\"record identifier\"}}],\"conflicts\":[{\"id\":\"C1\",\"description\":\"unresolved scope question\",\"sources\":[{\"source\":\"source\",\"reference\":\"record\"}]}],\"sourceReceipt\":{\"considered\":[{\"source\":\"source\",\"reference\":\"record\"}],\"unavailable\":[]},\"questions\":[]}. Runtime owns inventory version/digest. Do not change product files.{{instruction:impact-inventory}}",
              "json": true,
              "askQuestions": true
            },
            {
              "id": "impact-checks",
              "configVersion": "step-config-v1",
              "reads": {
                "impact": "assess-impact",
                "scopeClarify": "clarify",
                "scopeDecisions": "decisions",
                "scopePlan": "plan",
                "scopeSource": "@source",
                "scopeTicket": "@ticket",
                "draftPr": "draft-pr",
                "ci": "ci",
                "guide": "guide",
                "reviewGate": "review-gate",
                "handoff": "handoff",
                "merge": "merge"
              },
              "rules": [],
              "checks": [
                "impact-boundary",
                {
                  "check": "scope-inputs",
                  "sources": {
                    "clarify": "scopeClarify",
                    "decisions": "scopeDecisions",
                    "plan": "scopePlan",
                    "existing-work": "scopeExistingWork",
                    "assess-existing": "scopeAssessment",
                    "source": "scopeSource",
                    "ticket": "scopeTicket"
                  }
                }
              ],
              "access": {
                "mode": "workspace"
              },
              "instructions": [],
              "name": "Run independently selected checks",
              "next": "specialist-review",
