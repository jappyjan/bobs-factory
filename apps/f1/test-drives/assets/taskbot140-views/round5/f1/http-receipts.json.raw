                      ]
                    }
                  },
                  "revisionAssistance": {
                    "aggregate": "filter",
                    "path": "/inputs/observations",
                    "where": {
                      "all": [
                        {
                          "path": "/dirty",
                          "equals": false
                        },
                        {
                          "not": {
                            "path": "/readiness/headSha",
                            "equalsPath": "/headSha"
                          }
                        },
                        {
                          "path": "/previous/worktreeHeadSha",
                          "equalsPath": "/headSha"
                        },
                        {
                          "path": "/previous/headSha",
                          "equalsPath": "/readiness/headSha"
                        },
                        {
                          "path": "/previous/baseSha",
                          "equalsPath": "/readiness/baseSha"
                        }
                      ]
                    }
                  },
                  "failureAssistance": {
                    "aggregate": "filter",
                    "path": "/inputs/observations",
                    "where": {
                      "all": [
                        {
                          "not": {
                            "any": [
                              {
                                "any": [
                                  {
                                    "some": "/feedback",
                                    "require": {
                                      "all": [
                                        {
                                          "path": "/kind",
                                          "in": [
                                            "threads",
                                            "reviews",
                                            "revision"
                                          ]
                                        },
                                        {
                                          "any": [
                                            {
                                              "not": {
                                                "path": "/action",
                                                "exists": true
                                              }
                                            },
                                            {
                                              "path": "/action",
                                              "equals": "fix"
                                            }
                                          ]
                                        },
                                        {
                                          "any": [
