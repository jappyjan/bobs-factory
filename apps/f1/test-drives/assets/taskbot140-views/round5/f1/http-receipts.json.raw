        {
          "id": "f1-views-child",
          "stepConfigVersion": "step-config-v1",
          "name": "Ordinary child with a human view",
          "description": "",
          "labels": [],
          "steps": [
            {
              "id": "child-accept",
              "configVersion": "step-config-v1",
              "name": "Child acceptance",
              "next": "child-summary",
              "branches": [],
              "maxVisits": 16,
              "type": "approve",
              "view": {
                "version": "view-v1",
                "components": [
                  {
                    "id": "message",
                    "type": "markdown",
                    "data": {
                      "literal": {
                        "text": "Approve this isolated child fixture. No publication or merge is requested."
                      }
                    }
                  }
                ]
              }
            },
            {
              "id": "child-summary",
              "configVersion": "step-config-v1",
              "name": "Child summary",
              "next": "end",
              "branches": [],
              "maxVisits": 16,
              "type": "show",
              "view": {
                "version": "view-v1",
                "components": [
                  {
                    "id": "message",
                    "type": "markdown",
                    "data": {
                      "literal": {
                        "text": "The isolated child completed its recipe."
                      }
                    }
                  }
                ]
              }
            }
          ],
          "allowedTriggers": [
            "workflow"
          ]
        },
        {
          "id": "f1-views-main",
          "stepConfigVersion": "step-config-v1",
          "name": "Custom declarative human recipe",
          "description": "",
          "labels": [],
          "steps": [
            {
              "id": "collect",
              "configVersion": "step-config-v1",
              "name": "Call reusable source",
              "next": "inspect-each",
              "branches": [],
              "maxVisits": 16,
              "type": "workflow",
              "workflow": "f1-views-source",
              "inputMapping": {}
            },
            {
              "id": "inspect-each",
              "configVersion": "step-config-v1",
              "name": "Inspect every accepted item",
              "next": "choose",
              "branches": [],
              "maxVisits": 16,
              "type": "foreach",
              "items": {
                "from": "/collect/outputs/research/items"
              },
              "itemId": "/id",
              "concurrency": 2,
              "maxItems": 10,
              "failure": "all-must-succeed",
              "body": [
                {
                  "id": "detail",
                  "configVersion": "step-config-v1",
                  "reads": {
                    "item": "@item"
                  },
                  "output": {
                    "format": "json-v1"
                  },
                  "name": "detail",
                  "next": "item-display",
                  "branches": [],
                  "maxVisits": 16,
                  "type": "agent",
                  "prompt": "Return the deterministic detail fixture.",
                  "json": true,
                  "askQuestions": false
                },
                {
                  "id": "item-display",
                  "configVersion": "step-config-v1",
                  "name": "Per-item nonblocking display",
                  "next": "end",
                  "branches": [],
                  "maxVisits": 16,
                  "type": "show",
                  "view": {
                    "version": "view-v1",
                    "components": [
                      {
                        "id": "message",
                        "type": "markdown",
                        "data": {
                          "literal": {
                            "text": "This per-item Show does not stop For each progression."
                          }
                        }
                      }
                    ]
                  }
                }
              ]
            },
            {
              "id": "choose",
              "configVersion": "step-config-v1",
              "reads": {
                "catalog": "collect/outputs/research",
                "story": "collect/outputs/story",
                "inspected": "inspect-each"
              },
              "name": "Choose actions for each item",
              "next": "no-follow-path",
              "branches": [
                {
                  "when": {
                    "path": "hasFollowUps",
                    "equals": true
                  },
                  "next": "follow-path"
                }
              ],
              "maxVisits": 16,
              "type": "decide",
              "view": {
                "from": "/inputs/story"
              },
              "decide": {
                "items": {
                  "path": "/inputs/catalog/items"
                },
                "itemId": "/id",
                "title": "/title",
                "body": "/body",
                "details": [
                  {
                    "label": "Impact",
                    "path": "/impact"
                  }
                ],
                "actions": [
                  {
                    "id": "fix",
                    "label": "Fix",
                    "comment": true
                  },
                  {
                    "id": "skip",
                    "label": "Skip",
                    "comment": true
                  },
                  {
                    "id": "discuss",
                    "label": "Follow up",
                    "comment": true,
                    "followUp": true
                  }
                ],
                "ask": {
                  "prompt": "Answer only the supplied item question from its accepted data. Do not rerun research or change files."
                }
              }
            },
            {
              "id": "follow-path",
              "configVersion": "step-config-v1",
              "reads": {
                "answer": "choose"
              },
              "name": "Configured follow-up route",
              "next": "dispatch",
              "branches": [],
              "maxVisits": 16,
              "type": "check",
              "check": {
                "results": {
                  "followed": {
                    "path": "/inputs/answer/hasFollowUps",
                    "equals": true
                  },
                  "selected": {
                    "select": "/inputs/answer/itemsByAction/fix"
                  }
                }
              }
            },
            {
              "id": "no-follow-path",
              "configVersion": "step-config-v1",
              "name": "Configured no-follow-up route",
              "next": "dispatch",
