            {
              "id": "specialist-review",
              "configVersion": "step-config-v1",
              "reads": {
                "inventory": "extract-requirements",
                "impact": "assess-impact",
                "scopeClarify": "clarify",
                "scopeDecisions": "decisions",
                "scopePlan": "plan",
                "scopeSource": "@source",
                "scopeTicket": "@ticket"
              },
              "rules": [],
              "checks": [
                "review-boundary",
                "impact-boundary",
                {
                  "check": "scope-inputs",
                  "sources": {
                    "clarify": "scopeClarify",
                    "decisions": "scopeDecisions",
                    "plan": "scopePlan",
                    "existing-work": "scopeExistingWork",
                    "assess-existing": "scopeAssessment",
                    "source": "scopeSource",
                    "ticket": "scopeTicket"
                  }
                }
              ],
              "access": {
                "mode": "workspace"
              },
              "instructions": [],
              "name": "Parallel specialist review",
              "branches": [],
              "maxVisits": 16,
              "type": "fanout",
              "groups": [
                [
                  {
                    "id": "security-review",
                    "configVersion": "step-config-v1",
                    "reads": {
                      "scopeSource": "@source",
                      "scopeTicket": "@ticket"
                    },
                    "output": {
                      "format": "specialist-v1"
                    },
                    "rules": [],
                    "checks": [
                      "specialist-evidence",
                      {
                        "check": "scope-inputs",
                        "sources": {
                          "clarify": "scopeClarify",
                          "decisions": "scopeDecisions",
                          "plan": "scopePlan",
                          "existing-work": "scopeExistingWork",
                          "assess-existing": "scopeAssessment",
                          "source": "scopeSource",
                          "ticket": "scopeTicket"
                        }
                      }
                    ],
                    "revision": "bound",
                    "access": {
                      "mode": "workspace"
                    },
                    "instructions": [
                      "review-stage-specialist",
                      "review-completion"
                    ],
                    "name": "Security and data protection",
                    "branches": [],
                    "maxVisits": 16,
                    "type": "agent",
                    "prompt": "Own authorization, trust boundaries, secrets, untrusted input and consequential data exposure. Avoid general style or business scope review.\nRead /reviewBaseline first. Review ONLY the frozen clean head/base and requirement inventory in that baseline. All reviewers receive the same immutable context and history cutoff. Read /contextMemory/reviewLedger and /contextMemory/reviewRounds when present; these preserve previous findings, fixer dispositions and review reasoning. Use original outputPath records for relevant disagreement or evidence details, rather than rereading every old review output. Without compact memory, read complete previous review rounds and fixer dispositions. Preserve stable local finding IDs. Reassess every prior open rating 2/3 finding. Settled findings may reopen only with freshEvidence describing new evidence or changed requirements. Resolved or accepted-rejection needs concrete evidence and reason. A fixer saying fixed is not proof. Preserve contradictory recommendations in disagreements until evidence resolves them. Removing a prior disagreement requires disputeResolutions:[{disagreement,reason,evidence}]. To reassess an inherited finding from a removed reviewer, use inheritedDispositions:[{id:\"reviewer:local-id\",status:\"resolved or accepted-rejection\",reason,evidence}]. Unmentioned inherited complaints remain open. Do not change product files, commit, publish, run hidden harness subagents or ask a question inside fanout. Report missing evidence instead of inventing a pass. Ratings: 1 nonblocking observation, 2 consequential should-fix, 3 must-fix.\nReturn {\"summary\":\"concrete result\",\"findings\":[{\"id\":\"stable-local-id\",\"rating\":2,\"summary\":\"concrete failure\",\"evidence\":\"file:line or actual check receipt\",\"status\":\"open or resolved or accepted-rejection\",\"requirementIds\":[\"stable inventory ID\"],\"reason\":\"required for settled dispositions\",\"freshEvidence\":\"required for reopening settled findings\"}],\"disagreements\":[\"unresolved conflicting recommendation and evidence\"]}. Runtime owns reviewer/revision/round stamps. Do not claim later QA executed; distinguish current code/local checks from future QA.",
                    "json": true,
                    "askQuestions": false
                  }
                ],
                [
                  {
                    "id": "architecture-review",
                    "configVersion": "step-config-v1",
                    "reads": {
                      "scopeSource": "@source",
                      "scopeTicket": "@ticket"
                    },
                    "output": {
                      "format": "specialist-v1"
                    },
                    "rules": [],
                    "checks": [
                      "specialist-evidence",
                      {
                        "check": "scope-inputs",
                        "sources": {
                          "clarify": "scopeClarify",
                          "decisions": "scopeDecisions",
                          "plan": "scopePlan",
                          "existing-work": "scopeExistingWork",
                          "assess-existing": "scopeAssessment",
                          "source": "scopeSource",
                          "ticket": "scopeTicket"
                        }
                      }
                    ],
                    "revision": "bound",
                    "access": {
                      "mode": "workspace"
                    },
                    "instructions": [
                      "review-stage-specialist",
                      "review-completion"
                    ],
                    "name": "Architecture and module boundaries",
                    "branches": [],
                    "maxVisits": 16,
                    "type": "agent",
                    "prompt": "Own responsibilities, dependency direction, domain/API seams and interface compatibility. Avoid speculative redesign and local style.\nRead /reviewBaseline first. Review ONLY the frozen clean head/base and requirement inventory in that baseline. All reviewers receive the same immutable context and history cutoff. Read /contextMemory/reviewLedger and /contextMemory/reviewRounds when present; these preserve previous findings, fixer dispositions and review reasoning. Use original outputPath records for relevant disagreement or evidence details, rather than rereading every old review output. Without compact memory, read complete previous review rounds and fixer dispositions. Preserve stable local finding IDs. Reassess every prior open rating 2/3 finding. Settled findings may reopen only with freshEvidence describing new evidence or changed requirements. Resolved or accepted-rejection needs concrete evidence and reason. A fixer saying fixed is not proof. Preserve contradictory recommendations in disagreements until evidence resolves them. Removing a prior disagreement requires disputeResolutions:[{disagreement,reason,evidence}]. To reassess an inherited finding from a removed reviewer, use inheritedDispositions:[{id:\"reviewer:local-id\",status:\"resolved or accepted-rejection\",reason,evidence}]. Unmentioned inherited complaints remain open. Do not change product files, commit, publish, run hidden harness subagents or ask a question inside fanout. Report missing evidence instead of inventing a pass. Ratings: 1 nonblocking observation, 2 consequential should-fix, 3 must-fix.\nReturn {\"summary\":\"concrete result\",\"findings\":[{\"id\":\"stable-local-id\",\"rating\":2,\"summary\":\"concrete failure\",\"evidence\":\"file:line or actual check receipt\",\"status\":\"open or resolved or accepted-rejection\",\"requirementIds\":[\"stable inventory ID\"],\"reason\":\"required for settled dispositions\",\"freshEvidence\":\"required for reopening settled findings\"}],\"disagreements\":[\"unresolved conflicting recommendation and evidence\"]}. Runtime owns reviewer/revision/round stamps. Do not claim later QA executed; distinguish current code/local checks from future QA.",
                    "json": true,
                    "askQuestions": false
                  }
                ],
                [
                  {
                    "id": "integration-review",
                    "configVersion": "step-config-v1",
                    "reads": {
                      "scopeSource": "@source",
                      "scopeTicket": "@ticket"
                    },
                    "output": {
                      "format": "specialist-v1"
                    },
                    "rules": [],
                    "checks": [
                      "specialist-evidence",
                      {
                        "check": "scope-inputs",
                        "sources": {
                          "clarify": "scopeClarify",
                          "decisions": "scopeDecisions",
                          "plan": "scopePlan",
                          "existing-work": "scopeExistingWork",
                          "assess-existing": "scopeAssessment",
                          "source": "scopeSource",
                          "ticket": "scopeTicket"
                        }
                      }
                    ],
                    "revision": "bound",
                    "access": {
                      "mode": "workspace"
                    },
                    "instructions": [
                      "review-stage-specialist",
                      "review-completion"
                    ],
                    "name": "Repository fit and integration",
                    "branches": [],
                    "maxVisits": 16,
                    "type": "agent",
                    "prompt": "Own repository conventions, established reuse, config/migration wiring and surrounding integrations. Identify concrete omitted integration sites.\nRead /reviewBaseline first. Review ONLY the frozen clean head/base and requirement inventory in that baseline. All reviewers receive the same immutable context and history cutoff. Read /contextMemory/reviewLedger and /contextMemory/reviewRounds when present; these preserve previous findings, fixer dispositions and review reasoning. Use original outputPath records for relevant disagreement or evidence details, rather than rereading every old review output. Without compact memory, read complete previous review rounds and fixer dispositions. Preserve stable local finding IDs. Reassess every prior open rating 2/3 finding. Settled findings may reopen only with freshEvidence describing new evidence or changed requirements. Resolved or accepted-rejection needs concrete evidence and reason. A fixer saying fixed is not proof. Preserve contradictory recommendations in disagreements until evidence resolves them. Removing a prior disagreement requires disputeResolutions:[{disagreement,reason,evidence}]. To reassess an inherited finding from a removed reviewer, use inheritedDispositions:[{id:\"reviewer:local-id\",status:\"resolved or accepted-rejection\",reason,evidence}]. Unmentioned inherited complaints remain open. Do not change product files, commit, publish, run hidden harness subagents or ask a question inside fanout. Report missing evidence instead of inventing a pass. Ratings: 1 nonblocking observation, 2 consequential should-fix, 3 must-fix.\nReturn {\"summary\":\"concrete result\",\"findings\":[{\"id\":\"stable-local-id\",\"rating\":2,\"summary\":\"concrete failure\",\"evidence\":\"file:line or actual check receipt\",\"status\":\"open or resolved or accepted-rejection\",\"requirementIds\":[\"stable inventory ID\"],\"reason\":\"required for settled dispositions\",\"freshEvidence\":\"required for reopening settled findings\"}],\"disagreements\":[\"unresolved conflicting recommendation and evidence\"]}. Runtime owns reviewer/revision/round stamps. Do not claim later QA executed; distinguish current code/local checks from future QA.",
                    "json": true,
                    "askQuestions": false
                  }
                ],
                [
                  {
                    "id": "simplicity-review",
                    "configVersion": "step-config-v1",
                    "reads": {
                      "scopeSource": "@source",
                      "scopeTicket": "@ticket"
                    },
                    "output": {
                      "format": "specialist-v1"
                    },
                    "rules": [],
                    "checks": [
                      "specialist-evidence",
                      {
                        "check": "scope-inputs",
                        "sources": {
                          "clarify": "scopeClarify",
                          "decisions": "scopeDecisions",
                          "plan": "scopePlan",
                          "existing-work": "scopeExistingWork",
                          "assess-existing": "scopeAssessment",
                          "source": "scopeSource",
                          "ticket": "scopeTicket"
                        }
                      }
                    ],
                    "revision": "bound",
                    "access": {
                      "mode": "workspace"
                    },
                    "instructions": [
                      "review-stage-specialist",
                      "review-completion"
                    ],
                    "name": "Simplicity and maintainability",
                    "branches": [],
                    "maxVisits": 16,
                    "type": "agent",
                    "prompt": "Own unnecessary abstraction, duplication, speculative extensibility and disproportionate complexity. Explain maintenance cost and a smaller sufficient alternative.\nRead /reviewBaseline first. Review ONLY the frozen clean head/base and requirement inventory in that baseline. All reviewers receive the same immutable context and history cutoff. Read /contextMemory/reviewLedger and /contextMemory/reviewRounds when present; these preserve previous findings, fixer dispositions and review reasoning. Use original outputPath records for relevant disagreement or evidence details, rather than rereading every old review output. Without compact memory, read complete previous review rounds and fixer dispositions. Preserve stable local finding IDs. Reassess every prior open rating 2/3 finding. Settled findings may reopen only with freshEvidence describing new evidence or changed requirements. Resolved or accepted-rejection needs concrete evidence and reason. A fixer saying fixed is not proof. Preserve contradictory recommendations in disagreements until evidence resolves them. Removing a prior disagreement requires disputeResolutions:[{disagreement,reason,evidence}]. To reassess an inherited finding from a removed reviewer, use inheritedDispositions:[{id:\"reviewer:local-id\",status:\"resolved or accepted-rejection\",reason,evidence}]. Unmentioned inherited complaints remain open. Do not change product files, commit, publish, run hidden harness subagents or ask a question inside fanout. Report missing evidence instead of inventing a pass. Ratings: 1 nonblocking observation, 2 consequential should-fix, 3 must-fix.\nReturn {\"summary\":\"concrete result\",\"findings\":[{\"id\":\"stable-local-id\",\"rating\":2,\"summary\":\"concrete failure\",\"evidence\":\"file:line or actual check receipt\",\"status\":\"open or resolved or accepted-rejection\",\"requirementIds\":[\"stable inventory ID\"],\"reason\":\"required for settled dispositions\",\"freshEvidence\":\"required for reopening settled findings\"}],\"disagreements\":[\"unresolved conflicting recommendation and evidence\"]}. Runtime owns reviewer/revision/round stamps. Do not claim later QA executed; distinguish current code/local checks from future QA.",
                    "json": true,
                    "askQuestions": false
                  }
                ],
                [
                  {
                    "id": "correctness-review",
                    "configVersion": "step-config-v1",
                    "reads": {
                      "scopeSource": "@source",
                      "scopeTicket": "@ticket"
                    },
                    "output": {
                      "format": "specialist-v1"
                    },
                    "rules": [],
                    "checks": [
                      "specialist-evidence",
                      {
                        "check": "scope-inputs",
                        "sources": {
                          "clarify": "scopeClarify",
                          "decisions": "scopeDecisions",
                          "plan": "scopePlan",
                          "existing-work": "scopeExistingWork",
                          "assess-existing": "scopeAssessment",
                          "source": "scopeSource",
                          "ticket": "scopeTicket"
                        }
                      }
                    ],
                    "revision": "bound",
                    "access": {
                      "mode": "workspace"
                    },
                    "instructions": [
                      "review-stage-specialist",
                      "review-completion"
                    ],
                    "name": "Correctness and verification",
                    "branches": [],
                    "maxVisits": 16,
                    "type": "agent",
                    "prompt": "Own behavioral failures, boundaries, state/concurrency, error handling and actual verification gaps. Ground complaints in reproduction or code evidence.\nRead /reviewBaseline first. Review ONLY the frozen clean head/base and requirement inventory in that baseline. All reviewers receive the same immutable context and history cutoff. Read /contextMemory/reviewLedger and /contextMemory/reviewRounds when present; these preserve previous findings, fixer dispositions and review reasoning. Use original outputPath records for relevant disagreement or evidence details, rather than rereading every old review output. Without compact memory, read complete previous review rounds and fixer dispositions. Preserve stable local finding IDs. Reassess every prior open rating 2/3 finding. Settled findings may reopen only with freshEvidence describing new evidence or changed requirements. Resolved or accepted-rejection needs concrete evidence and reason. A fixer saying fixed is not proof. Preserve contradictory recommendations in disagreements until evidence resolves them. Removing a prior disagreement requires disputeResolutions:[{disagreement,reason,evidence}]. To reassess an inherited finding from a removed reviewer, use inheritedDispositions:[{id:\"reviewer:local-id\",status:\"resolved or accepted-rejection\",reason,evidence}]. Unmentioned inherited complaints remain open. Do not change product files, commit, publish, run hidden harness subagents or ask a question inside fanout. Report missing evidence instead of inventing a pass. Ratings: 1 nonblocking observation, 2 consequential should-fix, 3 must-fix.\nReturn {\"summary\":\"concrete result\",\"findings\":[{\"id\":\"stable-local-id\",\"rating\":2,\"summary\":\"concrete failure\",\"evidence\":\"file:line or actual check receipt\",\"status\":\"open or resolved or accepted-rejection\",\"requirementIds\":[\"stable inventory ID\"],\"reason\":\"required for settled dispositions\",\"freshEvidence\":\"required for reopening settled findings\"}],\"disagreements\":[\"unresolved conflicting recommendation and evidence\"]}. Runtime owns reviewer/revision/round stamps. Do not claim later QA executed; distinguish current code/local checks from future QA.",
                    "json": true,
                    "askQuestions": false
                  }
                ],
                [
                  {
                    "id": "requirements-review",
                    "configVersion": "step-config-v1",
                    "reads": {
                      "scopeSource": "@source",
                      "scopeTicket": "@ticket"
                    },
                    "output": {
                      "format": "coverage-v1"
                    },
                    "rules": [],
                    "checks": [
                      {
                        "check": "specialist-evidence",
                        "coverage": true
                      },
                      {
                        "check": "scope-inputs",
                        "sources": {
                          "clarify": "scopeClarify",
                          "decisions": "scopeDecisions",
                          "plan": "scopePlan",
                          "existing-work": "scopeExistingWork",
                          "assess-existing": "scopeAssessment",
                          "source": "scopeSource",
                          "ticket": "scopeTicket"
                        }
                      }
                    ],
                    "revision": "bound",
                    "access": {
                      "mode": "workspace"
                    },
                    "instructions": [
                      "review-stage-coverage",
                      "review-completion"
                    ],
                    "name": "Business requirements and acceptance",
                    "branches": [],
                    "maxVisits": 16,
                    "type": "agent",
                    "prompt": "Own complete acceptance coverage. Assess EVERY active requirement exactly once; preserve superseded/suggestion records as context. Return coverage:[{requirementId,status:'met or not_met or deliberately_skipped',evidence:['concrete evidence at frozen revision'],reason:'why',decisionId:'accepted decision for deliberate skip'}] alongside review fields. Missing or inconclusive evidence is not_met, with an actionable open rating 2/3 finding referencing the ID. A skip needs an explicitly accepted decision, recorded person or unnamed Factory operator, rationale and source. Missing personal-name metadata alone cannot block coverage. Do not let reviewer/fixer preference waive scope.\nRead /reviewBaseline first. Review ONLY the frozen clean head/base and requirement inventory in that baseline. All reviewers receive the same immutable context and history cutoff. Read /contextMemory/reviewLedger and /contextMemory/reviewRounds when present; these preserve previous findings, fixer dispositions and review reasoning. Use original outputPath records for relevant disagreement or evidence details, rather than rereading every old review output. Without compact memory, read complete previous review rounds and fixer dispositions. Preserve stable local finding IDs. Reassess every prior open rating 2/3 finding. Settled findings may reopen only with freshEvidence describing new evidence or changed requirements. Resolved or accepted-rejection needs concrete evidence and reason. A fixer saying fixed is not proof. Preserve contradictory recommendations in disagreements until evidence resolves them. Removing a prior disagreement requires disputeResolutions:[{disagreement,reason,evidence}]. To reassess an inherited finding from a removed reviewer, use inheritedDispositions:[{id:\"reviewer:local-id\",status:\"resolved or accepted-rejection\",reason,evidence}]. Unmentioned inherited complaints remain open. Do not change product files, commit, publish, run hidden harness subagents or ask a question inside fanout. Report missing evidence instead of inventing a pass. Ratings: 1 nonblocking observation, 2 consequential should-fix, 3 must-fix.\nReturn {\"summary\":\"concrete result\",\"findings\":[{\"id\":\"stable-local-id\",\"rating\":2,\"summary\":\"concrete failure\",\"evidence\":\"file:line or actual check receipt\",\"status\":\"open or resolved or accepted-rejection\",\"requirementIds\":[\"stable inventory ID\"],\"reason\":\"required for settled dispositions\",\"freshEvidence\":\"required for reopening settled findings\"}],\"disagreements\":[\"unresolved conflicting recommendation and evidence\"]}. Runtime owns reviewer/revision/round stamps. Do not claim later QA executed; distinguish current code/local checks from future QA.",
                    "json": true,
                    "askQuestions": false
                  }
                ]
              ]
            },
            {
              "id": "review-gate",
              "configVersion": "step-config-v1",
              "reads": {
                "fix": "code-fix",
                "inventory": "extract-requirements",
                "fanout": "specialist-review",
                "impact": "assess-impact",
                "scopeClarify": "clarify",
                "scopeDecisions": "decisions",
                "scopePlan": "plan",
                "scopeSource": "@source",
                "scopeTicket": "@ticket",
                "draftPr": "draft-pr",
                "ci": "ci",
                "guide": "guide",
                "reviewGate": "review-gate",
                "handoff": "handoff",
                "merge": "merge"
              },
              "rules": [],
              "checks": [
                "review-boundary",
                "impact-boundary",
                {
                  "check": "scope-inputs",
                  "sources": {
                    "clarify": "scopeClarify",
                    "decisions": "scopeDecisions",
                    "plan": "scopePlan",
                    "existing-work": "scopeExistingWork",
                    "assess-existing": "scopeAssessment",
                    "source": "scopeSource",
                    "ticket": "scopeTicket"
                  }
                },
                "review-evidence",
                "review-assistance"
              ],
              "access": {
                "mode": "workspace"
              },
              "instructions": [],
              "name": "Check review findings",
              "branches": [
                {
                  "when": {
                    "path": "reviewIncomplete",
                    "equals": true
                  },
                  "next": "assess-impact"
                },
                {
                  "when": {
                    "path": "reviewBlocked",
                    "equals": true
                  },
                  "next": "code-fix"
                },
                {
                  "when": {
                    "path": "approved",
                    "equals": false
                  },
                  "next": "code-fix"
                }
              ],
              "maxVisits": 200,
              "type": "check",
              "check": {
                "results": {
                  "approved": {
                    "all": [
                      {
                        "count": "/evidence/review-evidence/findings",
                        "where": {
                          "all": [
                            {
                              "path": "/status",
                              "equals": "open"
                            },
                            {
                              "path": "/rating",
                              "min": 2
                            }
                          ]
                        },
                        "max": 0
                      },
                      {
                        "path": "/evidence/review-evidence/disagreements",
                        "empty": true
                      },
                      {
                        "any": [
                          {
                            "all": [
                              {
                                "path": "/evidence/review-evidence/reviewers",
                                "exists": true
                              },
                              {
                                "each": "/evidence/review-evidence/reviewers",
                                "require": {
                                  "all": [
                                    {
                                      "path": "/status",
                                      "equals": "completed"
                                    },
                                    {
                                      "path": "/blockers",
                                      "empty": true
                                    }
                                  ]
                                }
                              },
                              {
                                "count": "/evidence/review-evidence/coverage",
                                "where": {
                                  "path": "/status",
                                  "equals": "not_met"
                                },
                                "max": 0
                              }
                            ]
                          },
                          {
                            "all": [
                              {
                                "not": {
                                  "path": "/evidence/review-evidence/reviewers",
                                  "exists": true
                                }
                              },
                              {
                                "path": "/evidence/review-evidence/status",
                                "equals": "completed"
                              },
                              {
                                "path": "/evidence/review-evidence/blockers",
                                "empty": true
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  "findings": {
                    "aggregate": "filter",
                    "path": "/evidence/review-evidence/findings",
                    "where": {
                      "all": [
                        {
                          "path": "/status",
                          "equals": "open"
                        },
                        {
                          "path": "/rating",
                          "min": 2
                        }
                      ]
                    }
                  },
                  "reviewIncomplete": {
                    "path": "/evidence/review-evidence/reviewIncomplete",
                    "equals": true
                  },
                  "reviewBlocked": {
                    "path": "/evidence/review-evidence/reviewBlocked",
                    "equals": true
                  },
                  "questions": {
                    "select": "/evidence/review-evidence/questions"
                  },
                  "rawFindings": {
                    "select": "/evidence/review-evidence/rawFindings"
                  },
                  "coverage": {
                    "select": "/evidence/review-evidence/coverage"
                  },
                  "reviewers": {
                    "select": "/evidence/review-evidence/reviewers"
                  },
                  "disagreements": {
                    "select": "/evidence/review-evidence/disagreements"
                  }
                },
                "passed": {
                  "path": "/results/approved",
                  "equals": true
                }
              }
            },
            {
              "id": "ci",
              "configVersion": "step-config-v1",
              "reads": {
                "draftPr": "draft-pr",
                "ci": "ci",
                "guide": "guide",
                "reviewGate": "review-gate",
                "handoff": "handoff",
                "merge": "merge",
                "qaReview": "visual-review",
                "capture": "capture",
                "scope": "visual-scope",
                "qaGate": "visual-gate",
                "fix": "ci-fix",
                "impact": "assess-impact",
                "scopeClarify": "clarify",
                "scopeDecisions": "decisions",
                "scopePlan": "plan",
                "scopeSource": "@source",
                "scopeTicket": "@ticket"
              },
              "rules": [],
              "checks": [
                "impact-boundary",
                {
                  "check": "scope-inputs",
                  "sources": {
                    "clarify": "scopeClarify",
                    "decisions": "scopeDecisions",
                    "plan": "scopePlan",
                    "existing-work": "scopeExistingWork",
                    "assess-existing": "scopeAssessment",
                    "source": "scopeSource",
                    "ticket": "scopeTicket"
                  }
                }
              ],
              "access": {
                "mode": "workspace"
              },
              "instructions": [],
              "name": "Watch merge readiness",
              "branches": [
                {
                  "when": {
                    "path": "impactRequired",
                    "equals": true
                  },
                  "next": "assess-impact"
                },
                {
                  "when": {
                    "path": "retainQa",
                    "equals": true
                  },
                  "next": "guide"
                },
                {
                  "when": {
                    "path": "fix",
                    "equals": true
                  },
                  "next": "ci-fix"
                }
              ],
              "maxVisits": 200,
              "type": "tool",
              "tool": "ci",
              "args": []
            },
            {
              "id": "visual-scope",
              "configVersion": "step-config-v1",
              "reads": {
                "mergeReadiness": "@mergeReadiness",
                "scopeClarify": "clarify",
                "scopeDecisions": "decisions",
                "scopePlan": "plan",
                "scopeSource": "@source",
                "scopeTicket": "@ticket"
              },
              "output": {
                "format": "qa-scope-v1"
              },
              "rules": [
                {
                  "id": "video-contract",
                  "message": "Invalid input: expected \"video-v1\"",
                  "path": "/videoContract",
                  "require": {
                    "path": "/videoContract",
                    "equals": "video-v1"
                  }
                }
              ],
              "checks": [
                "architecture-revision",
                {
                  "check": "ids-resolve",
                  "adapter": "qa-scope"
                },
                {
                  "check": "scope-inputs",
                  "sources": {
                    "clarify": "scopeClarify",
                    "decisions": "scopeDecisions",
                    "plan": "scopePlan",
                    "existing-work": "scopeExistingWork",
                    "assess-existing": "scopeAssessment",
                    "source": "scopeSource",
                    "ticket": "scopeTicket"
                  }
                }
              ],
              "access": {
                "mode": "workspace"
              },
              "instructions": [
                "incremental-visual-scope",
                "video-scope",
                "impact-scope",
                "inventory-qa"
              ],
              "name": "Plan QA stories and screenshots",
              "branches": [],
              "maxVisits": 16,
              "type": "agent",
              "prompt": "Read the accepted requirements, all recorded decisions/expectations, plan, implementation receipts, relevant history and exact cumulative base-to-head PR diff (including inherited takeover work). Plan observable QA for ALL changed behavior: UI, API, CLI and other interfaces. Declare environment:{isolation:\"worktree\"} only when all QA uses independent per-worktree servers, databases and fixtures. For shared clusters, databases, fixtures or browser control return environment:{isolation:\"shared\",resources:[\"stable shared resource identity\"]}; use the same identity across repositories/runs using that resource. Unknown isolation requires shared protection, never assume a worktree isolates external resources. Cover happy paths and consequential failure, permission and boundary cases proportionately. Trace stories to agreed requirements; do not invent business requirements or turn subjective preferences into blocking criteria. Explain any requirement/diff area outside executable QA in exclusions. Assess navigation, feedback, readability and recovery where relevant.\nReturn {\"qaContract\":\"qa-v1\",\"changed\":false,\"areas\":[],\"captureBudget\":24,\"stories\":[{\"id\":\"stable-story-id\",\"goal\":\"user goal\",\"requirementRefs\":[\"requirements/0 or decisions/0 or answers/0 (existing zero-based accepted record)\"],\"interface\":\"ui or api or cli or other\",\"preconditions\":[\"setup\"],\"fixtures\":[\"access or data needed\"],\"actions\":[\"ordered executable action\"],\"criteria\":[{\"id\":\"globally unique stable criterion ID\",\"expected\":\"observable expected outcome\"}],\"evidenceInstructions\":\"how to execute and record evidence\",\"screenshotTasks\":[{\"area\":\"exact selected area\",\"state\":\"exact selected state at a defined point in these actions\"}]}],\"exclusions\":[{\"requirementRef\":\"requirement/diff area\",\"reason\":\"concrete reason outside executable QA\"}]}.\nchanged refers only to VISUAL scope. Nonvisual changes still need executable stories with real behavioral checks and may have zero screenshots. No changed executable behavior may use stories=[] only with a concrete notApplicableReason; no visual changes is insufficient. Inspect relevant existing tests before selecting them as criterion evidence.\nFor visuals return changed=true and areas:[{name,url,states:[\"single concrete representative state\"],instructions,rationale,dependencies,changed}]. Normally choose 1–2 states per area and at most 24 screenshots. Group co-visible elements. Never multiply viewport/language/role combinations or comma-separated alternatives. Additional states must show distinct changed rendering risk. Up to 48 needs a concrete budgetReason. Every selected area/state must be linked to a story; API/CLI checks do not need artificial images. Dependencies are exact repository files or directory/** paths. Do not change code, execute QA or take screenshots.{{instruction:video-scope}}{{instruction:inventory-qa}}{{instruction:impact-scope}}",
              "json": true,
              "askQuestions": false
            },
            {
              "id": "capture",
              "configVersion": "step-config-v1",
              "reads": {
                "qaReuse": "@qaReuse",
                "qaReview": "visual-review",
                "scope": "visual-scope",
                "qaGate": "visual-gate",
                "answers": "@answers",
                "scopeClarify": "clarify",
                "scopeDecisions": "decisions",
                "scopePlan": "plan",
                "scopeSource": "@source",
                "scopeTicket": "@ticket"
              },
              "output": {
                "format": "qa-capture-v1"
              },
              "rules": [
                {
                  "id": "video-contract",
                  "message": "Invalid input: expected \"video-v1\"",
                  "path": "/videoContract",
                  "require": {
                    "path": "/videoContract",
                    "equals": "video-v1"
                  }
                }
              ],
              "checks": [
                "architecture-revision",
                "capture-evidence",
                "qa-environment",
                {
                  "check": "media-valid",
                  "adapter": "capture",
                  "video": true
                },
                {
                  "check": "scope-inputs",
                  "sources": {
                    "clarify": "scopeClarify",
                    "decisions": "scopeDecisions",
                    "plan": "scopePlan",
                    "existing-work": "scopeExistingWork",
                    "assess-existing": "scopeAssessment",
                    "source": "scopeSource",
                    "ticket": "scopeTicket"
                  }
                }
              ],
              "access": {
                "mode": "workspace"
              },
              "instructions": [
                "incremental-capture",
                "video-capture",
                "impact-capture"
              ],
              "name": "Execute QA and capture screenshots",
              "next": "visual-review",
              "branches": [],
              "maxVisits": 16,
              "type": "agent",
              "prompt": "Execute EVERY planned QA story and acceptance criterion from visual-scope, including nonvisual API/CLI behavior. Read /answers for resolved access, fixtures and tooling blockers. Set up the application once when needed, use appropriate actual fixtures, and execute browser/HTTP/CLI/tests as instructed. Inspect test coverage and run the checks; source inspection or an implementation receipt alone cannot establish a pass. Compare observed outcomes with each exact expected outcome. Assess applicable navigation, feedback, readability and recovery. Do not modify product code or repair failures.\nReturn {\"qaContract\":\"qa-v1\",\"results\":[{\"storyId\":\"planned ID\",\"outcome\":\"passed or failed or blocked\",\"criteria\":[{\"criterionId\":\"planned ID\",\"outcome\":\"passed or failed or blocked\",\"expected\":\"exact expected outcome from scope\",\"observed\":\"actual observed outcome\",\"blockedReason\":\"concrete assistance needed when blocked\",\"evidence\":[{\"kind\":\"command or test or http or browser or log\",\"executed\":true,\"action\":\"actual command/request/actions performed\",\"details\":\"exit/result/request-response/log details demonstrating this criterion\",\"exitCode\":0,\"screenshotTasks\":[{\"area\":\"selected area\",\"state\":\"selected state\"}]}]}]}],\"findings\":[{\"id\":\"stable finding ID\",\"rating\":3,\"summary\":\"consequential requirement failure\",\"evidence\":\"concrete receipt\",\"status\":\"open\",\"storyId\":\"planned ID\",\"criterionId\":\"planned criterion ID\",\"requirementRefs\":[\"accepted requirement\"],\"reproduction\":[\"steps\"],\"expected\":\"expected behavior\",\"actual\":\"actual behavior\"}],\"observations\":[{\"id\":\"stable observation ID\",\"summary\":\"optional UI/UX improvement\",\"evidence\":\"observed details\",\"storyId\":\"story ID\"}],\"screenshots\":[{\"path\":\"absolute real image path\",\"caption\":\"what it demonstrates\",\"area\":\"exact area\",\"state\":\"exact state\"}],\"unavailable\":[{\"area\":\"selected area\",\"reason\":\"concrete missing access/tooling/setup or failed behavior\",\"cause\":\"access or product\"}]}.\nOne result per story and criterion. Ratings 2/3 are consequential failures against agreed requirements; keep optional preferences in observations. Product failures are failed with actionable findings. If failed product behavior prevents a selected screenshot, report unavailable with cause:\"product\" linked to that failing story; missing access/tooling uses cause:\"access\". Missing access, fixtures or tooling is blocked with a concrete reason; never pass an unexecuted check. Story outcome must agree with criterion outcomes. Do not supply a revision claim; runtime stamps provenance. Execute criteria freshly on each visit; image reuse never establishes a behavioral pass.\nCapture exactly the selected representative screenshot tasks at their defined points DURING the story flows. Keep the captureBudget (normally 24, justified maximum 48), one real PNG/JPEG per exact area/state. Do not invent states or expand combinations. Save images under the supplied evidence directory with fresh filenames for each revision; inspect actual captures for readability. Keep the complete inventory, including provenance-eligible explicitly accepted unchanged images. Never claim images or checks that do not exist. Stop only servers you started, after all testing and captures finish.{{instruction:video-capture}}{{instruction:impact-capture}}",
              "json": true,
              "askQuestions": false
            },
            {
              "id": "visual-review",
              "configVersion": "step-config-v1",
              "reads": {
                "capture": "capture",
                "scope": "visual-scope",
                "scopeClarify": "clarify",
                "scopeDecisions": "decisions",
                "scopePlan": "plan",
                "scopeSource": "@source",
                "scopeTicket": "@ticket"
              },
              "output": {
                "format": "qa-review-v1"
              },
              "rules": [
                {
                  "id": "recovery-reason",
                  "message": "Blocked or failed review requires a concrete recovery reason",
                  "when": {
                    "path": "/status",
                    "notEquals": "completed"
                  },
                  "require": {
                    "any": [
                      {
                        "path": "/blockers",
                        "empty": false
                      },
                      {
                        "path": "/summary",
                        "empty": false
                      }
                    ]
                  }
                },
                {
                  "id": "completed-without-blockers",
                  "message": "Completed review cannot retain missing-input/tooling blockers",
                  "when": {
                    "path": "/status",
                    "equals": "completed"
                  },
                  "require": {
                    "path": "/blockers",
                    "empty": true
                  }
                }
              ],
              "checks": [
                "architecture-revision",
                "qa-review-evidence",
                {
                  "check": "scope-inputs",
                  "sources": {
                    "clarify": "scopeClarify",
                    "decisions": "scopeDecisions",
                    "plan": "scopePlan",
                    "existing-work": "scopeExistingWork",
                    "assess-existing": "scopeAssessment",
                    "source": "scopeSource",
                    "ticket": "scopeTicket"
                  }
                }
              ],
              "revision": "bound",
              "access": {
                "mode": "workspace"
              },
              "instructions": [
                "incremental-visual-review",
                "review-completion",
                "video-gate"
              ],
              "name": "Review QA and screenshots",
              "next": "visual-gate",
              "branches": [],
              "maxVisits": 16,
              "type": "agent",
              "prompt": "Review the current diff against the accepted plan. Use /contextMemory/reviewLedger and /contextMemory/reviewRounds for ALL distinct historical review findings and fixer responses when available; original rounds remain accessible through source references. Read old output details only when relevant evidence is needed. Use stable finding IDs; do not reopen resolved findings without fresh evidence. A fixer may reject a complaint with evidence; assess that evidence and either accept or reject the rejection with reasoning. Return {\"findings\":[{\"id\":\"stable-id\",\"rating\":2,\"summary\":\"...\",\"evidence\":\"file:line and concrete failure\",\"status\":\"open\"}],\"summary\":\"...\"}. Ratings: 1 nitpick, 2 should fix, 3 must fix. Include unresolved rating 2/3 findings from earlier rounds. Return no findings only when all consequential complaints are resolved or their rejections accepted. Do not modify code.\nThis is a QA AND SCREENSHOT review. Return qaContract:\"qa-v1\" alongside the review fields. Inspect accepted business requirements and expectations, cumulative diff, planned stories, complete criterion coverage, executed test receipts, failures, blocked checks, optional observations and all retained disputes. A screenshot alone cannot prove behavior, and an agent saying passed without actual executed evidence is insufficient. Missing/blocked required QA cannot be approved. Failed required behavior requires a fix and retest even when a fixer rejects a complaint. Corrections to erroneous scenarios must match accepted requirements and record a rationale.\nOpen the actual selected screenshots. Return acceptedScreenshots:[{area,state,imageSha256}] for every individually inspected good image, using its exact supplied hash. Exclude images affected by unresolved findings. Missing critical SELECTED states is rating 3; do not invent larger viewport/language/role matrices. Request only minimum targeted replacements by exact area/state. Preserve explicitly accepted unchanged image receipts and optional observations without making preferences blocking. Return complete current coverage, not merely the latest delta. Do not execute QA again, change code or recapture images.{{instruction:video-gate}}",
              "json": true,
              "askQuestions": false
            },
            {
              "id": "visual-gate",
              "configVersion": "step-config-v1",
              "reads": {
                "qaReview": "visual-review",
                "scope": "visual-scope",
                "capture": "capture",
                "review": "visual-review",
                "fix": "visual-fix",
                "scopeClarify": "clarify",
                "scopeDecisions": "decisions",
                "impact": "assess-impact",
                "scopePlan": "plan",
                "scopeSource": "@source",
                "scopeTicket": "@ticket",
                "draftPr": "draft-pr",
                "ci": "ci",
                "guide": "guide",
                "reviewGate": "review-gate",
                "handoff": "handoff",
                "merge": "merge"
              },
              "rules": [],
              "checks": [
                "qa-evidence",
                {
                  "check": "media-valid",
                  "adapter": "qa-gate",
                  "video": true
                },
                "impact-boundary",
                {
                  "check": "scope-inputs",
                  "sources": {
                    "clarify": "scopeClarify",
                    "decisions": "scopeDecisions",
                    "plan": "scopePlan",
                    "existing-work": "scopeExistingWork",
                    "assess-existing": "scopeAssessment",
                    "source": "scopeSource",
                    "ticket": "scopeTicket"
                  }
                },
                "review-evidence",
                "review-assistance",
                "qa-gate-evidence"
              ],
              "access": {
                "mode": "workspace"
              },
              "instructions": [],
              "name": "Check QA and screenshots",
              "next": "guide",
              "branches": [
                {
                  "when": {
                    "path": "qaRetry",
                    "equals": true
                  },
                  "next": "capture"
                },
                {
                  "when": {
                    "path": "qaBlocked",
                    "equals": true
                  },
                  "next": "capture"
                },
                {
                  "when": {
                    "path": "captureBlocked",
                    "equals": true
                  },
                  "next": "capture"
                },
                {
                  "when": {
                    "path": "reviewIncomplete",
                    "equals": true
                  },
                  "next": "assess-impact"
                },
                {
                  "when": {
                    "path": "reviewBlocked",
                    "equals": true
                  },
                  "next": "visual-fix"
                },
                {
                  "when": {
                    "path": "approved",
                    "equals": false
                  },
                  "next": "visual-fix"
                }
              ],
              "maxVisits": 200,
              "type": "check",
              "check": {
                "results": {
                  "approved": {
                    "all": [
                      {
                        "path": "/evidence/qa-gate-evidence",
                        "exists": true
                      },
                      {
                        "path": "/evidence/review-evidence/incomplete",
                        "equals": false
                      },
                      {
                        "path": "/evidence/qa-gate-evidence/findings",
                        "empty": true
                      },
                      {
                        "path": "/evidence/qa-gate-evidence/evidenceErrors",
                        "empty": true
                      },
                      {
                        "path": "/evidence/qa-gate-evidence/evidenceBlocked",
                        "empty": true
                      }
                    ]
                  },
                  "findings": {
                    "select": "/evidence/qa-gate-evidence/findings"
                  },
                  "reviewIncomplete": {
                    "all": [
                      {
                        "path": "/evidence/review-evidence/incomplete",
                        "equals": true
                      },
                      {
                        "path": "/evidence/qa-gate-evidence/findings",
                        "empty": true
                      }
                    ]
                  },
                  "reviewBlocked": {
                    "path": "/evidence/review-evidence/reviewBlocked",
                    "equals": true
                  },
                  "questions": {
                    "select": "/evidence/review-evidence/questions"
                  },
                  "qaContract": {
                    "select": "/evidence/qa-gate-evidence/qaContract"
                  },
                  "observations": {
                    "select": "/evidence/qa-gate-evidence/observations"
                  },
                  "headSha": {
                    "select": "/evidence/qa-gate-evidence/headSha"
                  },
                  "scopeHash": {
                    "select": "/evidence/qa-gate-evidence/scopeHash"
                  },
                  "captureHash": {
                    "select": "/evidence/qa-gate-evidence/captureHash"
                  },
                  "reviewHash": {
                    "select": "/evidence/qa-gate-evidence/reviewHash"
                  },
                  "evidenceIssues": {
                    "select": "/evidence/qa-gate-evidence/evidenceIssues"
                  },
                  "qaRetry": {
                    "select": "/evidence/qa-gate-evidence/qaRetry"
                  },
                  "qaBlocked": {
                    "select": "/evidence/qa-gate-evidence/qaBlocked"
                  },
                  "captureBlocked": {
                    "select": "/evidence/qa-gate-evidence/captureBlocked"
                  }
                },
                "passed": {
                  "path": "/results/approved",
                  "equals": true
                }
              }
            },
            {
              "id": "code-fix",
              "configVersion": "step-config-v1",
              "reads": {
                "reviewFix": "@reviewFix",
                "reviewGate": "review-gate",
                "publication": "draft-pr",
                "scopeClarify": "clarify",
                "scopeDecisions": "decisions",
                "scopePlan": "plan",
                "scopeSource": "@source",
                "scopeTicket": "@ticket"
              },
              "output": {
                "format": "review-fix-v1"
              },
              "rules": [
                {
                  "id": "architecture-handback",
                  "message": "Architecture revision requires status=blocked and questions=[]; the configured proposal route owns review and any required acceptance",
                  "when": {
                    "path": "/architectureRevision",
                    "equals": true
                  },
                  "require": {
                    "all": [
                      {
                        "path": "/status",
                        "equals": "blocked"
                      },
                      {
                        "path": "/questions",
                        "exists": true
                      },
                      {
                        "path": "/questions",
                        "maxLength": 0
                      }
                    ]
                  }
                }
              ],
              "checks": [
                "architecture-revision",
                "optional-questions",
                "review-dispositions",
                {
                  "check": "scope-inputs",
                  "sources": {
                    "clarify": "scopeClarify",
                    "decisions": "scopeDecisions",
                    "plan": "scopePlan",
                    "existing-work": "scopeExistingWork",
                    "assess-existing": "scopeAssessment",
                    "source": "scopeSource",
                    "ticket": "scopeTicket"
                  }
                }
              ],
              "access": {
                "mode": "push"
              },
              "instructions": [
                "incremental-review-fix",
                "review-fix"
              ],
              "name": "Fix review findings",
              "next": "assess-impact",
              "branches": [],
              "maxVisits": 16,
              "type": "agent",
              "prompt": "Fix all open rating 2/3 findings. Use /contextMemory/reviewLedger and /contextMemory/reviewRounds for ALL distinct past findings and fixer dispositions when available, reading original source references only when needed; avoid alternating fixes or reopening settled issues without evidence. You may reject a complaint with concrete evidence. Return {\"dispositions\":[{\"id\":\"finding-id\",\"status\":\"fixed or rejected\",\"reason\":\"...\"}],\"summary\":\"...\",\"questions\":[]}. Run relevant checks, commit and push changes to the same draft PR. Do not merge or mark the PR ready.\n{{instruction:review-fix}}",
              "json": true,
              "askQuestions": false
            },
            {
              "id": "ci-fix",
              "configVersion": "step-config-v1",
              "reads": {
                "ci": "ci",
                "feedback": "@feedback",
                "mergeReadiness": "@mergeReadiness",
                "publication": "draft-pr",
                "scopeClarify": "clarify",
                "scopeDecisions": "decisions",
                "scopePlan": "plan",
                "scopeSource": "@source",
                "scopeTicket": "@ticket"
              },
              "output": {
                "format": "ci-fix-v1"
              },
              "rules": [
                {
                  "id": "architecture-handback",
                  "message": "Architecture revision requires status=blocked and questions=[]; the configured proposal route owns review and any required acceptance",
                  "when": {
                    "path": "/architectureRevision",
                    "equals": true
                  },
                  "require": {
                    "all": [
                      {
                        "path": "/status",
                        "equals": "blocked"
                      },
                      {
                        "path": "/questions",
                        "exists": true
                      },
                      {
                        "path": "/questions",
                        "maxLength": 0
                      }
                    ]
                  }
                }
              ],
              "checks": [
                "architecture-revision",
                "optional-questions",
                "feedback-assessment",
                {
                  "check": "scope-inputs",
                  "sources": {
                    "clarify": "scopeClarify",
                    "decisions": "scopeDecisions",
                    "plan": "scopePlan",
                    "existing-work": "scopeExistingWork",
                    "assess-existing": "scopeAssessment",
                    "source": "scopeSource",
                    "ticket": "scopeTicket"
                  }
                }
              ],
              "access": {
                "mode": "push"
              },
              "instructions": [
                "incremental-ci-fix",
                "ci-fix-runtime",
                "ci-assessment"
              ],
              "name": "Fix CI failures",
              "next": "after-ci-fix-observe",
              "branches": [],
              "maxVisits": 16,
              "type": "agent",
              "prompt": "Diagnose and fix CI failures, merge conflicts, stale branches and actionable PR review comments in the supplied merge-readiness receipt and full history. Fetch the base before resolving conflicts. For each supplied unresolved review thread, address it or post an evidence-backed response before resolving it using the selected Git provider (GitHub: write a token-free JSON request file with method POST, path graphql and body {query,variables}, set repoUrl to the selected HTTPS repository URL and requestFile to that file, then run sh -c \"$BOBS_FACTORY_GITHUB_CREDENTIAL_COMMAND github-api \\\"\\$@\\\"\" bobs-factory --repo \"$repoUrl\" --request \"$requestFile\" with the resolveReviewThread mutation; GitLab: glab api PUT the MR discussion with resolved=true; custom: the configured adapter). Do not dismiss reviews or bypass rules. Required reviewer approvals must wait for the reviewer; do not impersonate one. Assess every supplied new PR comment. Act on requested corrections or document why a comment is informational. Record its ID in addressedCommentIds after assessment, and include disposition/reason in the summary. Add <!-- generated-by-bobs-factory --> to any PR reply you write. Retain all discussion and report addressed comment/thread IDs. Run relevant checks, commit and push to the same draft PR. Return {\"summary\":\"...\",\"checks\":[\"...\"],\"addressedReviewIds\":[\"review IDs\"],\"addressedCommentIds\":[\"comment IDs\"]}. Do not merge or mark ready.{{instruction:ci-assessment}}",
              "json": true,
              "askQuestions": false
            },
            {
              "id": "after-ci-fix-observe",
              "configVersion": "step-config-v1",
              "reads": {
                "draftPr": "draft-pr",
                "ci": "ci",
                "guide": "guide",
                "reviewGate": "review-gate",
                "handoff": "handoff",
                "merge": "merge",
                "qaReview": "visual-review",
                "capture": "capture",
                "scope": "visual-scope",
                "qaGate": "visual-gate",
                "fix": "ci-fix",
                "impact": "assess-impact",
                "scopeClarify": "clarify",
                "scopeDecisions": "decisions",
                "scopePlan": "plan",
                "scopeSource": "@source",
                "scopeTicket": "@ticket"
              },
              "rules": [],
              "checks": [
                "impact-boundary",
                {
                  "check": "scope-inputs",
                  "sources": {
                    "clarify": "scopeClarify",
                    "decisions": "scopeDecisions",
                    "plan": "scopePlan",
                    "existing-work": "scopeExistingWork",
                    "assess-existing": "scopeAssessment",
                    "source": "scopeSource",
                    "ticket": "scopeTicket"
                  }
                }
              ],
              "access": {
                "mode": "workspace"
              },
              "instructions": [],
              "name": "Inspect current review and provider evidence",
              "next": "after-ci-fix",
              "branches": [],
              "maxVisits": 200,
              "type": "tool",
              "tool": "inspect-review-readiness",
              "args": []
            },
            {
              "id": "after-ci-fix",
              "configVersion": "step-config-v1",
              "reads": {
                "draftPr": "draft-pr",
                "ci": "ci",
                "guide": "guide",
                "reviewGate": "review-gate",
                "handoff": "handoff",
                "merge": "merge",
                "qaReview": "visual-review",
                "capture": "capture",
                "scope": "visual-scope",
                "qaGate": "visual-gate",
                "fix": "ci-fix",
                "impact": "assess-impact",
                "scopeClarify": "clarify",
                "scopeDecisions": "decisions",
                "scopePlan": "plan",
                "scopeSource": "@source",
                "scopeTicket": "@ticket",
                "observation": "after-ci-fix-observe",
                "observations": "after-ci-fix-observe/observations"
              },
              "rules": [],
              "checks": [
                "impact-boundary",
                {
                  "check": "scope-inputs",
                  "sources": {
                    "clarify": "scopeClarify",
                    "decisions": "scopeDecisions",
                    "plan": "scopePlan",
                    "existing-work": "scopeExistingWork",
                    "assess-existing": "scopeAssessment",
                    "source": "scopeSource",
                    "ticket": "scopeTicket"
                  }
                },
                "post-fix-evidence"
              ],
              "access": {
                "mode": "workspace"
              },
              "instructions": [],
              "name": "Check whether code needs another review",
              "next": "assess-impact",
              "branches": [
                {
                  "when": {
                    "path": "needsAssistance",
                    "equals": true
                  },
                  "next": "ci-fix"
                }
              ],
              "maxVisits": 200,
              "type": "check",
              "check": {
                "results": {
                  "reviewRequired": {
                    "some": "/inputs/observations",
                    "require": {
                      "any": [
                        {
                          "any": [
                            {
                              "some": "/feedback",
                              "require": {
                                "all": [
                                  {
                                    "path": "/kind",
                                    "in": [
                                      "threads",
                                      "reviews",
                                      "revision"
                                    ]
                                  },
                                  {
                                    "any": [
                                      {
                                        "not": {
                                          "path": "/action",
                                          "exists": true
                                        }
                                      },
                                      {
                                        "path": "/action",
                                        "equals": "fix"
                                      }
                                    ]
                                  },
                                  {
                                    "any": [
                                      {
                                        "not": {
                                          "path": "/fixReviewRequired",
                                          "equals": false
                                        }
                                      },
                                      {
                                        "path": "/currentFix",
                                        "equals": true
                                      }
                                    ]
                                  }
                                ]
                              }
                            },
                            {
                              "all": [
                                {
                                  "some": "/feedback",
                                  "require": {
                                    "path": "/kind",
                                    "equals": "comments"
                                  }
                                },
                                {
                                  "not": {
                                    "path": "/fix/reviewRequired",
                                    "equals": false
                                  }
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "path": "/fix/reviewRequired",
                          "equals": true
                        },
                        {
                          "path": "/reviewed",
                          "equals": null
                        },
                        {
                          "path": "/reviewed/dirty",
                          "equals": true
                        },
                        {
                          "path": "/dirty",
                          "equals": true
                        },
                        {
                          "not": {
                            "path": "/reviewed/headSha",
                            "equalsPath": "/headSha"
                          }
                        },
                        {
                          "not": {
                            "path": "/readiness/headSha",
                            "equalsPath": "/headSha"
                          }
                        },
                        {
                          "path": "/previousBase",
                          "equals": null
                        },
                        {
                          "not": {
                            "path": "/previousBase",
                            "equalsPath": "/readiness/baseSha"
                          }
                        },
                        {
                          "not": {
                            "path": "/reviewApproved",
                            "equals": true
                          }
                        },
                        {
                          "path": "/scopeChanged",
                          "equals": true
                        }
                      ]
                    }
                  },
                  "headSha": {
                    "select": "/inputs/observation/headSha"
                  },
                  "baseSha": {
                    "select": "/inputs/observation/readiness/baseSha"
                  },
                  "baseChanged": {
                    "some": "/inputs/observations",
                    "require": {
                      "not": {
                        "path": "/previousBase",
                        "equalsPath": "/readiness/baseSha"
                      }
                    }
                  },
                  "unchangedRevision": {
                    "some": "/inputs/observations",
                    "require": {
                      "all": [
                        {
                          "path": "/dirty",
                          "equals": false
                        },
                        {
                          "not": {
                            "path": "/readiness/headSha",
                            "equalsPath": "/headSha"
                          }
                        },
                        {
                          "path": "/previous/worktreeHeadSha",
                          "equalsPath": "/headSha"
                        },
                        {
                          "path": "/previous/headSha",
                          "equalsPath": "/readiness/headSha"
                        },
                        {
                          "path": "/previous/baseSha",
                          "equalsPath": "/readiness/baseSha"
                        }
                      ]
                    }
                  },
                  "unchangedFailures": {
                    "some": "/inputs/observations",
                    "require": {
                      "all": [
                        {
                          "not": {
                            "any": [
                              {
                                "any": [
                                  {
                                    "some": "/feedback",
                                    "require": {
                                      "all": [
                                        {
                                          "path": "/kind",
                                          "in": [
                                            "threads",
                                            "reviews",
                                            "revision"
                                          ]
                                        },
                                        {
                                          "any": [
                                            {
                                              "not": {
                                                "path": "/action",
                                                "exists": true
                                              }
                                            },
                                            {
                                              "path": "/action",
                                              "equals": "fix"
                                            }
                                          ]
                                        },
                                        {
                                          "any": [
                                            {
                                              "not": {
                                                "path": "/fixReviewRequired",
                                                "equals": false
                                              }
                                            },
                                            {
                                              "path": "/currentFix",
                                              "equals": true
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  },
                                  {
                                    "all": [
                                      {
                                        "some": "/feedback",
                                        "require": {
                                          "path": "/kind",
                                          "equals": "comments"
                                        }
                                      },
                                      {
                                        "not": {
                                          "path": "/fix/reviewRequired",
                                          "equals": false
                                        }
                                      }
                                    ]
                                  }
                                ]
                              },
                              {
                                "path": "/fix/reviewRequired",
                                "equals": true
                              },
                              {
                                "path": "/reviewed",
                                "equals": null
                              },
                              {
                                "path": "/reviewed/dirty",
                                "equals": true
                              },
                              {
                                "path": "/dirty",
                                "equals": true
                              },
                              {
                                "not": {
                                  "path": "/reviewed/headSha",
                                  "equalsPath": "/headSha"
                                }
                              },
                              {
                                "not": {
                                  "path": "/readiness/headSha",
                                  "equalsPath": "/headSha"
                                }
                              },
                              {
                                "path": "/previousBase",
                                "equals": null
                              },
                              {
                                "not": {
                                  "path": "/previousBase",
                                  "equalsPath": "/readiness/baseSha"
                                }
                              },
                              {
                                "not": {
                                  "path": "/reviewApproved",
                                  "equals": true
                                }
                              },
                              {
