              "id": "visual-fix",
              "configVersion": "step-config-v1",
              "reads": {
                "reviewFix": "@reviewFix",
                "qaGate": "visual-gate",
                "review": "visual-review",
                "reviewGate": "visual-gate",
                "scopeClarify": "clarify",
                "scopeDecisions": "decisions",
                "publication": "draft-pr",
                "scopePlan": "plan",
                "scopeSource": "@source",
                "scopeTicket": "@ticket"
              },
              "output": {
                "format": "review-fix-v1"
              },
              "rules": [
                {
                  "id": "architecture-handback",
                  "message": "Architecture revision requires status=blocked and questions=[]; the configured proposal route owns review and any required acceptance",
                  "when": {
                    "path": "/architectureRevision",
                    "equals": true
                  },
                  "require": {
                    "all": [
                      {
                        "path": "/status",
                        "equals": "blocked"
                      },
                      {
                        "path": "/questions",
                        "exists": true
                      },
                      {
                        "path": "/questions",
                        "maxLength": 0
                      }
                    ]
                  }
                }
              ],
              "checks": [
                "architecture-revision",
                "optional-questions",
                "review-dispositions",
                {
                  "check": "scope-inputs",
                  "sources": {
                    "clarify": "scopeClarify",
                    "decisions": "scopeDecisions",
                    "plan": "scopePlan",
                    "existing-work": "scopeExistingWork",
                    "assess-existing": "scopeAssessment",
                    "source": "scopeSource",
                    "ticket": "scopeTicket"
                  }
                }
              ],
              "access": {
                "mode": "push"
              },
              "instructions": [
                "incremental-review-fix",
                "review-fix",
                "visual-fix"
              ],
              "name": "Fix QA and visual findings",
              "next": "assess-impact",
              "branches": [],
              "maxVisits": 16,
              "type": "agent",
              "prompt": "Fix all open rating 2/3 findings. Use /contextMemory/reviewLedger and /contextMemory/reviewRounds for ALL distinct past findings and fixer dispositions when available, reading original source references only when needed; avoid alternating fixes or reopening settled issues without evidence. You may reject a complaint with concrete evidence. Return {\"dispositions\":[{\"id\":\"finding-id\",\"status\":\"fixed or rejected\",\"reason\":\"...\"}],\"summary\":\"...\",\"questions\":[]}. Run relevant checks, commit and push changes to the same draft PR. Do not merge or mark the PR ready.\n{{instruction:review-fix}}{{instruction:visual-fix}}",
              "json": true,
              "askQuestions": false
            },
            {
              "id": "guide",
              "configVersion": "step-config-v1",
              "reads": {
                "ci": "ci",
                "capture": "capture",
                "qaReview": "visual-review",
                "scope": "visual-scope",
                "mergeReadiness": "@mergeReadiness",
                "scopeClarify": "clarify",
                "scopeDecisions": "decisions",
                "scopePlan": "plan",
                "scopeSource": "@source",
                "scopeTicket": "@ticket"
              },
              "output": {
                "format": "review-brief-v3"
              },
              "rules": [],
              "checks": [
                "architecture-revision",
                "requirement-coverage",
                {
                  "check": "code-refs-valid",
                  "adapter": "guide"
                },
                {
                  "check": "media-valid",
                  "adapter": "guide",
                  "video": true
                },
                {
                  "check": "scope-inputs",
                  "sources": {
                    "clarify": "scopeClarify",
                    "decisions": "scopeDecisions",
                    "plan": "scopePlan",
                    "existing-work": "scopeExistingWork",
                    "assess-existing": "scopeAssessment",
                    "source": "scopeSource",
                    "ticket": "scopeTicket"
                  }
                }
              ],
              "access": {
                "mode": "workspace"
              },
              "instructions": [
                "brief-runtime",
                "impact-guide",
                "video-brief"
              ],
              "name": "Prepare human review brief",
              "next": "handoff",
              "branches": [],
              "maxVisits": 16,
              "type": "agent",
              "prompt": "Write the human review brief for the WHOLE PR at the current revision, including inherited takeover work and every accepted iteration. The reader decides one thing: does this PR deliver what was asked? Answer in this order: was the right thing built (the ask and every interpretation of it), does it work (one decisive, human-checkable proof per requirement), what only a human can judge, and what else changed or remains unproven.\nFirst read through factory-context: the original input/ticket and all comments, clarification decisions and answers, the frozen requirement inventory and review-gate coverage, the accepted plan, /progress/reviewScope (every whole-PR file), executed QA stories with observed values, and the accepted capture inventory. Inspect the actual base-to-head diff yourself.\nReturn {\"verdict\":{\"headline\":\"what now works, said the way a user would say it (<=160 chars)\",\"readiness\":\"ready|ready-with-caveats|not-ready\",\"why\":\"one sentence (<=260)\"},\"ask\":{\"source\":\"e.g. Linear ATT-764\",\"url\":\"ticket URL when known\",\"quote\":\"the original request verbatim, trimmed to its substance\"},\"interpretation\":[{\"topic\":\"short\",\"chosen\":\"what was built\",\"alternatives\":[\"what the ask could also have meant\"],\"decidedBy\":\"you|ticket|bob\",\"note\":\"optional, e.g. You delegated this choice.\"}],\"requirements\":[{\"id\":\"kebab-id\",\"text\":\"observable outcome (<=180)\",\"origin\":\"ask|your-answer|bob\",\"covers\":[\"frozen inventory requirement IDs\"],\"status\":\"shown|tested|partly|not-shown|gap|waived\",\"proof\":PROOF,\"more\":[PROOF],\"caveat\":\"optional limit specific to this line\",\"files\":[\"exact changed files that implement it\"]}],\"yourCall\":[{\"question\":\"...?\",\"context\":\"the facts a person needs\",\"bobChose\":\"what was built and why\",\"proof\":PROOF}],\"beyondAsk\":[{\"what\":\"...\",\"why\":\"...\",\"attention\":\"none|low|look\",\"files\":[\"...\"]}],\"notVerified\":[{\"what\":\"...\",\"why\":\"...\"}],\"noticed\":[\"pre-existing problem seen but not changed\"],\"hygiene\":[{\"text\":\"satisfied process criterion, e.g. No generated code committed\",\"covers\":[\"inventory IDs\"]}]}. Add \"system\" only as described below.\nPROOF is exactly one of:\n{\"kind\":\"screens\",\"shots\":[{\"area\":\"exact capture area\",\"state\":\"exact capture state\",\"label\":\"what to look at\",\"focus\":{\"x\":0,\"y\":0,\"w\":100,\"h\":100}}],\"note\":\"optional\"}: focus crops the image, in percent, to the pixels that prove the claim (open the image to choose it). Prefer pairs varying only the condition under test (English vs German, setting A vs B, before vs after).\n{\"kind\":\"video\",\"taskId\":\"...\",\"sha256\":\"...\",\"label\":\"...\"}: from the accepted video inventory.\n{\"kind\":\"table\",\"method\":\"how it was observed\",\"columns\":[\"Given\",\"Observed\"],\"rows\":[{\"cells\":[\"...\",\"...\"],\"mark\":\"good|bad|neutral\"}]}: quote actual observed values (rendered text, HTTP status, payload fields) from QA receipts. Use it as a decision table for business rules, marking where a rule does nothing as bad.\n{\"kind\":\"code\",\"file\":\"repository-relative path\",\"excerpt\":\"at most 25 lines of the real diff, +/- prefixed\",\"note\":\"why this proves it\"}\n{\"kind\":\"test\",\"file\":\"...\",\"excerpt\":\"test names or the key assertion\",\"result\":\"what passed\"}\n{\"kind\":\"command\",\"command\":\"...\",\"output\":\"trimmed real output\",\"note\":\"optional\"}\n{\"kind\":\"steps\",\"steps\":[{\"label\":\"...\",\"detail\":\"...\",\"change\":\"new|changed|manual\"}]}: only when the requirement IS a linear sequence.\n{\"kind\":\"flowRef\",\"flow\":\"flow-id\",\"steps\":[1,2],\"note\":\"...\"}: points at steps of a system flow.\nRules:\n- Status describes the proof honestly: shown = a human-visible observation at this revision proves it; tested = only automated tests prove it; partly = some cases proven and the caveat names what is not; not-shown = no evidence; gap = not met; waived = deliberately skipped by an accepted decision. A passed label, an implementation receipt or source reading alone is not proof.\n- Every proof is judgeable in about 30 seconds without opening a file. Observed values beat descriptions. Never invent values; take them from executed receipts.\n- Screenshots appear only as proof of one claim or one decision, each with a label and a focus crop. No galleries, no decorative images, no repeats.\n- interpretation lists every place the ask had to become a concrete decision: added or narrowed scope, UX choices, defaults, migration behavior. decidedBy is bob whenever no human answer or ticket text made the call, including delegated choices; these are where results quietly diverge from requests.\n- yourCall holds only what a person must judge: taste, trade-offs, consequences for users, security or compatibility decisions, wording. Ask each as a question and say what Bob chose. Use 0-4 items; an empty list is right for mechanical changes. Never ask the reviewer to redo QA.\n- Group the inventory into 1-12 lines a person would check separately. Every active inventory requirement appears in requirements[].covers, or in hygiene[].covers for process criteria (generated files, branch continuity, changelog policy, tracker state). Every file in /progress/reviewScope/files appears in a requirement line or a beyondAsk item.\n- beyondAsk lists behavior and code no requirement asked for: refactors, shared code affecting other features, dependency, configuration and migration changes, behavior changes for existing users. Read the diff for changed defaults, removed fallbacks, widened permissions and new public endpoints. Use attention look when it can affect users or other code paths.\n- notVerified states up to 4 product-relevant evidence limits (real services replaced by fixtures, untested environments or devices). noticed lists pre-existing problems you saw but did not change.\n- Pipeline process (CI retries, PR selection, tracker synchronization, earlier rounds, reviewer tooling) is not review content; put anything a person must know into one hygiene line. The runtime shows PR, revision, CI and diff statistics.\n- No local absolute paths, commit SHAs, QA story or criterion IDs, receipt filenames or exit codes in prose. Repository-relative paths belong in files and proof file fields only.\n- Length follows the change: a few-file fix fits on one screen. Do not pad.\n- readiness is not-ready when any line is a gap or required QA failed or is blocked; ready-with-caveats when a yourCall item or a partly line needs attention; otherwise ready.\nAdd \"system\":{\"summary\":\"2-3 plain sentences on how the pieces work together, for a product owner\",\"flows\":[FLOW],\"touches\":[TOUCH],\"interfaces\":[]} ONLY when the change alters how components interact, what data is stored, or where the trust boundary sits. FLOW is {\"id\":\"kebab-id\",\"title\":\"plain name of what happens, e.g. Saving your format\",\"trigger\":\"plain: what starts it\",\"implements\":[\"requirement ids\"],\"participants\":[{\"id\":\"kebab-id\",\"icon\":\"one emoji\",\"label\":\"plain short name (<=40), e.g. Account page, Server, Database\",\"detail\":\"real component or module\"}],\"steps\":[{\"from\":\"participant id\",\"to\":\"participant id\",\"label\":\"one plain sentence of what happens (<=140)\",\"detail\":\"the real endpoint, event, query or call\",\"change\":\"new|changed\",\"dashed\":true,\"outcome\":\"good|bad\",\"code\":{\"file\":\"exact changed file\",\"match\":\"text copied verbatim from one added or removed line of that file's diff\"}}],\"before\":[steps for the same trigger before this PR, only when an existing flow changed],\"beforeNote\":\"plain: what went wrong or worked differently before (<=240)\",\"note\":\"optional\"}. TOUCH is {\"mark\":\"new|changed|removed|risk|same\",\"what\":\"plain (<=80)\",\"say\":\"what it means for people or other systems (<=200)\",\"tech\":\"optional real endpoint, field or setting\"}.\nFlows are sequence diagrams read top to bottom: one per real trigger, 2-5 participants, at most 8 steps, usually 1-3 flows including the main user action. Unmarked steps already worked this way; dashed marks steps outside the product's control; outcome bad marks where something is refused or went wrong. Give the steps a reviewer would want to see in code a code link. touches lists 2-8 places the change reaches the rest of the system: endpoints, stored data, dependencies, configuration, and behavior changes for existing users, marked risk. Leave interfaces empty. Never draw box-and-arrow maps.\nAfter a human review, add \"sinceLastReview\":{\"previousHeadSha\":\"the reviewed revision\",\"summary\":\"...\",\"changes\":[{\"what\":\"what changed in response\",\"files\":[\"...\"]}]} and keep the whole brief current. Do not modify product code, recapture screenshots, rerun implementation or merge.\nThen add \"story\": the show & tell a colleague gives in person, in about three minutes, without showing code. The reviewer sees it first; the brief fields above stay the checkable evidence behind it.\n\"story\":{\"title\":\"what you did, first person (<=110), e.g. I hardened the WAGO integration for production.\",\"summary\":\"the short version in one or two plain sentences (<=320)\",\"stats\":[{\"value\":\"e.g. 6 / 7\",\"label\":\"e.g. things you asked for, done\"}],\"slides\":[SLIDE]}\nSLIDE is exactly one of:\n{\"kind\":\"checklist\",\"title\":\"...\",\"say\":\"...\",\"items\":[{\"state\":\"done|partly|open\",\"label\":\"one thing that was asked (<=70)\",\"detail\":\"where it landed (<=140)\"}]}: the ask split into the separate things the person wanted, each with where it landed. Usually the first slide.\n{\"kind\":\"beforeAfter\",\"title\":\"...\",\"say\":\"...\",\"before\":[NODE],\"after\":[NODE],\"note\":\"optional\"}: the core behavior change as two short step-by-step pipelines of what happens. NODE is {\"label\":\"<=40\",\"detail\":\"optional <=60\",\"change\":\"new|changed (after only)\",\"fallout\":\"optional <=60: what happens when this step says no\"}. Name steps by what they do, never by class or function names. Use before:[{\"label\":\"Nothing\"}] for brand-new behavior.\n{\"kind\":\"chart\",\"title\":\"...\",\"say\":\"...\",\"method\":\"how it was measured (<=200)\",\"scale\":\"linear|log\",\"bars\":[{\"label\":\"<=60\",\"value\":positive number,\"display\":\"printed value, e.g. 7,200 or 3.3 s\",\"detail\":\"optional <=60\",\"mark\":\"good|bad|neutral\"}],\"stats\":[STAT]}: measured numbers from executed receipts only, such as load, timings, sizes or counts. Use log when values span more than 100x.\n{\"kind\":\"screens\",\"title\":\"...\",\"say\":\"...\",\"shots\":[{\"area\":\"exact capture area\",\"state\":\"exact capture state\",\"label\":\"what to look at\",\"focus\":{\"x\":0,\"y\":0,\"w\":100,\"h\":100}}]}: one or two accepted screenshots that show the result.\n{\"kind\":\"video\",\"title\":\"...\",\"say\":\"...\",\"taskId\":\"...\",\"sha256\":\"...\",\"label\":\"...\"}: an accepted video, only when motion or sequence is the point.\n{\"kind\":\"points\",\"title\":\"...\",\"say\":\"...\",\"items\":[{\"icon\":\"one emoji\",\"title\":\"<=70\",\"detail\":\"optional <=160\"}]}: a few notable things that fit no other slide.\nStory rules:\n- Speak as Bob to the reviewer, first person, the way you would explain it at their desk: short sentences, everyday words, one idea per slide. title is the point of the slide (<=90); say is what you would add out loud (<=240). No code, file paths, class or function names, IDs or jargon a product owner would not use; when the reviewer must know a technical term, say what it means.\n- 2-6 slides in this order: what was asked and where each part landed, what changed (core behavior first), how we know it works, then anything else worth seeing. A small fix can be one beforeAfter slide and one proof slide.\n- Never repeat yourCall, notVerified or beyondAsk in slides: the reader presents them as their own slides after yours and ends with the decision. Because they appear in the show & tell, write them in the same plain voice: say what changes for people and what is at stake, not internal mechanics.\n- Be concrete: put the actual limits, counts and timings that changed into slide details (e.g. \"at most 8 KB\", \"26 ms\"), not \"checks vary\".\n- Every story screenshot sets focus to the pixels that matter (open the image to choose it), so it stays readable on a phone; prefer a pair that differs only in the condition shown.\n- A chart compares 2-8 different stages, conditions or cases measured the same way, so the bars differ meaningfully. Never chart a total against itself or offered against confirmed; headline totals belong in stats.\n- Translate technical terms into what a person experiences: \"names longer than 128 characters or containing / or #\" rather than \"identifiers over 128 code units or containing MQTT wildcards\"; \"a generic error that does not say which version failed\" rather than \"revision 0 and an empty hash\".\n- Every number, screenshot and claim comes from the evidence above; the story may simplify wording, never facts. stats holds 0-3 headline numbers a person remembers.\nThen add \"tour\": the code walkthrough under \"Dig deeper\", like a colleague scrolling through the diff with you. \"tour\":[{\"file\":\"exact changed file\",\"say\":\"one plain sentence: what this file now does or what changed in it (<=200)\",\"key\":true,\"flag\":\"optional short reason to look (<=40), e.g. Changes sign-out everywhere\",\"pins\":[{\"match\":\"text copied verbatim from one added or removed line of this file's diff\",\"say\":\"plain note shown under that line (<=200)\",\"flag\":true}],\"related\":[\"tests, translations and small wiring that only serve this file\"],\"same\":[\"files with the same mechanical change\"]}]\nTour rules:\n- Order entries the way you would show them: the core rule or data first, then server, then screens, then wiring. key marks the 3-8 files that carry the change; they start open.\n- Every file in /progress/reviewScope/files appears exactly once in the tour: as file, in related or in same. Put each test under the file it tests and group repeated mechanical edits with same.\n- pins point at the 0-3 lines per file a reviewer must not miss: guards, defaults, removed behavior, security decisions. match is unique text from a single + or - line of the actual diff. flag what changes behavior for existing users or belongs to a yourCall or beyondAsk item worth a look.\n- Write say in the story's plain voice: what it does for people, no class or function names unless the reviewer must know them.\nWrite the evidence plainly too, as Dig deeper shows it:\n- requirements[].text is the outcome in plain words, and requirements[].how says in one plain sentence how it was checked (<=160), e.g. \"Clicked through the German account page and compared the preview\".\n- Every table proof row adds \"plain\":{\"tried\":\"what was done (<=140)\",\"saw\":\"what happened, keeping the key values (<=200)\"}; cells keep the exact recorded values.\n- interpretation chosen and alternatives use words a product owner would use; note says why when it is not obvious. Keep at most 10 interpretation entries (the most consequential) and every hygiene text within 200 characters.{{instruction:video-brief}}{{instruction:impact-guide}}",
              "json": true,
              "askQuestions": false
            },
            {
              "id": "handoff",
              "configVersion": "step-config-v1",
              "reads": {
                "draftPr": "draft-pr",
                "ci": "ci",
                "guide": "guide",
                "reviewGate": "review-gate",
                "handoff": "handoff",
                "merge": "merge",
                "qaReview": "visual-review",
                "capture": "capture",
                "scope": "visual-scope",
                "qaGate": "visual-gate",
                "implementation": "implement",
                "scopeClarify": "clarify",
                "scopeDecisions": "decisions",
                "impact": "assess-impact",
                "scopePlan": "plan",
                "scopeSource": "@source",
                "scopeTicket": "@ticket"
              },
              "rules": [],
              "checks": [
                "qa-evidence",
                {
                  "check": "media-valid",
                  "adapter": "qa-gate",
                  "video": true
                },
                "impact-boundary",
                {
                  "check": "scope-inputs",
                  "sources": {
                    "clarify": "scopeClarify",
                    "decisions": "scopeDecisions",
                    "plan": "scopePlan",
                    "existing-work": "scopeExistingWork",
                    "assess-existing": "scopeAssessment",
                    "source": "scopeSource",
                    "ticket": "scopeTicket"
                  }
                }
              ],
              "access": {
                "mode": "workspace"
              },
              "instructions": [],
              "name": "Verify revision and hand off",
              "next": "human-review",
              "branches": [
                {
                  "when": {
                    "path": "impactRequired",
                    "equals": true
                  },
                  "next": "assess-impact"
                },
                {
                  "when": {
                    "path": "fix",
                    "equals": true
                  },
                  "next": "ci-fix"
                }
              ],
              "maxVisits": 200,
              "type": "tool",
              "tool": "handoff",
              "args": []
            },
            {
              "id": "human-review",
              "configVersion": "step-config-v1",
              "reads": {
                "draftPr": "draft-pr",
                "ci": "ci",
                "guide": "guide",
                "reviewGate": "review-gate",
                "handoff": "handoff",
                "merge": "merge",
                "qaReview": "visual-review",
                "capture": "capture",
                "scope": "visual-scope",
                "qaGate": "visual-gate",
                "implementation": "implement",
                "impact": "assess-impact",
                "scopeClarify": "clarify",
                "scopeDecisions": "decisions",
                "scopePlan": "plan",
                "scopeSource": "@source",
                "scopeTicket": "@ticket"
              },
              "rules": [],
              "checks": [
                "impact-boundary",
                {
                  "check": "scope-inputs",
                  "sources": {
                    "clarify": "scopeClarify",
                    "decisions": "scopeDecisions",
                    "plan": "scopePlan",
                    "existing-work": "scopeExistingWork",
                    "assess-existing": "scopeAssessment",
                    "source": "scopeSource",
                    "ticket": "scopeTicket"
                  }
                }
              ],
              "access": {
                "mode": "workspace"
              },
              "instructions": [],
              "name": "Human review",
              "next": "merge",
              "branches": [
                {
                  "when": {
                    "path": "decision",
                    "equals": "reject"
                  },
                  "next": "delivery-feedback-route"
                },
                {
                  "when": {
                    "path": "rework",
                    "equals": true
                  },
                  "next": "assess-impact"
                }
              ],
              "maxVisits": 200,
              "type": "tool",
              "tool": "human-review",
              "args": []
            },
            {
              "id": "human-fix",
              "configVersion": "step-config-v1",
              "reads": {
                "publication": "draft-pr",
                "scopeClarify": "clarify",
                "scopeDecisions": "decisions",
                "scopePlan": "plan",
                "scopeSource": "@source",
                "scopeTicket": "@ticket"
              },
              "output": {
                "format": "json-v1"
              },
              "rules": [],
              "checks": [
                "architecture-revision",
                {
                  "check": "scope-inputs",
                  "sources": {
                    "clarify": "scopeClarify",
                    "decisions": "scopeDecisions",
                    "plan": "scopePlan",
                    "existing-work": "scopeExistingWork",
                    "assess-existing": "scopeAssessment",
                    "source": "scopeSource",
                    "ticket": "scopeTicket"
                  }
                }
              ],
              "access": {
                "mode": "push"
              },
              "instructions": [],
              "name": "Address human feedback",
              "next": "assess-impact",
              "branches": [],
              "maxVisits": 16,
              "type": "agent",
              "prompt": "Address the latest human rejection/follow-up instructions in humanDecisions and human-review, preserving the accepted plan, decisions and all past review findings. Commit and push to the existing PR. Return {\"summary\":\"what changed\",\"checks\":[\"commands and outcomes\"]}. Do not merge, mark ready or assume approval.",
              "json": true,
              "askQuestions": false
            },
            {
              "id": "merge",
              "configVersion": "step-config-v1",
              "reads": {
                "draftPr": "draft-pr",
                "ci": "ci",
                "guide": "guide",
                "reviewGate": "review-gate",
                "handoff": "handoff",
                "merge": "merge",
                "qaReview": "visual-review",
                "capture": "capture",
                "scope": "visual-scope",
                "qaGate": "visual-gate",
                "implementation": "implement",
                "impact": "assess-impact",
                "scopeClarify": "clarify",
                "scopeDecisions": "decisions",
                "scopePlan": "plan",
                "scopeSource": "@source",
                "scopeTicket": "@ticket"
              },
              "rules": [],
              "checks": [
                "impact-boundary",
                {
                  "check": "scope-inputs",
                  "sources": {
                    "clarify": "scopeClarify",
                    "decisions": "scopeDecisions",
                    "plan": "scopePlan",
                    "existing-work": "scopeExistingWork",
                    "assess-existing": "scopeAssessment",
                    "source": "scopeSource",
                    "ticket": "scopeTicket"
                  }
                }
              ],
              "access": {
                "mode": "workspace"
              },
              "instructions": [],
              "name": "Merge approved revision",
              "next": "end",
              "branches": [
                {
                  "when": {
                    "path": "rework",
                    "equals": true
                  },
                  "next": "assess-impact"
                },
                {
                  "when": {
                    "path": "fix",
                    "equals": true
                  },
                  "next": "ci-fix"
                },
                {
                  "when": {
                    "path": "externalPending",
                    "equals": true
                  },
                  "next": "external-final"
                }
              ],
              "maxVisits": 200,
              "type": "tool",
              "tool": "merge",
              "args": []
            },
            {
              "id": "delivery-feedback-route",
              "configVersion": "step-config-v1",
              "reads": {
                "review": "plan-review",
                "clarify": "clarify",
                "planReview": "plan-review",
                "plan": "plan",
                "scopeClarify": "clarify",
                "scopeDecisions": "decisions",
                "scopePlan": "plan",
                "scopeSource": "@source",
                "scopeTicket": "@ticket",
                "draftPr": "draft-pr",
                "ci": "ci",
                "guide": "guide",
                "reviewGate": "review-gate",
                "handoff": "handoff",
                "merge": "merge"
              },
              "rules": [],
              "checks": [
                {
                  "check": "scope-inputs",
                  "sources": {
                    "clarify": "scopeClarify",
                    "decisions": "scopeDecisions",
                    "plan": "scopePlan",
                    "existing-work": "scopeExistingWork",
                    "assess-existing": "scopeAssessment",
                    "source": "scopeSource",
                    "ticket": "scopeTicket"
                  }
                },
                "delivery-evidence"
              ],
              "access": {
                "mode": "workspace"
              },
              "instructions": [],
              "name": "Route requested delivery corrections",
              "next": "human-fix",
              "branches": [
                {
                  "when": {
                    "path": "mode",
                    "equals": "mixed"
                  },
                  "next": "external-correction"
                }
              ],
              "maxVisits": 200,
              "type": "check",
              "check": {
                "results": {
                  "mode": {
                    "select": "/evidence/delivery-evidence/mode"
                  },
                  "repositoryComplete": {
                    "path": "/evidence/delivery-evidence/repositoryComplete",
                    "equals": true
                  }
                },
                "passed": {
                  "path": "/evidence/delivery-evidence/mode",
                  "exists": true
                }
              }
            },
            {
              "id": "delivery-route-accept",
              "configVersion": "step-config-v1",
              "reads": {
                "review": "plan-review",
                "clarify": "clarify",
                "planReview": "plan-review",
                "plan": "plan",
                "scopeClarify": "clarify",
                "scopeDecisions": "decisions",
                "scopePlan": "plan",
                "scopeSource": "@source",
                "scopeTicket": "@ticket",
                "draftPr": "draft-pr",
                "ci": "ci",
                "guide": "guide",
                "reviewGate": "review-gate",
                "handoff": "handoff",
                "merge": "merge"
              },
              "rules": [],
              "checks": [
                {
                  "check": "scope-inputs",
                  "sources": {
                    "clarify": "scopeClarify",
                    "decisions": "scopeDecisions",
                    "plan": "scopePlan",
                    "existing-work": "scopeExistingWork",
                    "assess-existing": "scopeAssessment",
                    "source": "scopeSource",
                    "ticket": "scopeTicket"
                  }
                }
              ],
              "access": {
                "mode": "workspace"
              },
              "instructions": [],
              "name": "Accept reviewed delivery contract",
              "next": "delivery-route",
              "branches": [],
              "maxVisits": 200,
              "type": "tool",
              "tool": "accept-delivery",
              "args": []
            },
            {
              "id": "delivery-route",
              "configVersion": "step-config-v1",
              "reads": {
                "review": "plan-review",
                "clarify": "clarify",
                "planReview": "plan-review",
                "plan": "plan",
                "scopeClarify": "clarify",
                "scopeDecisions": "decisions",
                "scopePlan": "plan",
                "scopeSource": "@source",
                "scopeTicket": "@ticket",
                "draftPr": "draft-pr",
                "ci": "ci",
                "guide": "guide",
                "reviewGate": "review-gate",
                "handoff": "handoff",
                "merge": "merge",
                "accepted": "delivery-route-accept"
              },
              "rules": [],
              "checks": [
                {
                  "check": "scope-inputs",
                  "sources": {
                    "clarify": "scopeClarify",
                    "decisions": "scopeDecisions",
                    "plan": "scopePlan",
                    "existing-work": "scopeExistingWork",
                    "assess-existing": "scopeAssessment",
                    "source": "scopeSource",
                    "ticket": "scopeTicket"
                  }
                }
              ],
              "access": {
                "mode": "workspace"
              },
              "instructions": [],
              "name": "Validate accepted delivery contract",
              "next": "architecture",
              "branches": [
                {
                  "when": {
                    "path": "deferred",
                    "equals": true
                  },
                  "next": "delivery-deferred"
                },
                {
                  "when": {
                    "path": "mode",
                    "equals": "external"
                  },
                  "next": "external-apply"
                },
                {
                  "when": {
                    "path": "mode",
                    "equals": "mixed"
                  },
                  "next": "external-apply"
                }
              ],
              "maxVisits": 200,
              "type": "check",
              "check": {
                "results": {
                  "deferred": {
                    "path": "/inputs/accepted/deferred",
                    "equals": true
                  },
                  "mode": {
                    "select": "/inputs/accepted/mode"
                  }
                },
                "passed": {
                  "path": "/results/deferred",
                  "equals": false
                }
              }
            },
            {
              "id": "delivery-deferred",
              "configVersion": "step-config-v1",
              "reads": {
                "scopeClarify": "clarify",
                "scopeDecisions": "decisions",
                "scopePlan": "plan",
                "scopeSource": "@source",
                "scopeTicket": "@ticket"
              },
              "output": {
                "format": "json-v1"
              },
              "rules": [],
              "checks": [
                "architecture-revision",
                {
                  "check": "scope-inputs",
                  "sources": {
                    "clarify": "scopeClarify",
                    "decisions": "scopeDecisions",
                    "plan": "scopePlan",
