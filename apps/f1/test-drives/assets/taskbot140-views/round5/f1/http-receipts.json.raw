                        {
                          "any": [
                            {
                              "not": {
                                "any": [
                                  {
                                    "any": [
                                      {
                                        "some": "/feedback",
                                        "require": {
                                          "all": [
                                            {
                                              "path": "/kind",
                                              "in": [
                                                "threads",
                                                "reviews",
                                                "revision"
                                              ]
                                            },
                                            {
                                              "any": [
                                                {
                                                  "not": {
                                                    "path": "/action",
                                                    "exists": true
                                                  }
                                                },
