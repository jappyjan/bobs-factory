                                              "any": [
                                                {
                                                  "not": {
                                                    "path": "/fixReviewRequired",
                                                    "equals": false
                                                  }
                                                },
                                                {
                                                  "path": "/currentFix",
                                                  "equals": true
                                                }
                                              ]
                                            }
                                          ]
                                        }
                                      },
                                      {
                                        "all": [
                                          {
                                            "some": "/feedback",
                                            "require": {
                                              "path": "/kind",
                                              "equals": "comments"
                                            }
                                          },
                                          {
                                            "not": {
                                              "path": "/fix/reviewRequired",
                                              "equals": false
                                            }
                                          }
                                        ]
                                      }
                                    ]
                                  },
                                  {
                                    "path": "/fix/reviewRequired",
                                    "equals": true
                                  },
                                  {
                                    "path": "/reviewed",
                                    "equals": null
                                  },
                                  {
                                    "path": "/reviewed/dirty",
                                    "equals": true
                                  },
                                  {
                                    "path": "/dirty",
                                    "equals": true
                                  },
                                  {
                                    "not": {
                                      "path": "/reviewed/headSha",
                                      "equalsPath": "/headSha"
                                    }
                                  },
                                  {
                                    "not": {
                                      "path": "/readiness/headSha",
                                      "equalsPath": "/headSha"
                                    }
                                  },
                                  {
                                    "path": "/previousBase",
                                    "equals": null
                                  },
                                  {
                                    "not": {
