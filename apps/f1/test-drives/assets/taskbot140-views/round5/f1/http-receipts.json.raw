                        {
                          "path": "/previous/headSha",
                          "equalsPath": "/headSha"
                        },
                        {
                          "path": "/previous/baseSha",
                          "equalsPath": "/readiness/baseSha"
                        },
                        {
                          "not": {
                            "path": "/fingerprint",
                            "equals": null
                          }
                        },
                        {
                          "path": "/fingerprint",
