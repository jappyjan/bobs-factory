		join(directory, "failure.json"),
		JSON.stringify(
			{
				head,
				error: String(error),
				stack: error.stack,
				wire,
				turns,
				requests,
				runs: [...(runtime?.runs.values() ?? [])].map(
					({ id, status, error }) => ({ id, status, error }),
				),
			},
			null,
			2,
		),
	);
	throw error;
} finally {
	for (const value of gates.values()) value.release();
	for (const lease of leases) await lease.release();
	await worker?.stop();
	await new Promise((resolve) => server.close(resolve));
}
