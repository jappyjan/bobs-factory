// F1_AGENT_MODE=mock node apps/f1/test-drives/assets/taskbot140-dispatch-round6.mjs
// Actual EdgeWorker/manual API -> Taskbot adapter -> configured HTTPS MCP.
// Only synthetic TLS, local Git, controlled agents and loopback transports.
import assert from "node:assert/strict";
import { execFileSync, spawnSync } from "node:child_process";
import { createHash, randomUUID } from "node:crypto";
import {
	mkdirSync,
	mkdtempSync,
	readFileSync,
	realpathSync,
	writeFileSync,
} from "node:fs";
import { createServer as createHttpsServer } from "node:https";
import { createServer } from "node:net";
import { tmpdir } from "node:os";
import { join, resolve } from "node:path";

assert.equal(process.env.F1_AGENT_MODE, "mock");
assert.match(process.version, /^v24\./);
const root = resolve(import.meta.dirname, "../../../..");
if (!process.env.F1_DISPATCH_CHILD) {
	const directory = realpathSync(
		mkdtempSync(join(tmpdir(), "f1-taskbot140-dispatch-round6-")),
	);
	writeFileSync(
		join(directory, "executed-driver.mjs"),
		readFileSync(import.meta.filename),
	);
	const cert = join(directory, "synthetic-cert.pem"),
		key = join(directory, "synthetic-key.pem");
	execFileSync(
		"openssl",
		[
			"req",
			"-x509",
			"-newkey",
			"rsa:2048",
			"-nodes",
			"-keyout",
			key,
			"-out",
			cert,
			"-days",
			"1",
			"-subj",
			"/CN=localhost",
			"-addext",
			"subjectAltName=DNS:localhost,IP:127.0.0.1",
		],
		{ stdio: "ignore" },
	);
	const child = spawnSync(process.execPath, [import.meta.filename], {
		cwd: root,
		env: {
			...process.env,
			F1_DISPATCH_CHILD: directory,
			NODE_EXTRA_CA_CERTS: cert,
			HOME: join(directory, "synthetic-home"),
			XDG_CONFIG_HOME: join(directory, "synthetic-config"),
			XDG_DATA_HOME: join(directory, "synthetic-data"),
			CODEX_HOME: join(directory, "synthetic-codex"),
		},
		encoding: "utf8",
		maxBuffer: 10 * 1024 * 1024,
	});
	writeFileSync(join(directory, "stdout.log"), child.stdout ?? "");
	writeFileSync(join(directory, "stderr.log"), child.stderr ?? "");
	if (child.status !== 0) {
		console.error(child.stderr, child.stdout);
		throw new Error(
			`Dispatch F1 failed (${child.status}); originals ${directory}`,
		);
	}
	const summary = child.stdout
		.split("\n")
		.findLast(
			(line) => line.startsWith("{") && line.includes('"result":"PASS"'),
		);
	assert(summary, "Child must publish its actual PASS receipt");
	console.log(summary);
	process.exit(0);
}
const directory = process.env.F1_DISPATCH_CHILD;
const { EdgeWorker } = await import(
	"../../../../packages/edge-worker/dist/EdgeWorker.js"
);
const { defaultWorkflows } = await import(
	"../../../../packages/edge-worker/dist/factory/defaultWorkflows.js"
);
const { createCLIIssueTracker } = await import(
	"../../../../packages/core/dist/index.js"
);
const { loadFactoryContextSnapshot } = await import(
	"../../../../packages/mcp-tools/dist/index.js"
);
const { f1AgentHandlers } = await import("../../dist/src/MockAgentRunner.js");
const git = (...args) =>
	execFileSync("git", args, { cwd: root, encoding: "utf8" }).trim();
const head = git("rev-parse", "HEAD");
if (process.env.F1_EXPECTED_SOURCE_COMMIT) {
	assert.equal(head, process.env.F1_EXPECTED_SOURCE_COMMIT);
	assert.equal(git("status", "--short"), "");
}
const gates = new Map();
function gate(key) {
	if (!gates.has(key)) {
		let release;
		const promise = new Promise((resolve) => {
			release = resolve;
		});
		gates.set(key, { promise, release });
	}
	return gates.get(key);
}
async function until(check, label) {
	const deadline = Date.now() + 15000;
	while (!(await check())) {
		if (Date.now() > deadline) throw new Error(`Timed out: ${label}`);
		await new Promise((resolve) => setTimeout(resolve, 10));
	}
}
async function port() {
	const server = createServer();
	await new Promise((r) => server.listen(0, "127.0.0.1", r));
	const port = server.address().port;
	await new Promise((r) => server.close(r));
	return port;
}
const leases = [];
const wire = [],
	turns = [],
	requests = [],
	results = [];
let ambiguousMode, heldResponse, pingId;
const protocolFrames=[];
let initializeCount = 0,
	holdInitializeAt = 0;
let ticket = {
	id: 1,
	project: "synthetic",
	status: "in_progress",
	body: "Synthetic task scope",
	comments: [],
	attachments: [],
};
const server = createHttpsServer(
	{
		cert: readFileSync(join(directory, "synthetic-cert.pem")),
		key: readFileSync(join(directory, "synthetic-key.pem")),
	},
	async (request, response) => {
		if (request.method !== "POST") {
			response.writeHead(405).end();
			return;
		}
		let raw = "";
		for await (const chunk of request) raw += chunk;
		const message = JSON.parse(raw);
  if(message.id===pingId && !message.method){
   protocolFrames.push({at:Date.now(),message});response.writeHead(202).end();
   heldResponse?.destroy();return;
  }
		if (message.method === "notifications/initialized") {
			response.writeHead(202).end();
			return;
		}
		let result;
		if (message.method === "initialize") {
			initializeCount++;
			if (initializeCount === holdInitializeAt) {
				gate("initialize-entered").release();
				await gate("initialize-release").promise;
			}
			result = {
				protocolVersion: message.params.protocolVersion,
				capabilities: { tools: {} },
				serverInfo: { name: "synthetic-taskbot", version: "1" },
			};
		} else if (message.method === "tools/call") {
			const { name, arguments: args } = message.params;
			wire.push({ at: Date.now(), name, args });
			if (name === "get_ticket")
				result = { content: [{ type: "text", text: JSON.stringify(ticket) }] };
			else if (name === "comment") {
				ticket.comments.push({ body: args.body });
    if(ambiguousMode && args.body.includes('Question: Synthetic original ambiguous Ask')){
     const mode=ambiguousMode;ambiguousMode=undefined;
     gate('mutation-entered:'+mode).release();
     await gate('mutation-release:'+mode).promise;
     if(mode==='protocol'){
      heldResponse=response;pingId=message.id;
      response.writeHead(200,{'Content-Type':'text/event-stream'});
      response.write(`event: message\ndata: ${JSON.stringify({jsonrpc:'2.0',id:pingId,method:'ping'})}\n\n`);
     }else response.destroy();
     return;
    }
				result = { content: [] };
			} else if (name === "set_status") {
				ticket.status = args.to;
				result = { content: [] };
			} else throw new Error(`Unexpected tool ${name}`);
		} else throw new Error(`Unexpected protocol ${message.method}`);
		response.writeHead(200, { "Content-Type": "application/json" });
		response.end(JSON.stringify({ jsonrpc: "2.0", id: message.id, result }));
	},
);
await new Promise((r) => server.listen(0, "127.0.0.1", r));
const source = `https://localhost:${server.address().port}`;
const home = join(directory, "home"),
	repository = join(directory, "repo");
mkdirSync(home);
mkdirSync(repository);
const repoGit = (...args) =>
	execFileSync("git", args, { cwd: repository, encoding: "utf8" }).trim();
repoGit("init", "-b", "main");
repoGit("config", "user.name", "Synthetic F1");
repoGit("config", "user.email", "synthetic@example.invalid");
writeFileSync(join(repository, "README.md"), "Synthetic local fixture\n");
writeFileSync(
	join(repository, ".gitignore"),
	".claude/\n.codex/\n.cursor/\n.opencode/\nAGENTS.md\nCLAUDE.md\n",
);
repoGit("add", ".");
repoGit("commit", "-qm", "Synthetic fixture");
const origin = join(directory, "origin.git");
execFileSync("git", ["init", "--bare", origin], { stdio: "ignore" });
repoGit("remote", "add", "origin", origin);
repoGit("push", "-qu", "origin", "main");
const mcp = join(directory, "mcp.json");
writeFileSync(
	mcp,
	JSON.stringify({
		mcpServers: { taskbot: { type: "http", url: `${source}/mcp` } },
	}),
);
const rpcPort = await port();
process.env.BOBS_FACTORY_FACTORY_PORT = String(await port());
process.env.BOBS_FACTORY_DISABLE_REMOTE_SESSION_STORE = "1";
process.env.BOBS_FACTORY_MIGRATION_SOURCE_CAPACITY_DIRECTORY = join(
	directory,
	"unused-migration",
);
const apiOrigin = `http://127.0.0.1:${process.env.BOBS_FACTORY_FACTORY_PORT}`;
const tracker = createCLIIssueTracker();
let worker,
	runtime,
	generation = 0;
const definitions = [
	{
		id: "dispatch-child",
		name: "Controlled child",
		stepConfigVersion: "step-config-v1",
		allowedTriggers: ["workflow"],
		steps: [
			{
				id: "controlled",
				name: "Child",
				type: "agent",
				prompt: "Controlled local child",
			},
		],
	},
	{
		id: "dispatch-view",
		name: "Current outgoing view",
		stepConfigVersion: "step-config-v1",
		steps: [
			{
				id: "launch",
				name: "Launch",
				type: "launch-runs",
				launchRuns: {
					items: { values: [{ id: "a", title: "Child", prompt: "Synthetic" }] },
					workflow: "dispatch-child",
					wait: false,
					inputMapping: { prompt: "/prompt" },
				},
			},
			{
				id: "choose",
				name: "Decide",
				type: "decide",
				reads: { children: "@childRuns" },
				view: {
					version: "view-v1",
					components: [
						{
							id: "children",
							type: "runList",
							data: { path: "/inputs/children" },
						},
					],
				},
				decide: {
					items: { literal: [{ id: "a", title: "Item" }] },
					actions: [{ id: "skip", label: "Skip" }],
					ask: { prompt: "Only bounded context" },
				},
			},
		],
	},
];
function newWorker() {
	generation++;
	worker = new EdgeWorker({
		factoryHome: home,
		platform: "cli",
		serverPort: rpcPort,
		defaultRunner: "claude",
		maxConcurrentSessions: 4,
		issueTrackerFactory: () => tracker,
		repositories: [
			{
				id: "fixture",
				name: "Synthetic",
				repositoryPath: repository,
				workspaceBaseDir: join(directory, "worktrees"),
				baseBranch: "main",
				isActive: true,
				linearWorkspaceId: "cli-workspace",
				mcpConfigPath: mcp,
				allowedTools: ["mcp__taskbot__*"],
			},
		],
		handlers: {
			createAgentRunner: (type, config) => {
				const contextConfig = config.mcpConfig?.["factory-context"];
				if (!contextConfig)
					return f1AgentHandlers(
						"mock",
						JSON.stringify({ title: "Synthetic" }),
					).createAgentRunner(type, config);
				const _context = loadFactoryContextSnapshot(contextConfig.args.at(-1));
				const assistance = config.toolProfile === "context-only";
				const owner = [...runtime.runs.values()].find((r) =>
					assistance
						? config.workingDirectory.startsWith(
								`${join(home, "factory", "assistance", r.id)}/`,
							)
						: r.workspace === config.workingDirectory,
				);
				assert(owner);
				turns.push({
					runId: owner.id,
					runner: type,
					profile: config.toolProfile,
					nativeResume: config.resumeSessionId,
					model: config.model,
				});
				const wait = gate((assistance ? "ask:" : "child:") + owner.id);
				const original = config.onMessage;
				config.onMessage = async (message) => {
					await original?.(message);
					if (message.type === "system" && message.subtype === "init") {
						gate(`entered:${owner.id}`).release();
						await wait.promise;
					}
				};
				const runner = f1AgentHandlers(
					"mock",
					assistance
						? "Historical bounded Ask answer"
						: JSON.stringify({ done: true }),
				).createAgentRunner(type, config);
				const stop = runner.stop.bind(runner);
				runner.stop = () => {
					wait.release();
					stop();
				};
				return runner;
			},
		},
	});
	runtime = worker.getFactoryRuntime();
}
async function api(path, body, expected = 200) {
	const response = await fetch(apiOrigin + path, {
		method: body === undefined ? "GET" : "POST",
		headers: {
			"Content-Type": "application/json",
			"X-Factory-Request": "1",
			Origin: apiOrigin,
			"Sec-Fetch-Site": "same-origin",
		},
		...(body === undefined ? {} : { body: JSON.stringify(body) }),
	});
	const result = await response.json();
	requests.push({ path, body, status: response.status, result });
	assert.equal(response.status, expected, JSON.stringify(result));
	return result;
}
const answer = (run) => ({
	batchId: run.viewDecision.id,
	digest: run.viewDecision.digest,
	accepted: true,
	choices: [{ itemId: "a", action: "skip" }],
});
try {
	newWorker();
	runtime.updateWorkflows(
		[...defaultWorkflows, ...definitions],
		"dispatch-view",
	);
	await worker.start();
	for (const boundary of ["initialize", "admission"]) {
		ticket = { ...ticket, comments: [] };
		const launched = await api(
			"/api/runs",
			{
				workflow: "dispatch-view",
				repositoryId: "fixture",
				runner: "claude",
				prompt: "Synthetic outgoing dispatch",
				source: `${source}/p/synthetic/t/1`,
			},
			202,
		);
		const run = runtime.get(launched.id);
		const childId = () =>
			Object.values(run.launchActions)[0].accepted.items[0].runId;
		await until(
			() =>
				run.status === "waiting" &&
				run.viewDecision &&
				Object.keys(run.launchActions).length > 0,
			"saved Decide wait",
		);
		await gate(`entered:${childId()}`).promise;
		await until(
			() =>
				ticket.comments.some((comment) =>
					comment.body.includes(run.viewDecision.digest),
				),
			"initial unchanged current comment",
		);
		await worker.getTicketTracking().flush(run);
		await worker.getTicketTracking().flush(runtime.get(childId()));
		const initial = structuredClone(ticket.comments);
		let blocker;
		if (boundary === "admission") {
			await worker.runnerSlots.setLimit(2);
			blocker = await worker.runnerSlots.acquireLease();
			leases.push(blocker);
			await worker.runnerSlots.setLimit(1);
		}
		if (boundary === "initialize") holdInitializeAt = initializeCount + 3;
		await api(`/api/runs/${run.id}/view-ask`, {
			batchId: run.viewDecision.id,
			digest: run.viewDecision.digest,
			itemId: "a",
			question: "Synthetic held Ask",
			requestId: randomUUID(),
		});
		if (boundary === "initialize") await gate(`entered:${run.id}`).promise;
		if (boundary === "initialize") await gate("initialize-entered").promise;
		else {
			await until(
				async () => (await worker.runnerSlots.snapshot()).queued > 0,
				"actual MCP capacity admission",
			);
		}
		const pending = structuredClone(run.viewDecision);
		gate(`child:${childId()}`).release();
		await until(
			() =>
				Object.values(run.launchActions)[0].progress.a.status === "completed",
			"real child source completion",
		);
		const completedAt = Date.now();
		assert.equal(run.viewDecision.digest, pending.digest);
		if (boundary === "initialize") gate("initialize-release").release();
		else {
			await blocker.release();
			await worker.runnerSlots.setLimit(4);
			await gate(`entered:${run.id}`).promise;
		}
		await until(
			() =>
				ticket.comments.some(
					(comment) =>
						comment.body.includes("[completed]") &&
						comment.body.includes(run.viewDecision.digest),
				),
			"renewed outgoing current protocol",
		);
		assert(
			ticket.comments.every(
				(comment) => !comment.body.includes(pending.digest),
			),
		);
		assert(
			wire
				.filter((call) => call.name === "comment")
				.every((call) => !call.args.body.includes(pending.digest)),
		);
		for (const comment of initial)
			assert(ticket.comments.some((c) => c.body === comment.body));
		const obsolete = run.ticketSync.receipts.find(
			(receipt) => receipt.viewDecision?.digest === pending.digest,
		);
		assert(obsolete.superseded);
		assert.notEqual(obsolete.delivered, true);
		await api(
			`/api/runs/${run.id}/view-answer`,
			{ ...answer(run), batchId: pending.id, digest: pending.digest },
			409,
		);
		gate(`ask:${run.id}`).release();
		await runtime.flush(run.id);
		const current = structuredClone(run.viewDecision),
			count = ticket.comments.filter((comment) =>
				comment.body.includes("Decision batch:"),
			).length;
		await worker.stop();
		newWorker();
		await worker.start();
		const restored = runtime.get(run.id);
		await until(
			() => restored.status === "waiting",
			"persisted reconstruction",
		);
		assert.equal(restored.viewDecision.id, current.id);
		assert.equal(restored.viewDecision.digest, current.digest);
		await worker.getTicketTracking().flush(restored);
		assert.equal(
			ticket.comments.filter((comment) =>
				comment.body.includes("Decision batch:"),
			).length,
			count,
			"Reconstruction does not duplicate any decision display; unrelated child lifecycle comments may settle separately",
		);
		await api(`/api/runs/${run.id}/view-answer`, answer(restored));
		await until(
			() => restored.status === "completed",
			"renewed exact protocol accepted",
		);
		results.push({
			boundary,
			runId: run.id,
			pending,
			renewed: current,
			completedAt,
			obsolete,
			comments: structuredClone(ticket.comments),
			accepted: restored.viewRecords.find(
				(record) => record.snapshot.id === current.id,
			).answer,
		});
	}

 for(const mode of ['protocol','original']){
  ticket={...ticket,comments:[]};
  const launched=await api('/api/runs',{workflow:'dispatch-view',repositoryId:'fixture',runner:'claude',prompt:'Original ambiguous mutation',source:`${source}/p/synthetic/t/1`},202);
  const run=runtime.get(launched.id);
