import assert from 'node:assert/strict';
import {createHash} from 'node:crypto';
import {readFileSync,readdirSync,writeFileSync} from 'node:fs';
import {join} from 'node:path';
import {execFileSync} from 'node:child_process';
const root=process.cwd(),sha=x=>createHash('sha256').update(x).digest('hex');
const logs=readFileSync('/tmp/taskbot140-round6-complete-validation/f1.log','utf8').split('\n');
const f1=JSON.parse(logs.findLast(x=>x.startsWith('{')&&x.includes('"result":"PASS"')));
const hash=createHash('sha256');
for(const name of ['core','mcp-tools','edge-worker','codex-runner']){
 const dist=join(root,'packages',name,'dist');
 for(const file of readdirSync(dist,{recursive:true}).filter(x=>x.endsWith('.js')).sort())hash.update(`${name}/${file}\0`).update(readFileSync(join(dist,file))).update('\0');
}
hash.update('apps/f1/dist/src/MockAgentRunner.js\0').update(readFileSync('apps/f1/dist/src/MockAgentRunner.js')).update('\0');
for(const file of readdirSync('apps/cli/dist/src/tui',{recursive:true}).filter(x=>x.endsWith('.js')).sort())hash.update(`apps/cli/dist/src/tui/${file}\0`).update(readFileSync(join('apps/cli/dist/src/tui',file))).update('\0');
const build=hash.digest('hex');assert.equal(build,f1.buildSha256);
const files=['factory/ViewAssets.js','factory/ViewRuntime.js','factory/ViewPresentation.js','factory/ViewText.js','factory/TicketTracking.js','factory/WorkflowRuntime.js','EdgeWorker.js','factory/FactoryServer.js','factory/PushEvents.js'];
const receipt={at:new Date().toISOString(),head:execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim(),dirty:execFileSync('git',['status','--short'],{encoding:'utf8'}).trim(),f1Build:build,qualification:'Same local measured compiled aggregate as actual F1 before/after; not independent whole-dist reproducibility. Frozen source remains unchanged.',critical:Object.fromEntries(files.map(file=>{const p='packages/edge-worker/dist/'+file;return[p,sha(readFileSync(p))]})),result:'PASS'};
for (const p of ['packages/core/dist/DispatchControl.js','packages/mcp-tools/dist/callConfiguredTool.js','packages/codex-runner/dist/callMcpTool.js','packages/linear-event-transport/dist/LinearDeliveryOutbox.js','packages/linear-event-transport/dist/LinearIssueTrackerService.js','packages/linear-event-transport/dist/LinearRequestBudget.js']) receipt.critical[p]=sha(readFileSync(p));
writeFileSync('/tmp/taskbot140-round6-runtime-identity.json',JSON.stringify(receipt,null,2)+'\n');console.log(JSON.stringify(receipt));
