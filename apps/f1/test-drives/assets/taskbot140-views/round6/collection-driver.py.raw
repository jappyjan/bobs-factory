 folder=Path('/private/var/folders/5m/3pxzz_nd1v7f34rd9vnm01380000gn/T')/source
 for name in ['failure.json','stdout.log','stderr.log','receipt.json','executed-driver.mjs']:
  p=folder/name
  if p.is_file():copy(p,Path('historical')/label/name,True)
