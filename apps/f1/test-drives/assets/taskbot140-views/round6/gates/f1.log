t":"assess-existing","scopeSource":"@source","scopeTicket":"@ticket"},"rules":[],"checks":[{"check":"scope-inputs","sources":{"clarify":"scopeClarify","decisions":"scopeDecisions","plan":"scopePlan","existing-work":"scopeExistingWork","assess-existing":"scopeAssessment","source":"scopeSource","ticket":"scopeTicket"}}],"access":{"mode":"workspace"},"instructions":[],"name":"Inspect existing work and discussion","branches":[],"maxVisits":200,"type":"tool","tool":"inspect-existing","args":[]},{"id":"assess-existing","configVersion":"step-config-v1","reads":{"scopeExistingWork":"existing-work","scopeAssessment":"assess-existing","scopeSource":"@source","scopeTicket":"@ticket"},"output":{"format":"json-v1"},"rules":[],"checks":[{"check":"scope-inputs","sources":{"clarify":"scopeClarify","decisions":"scopeDecisions","plan":"scopePlan","existing-work":"scopeExistingWork","assess-existing":"scopeAssessment","source":"scopeSource","ticket":"scopeTicket"}}],"access":{"mode":"workspace"},"instructions":[],"name":"Assess completed and remaining work","branches":[],"maxVisits":16,"type":"agent","prompt":"Inspect the existing worktree, diff, ticket/PR discussion and review feedback. Do not discard or rewrite completed work. Return {\"completed\":[\"...\"],\"remaining\":[\"...\"],\"risks\":[\"...\"],\"assets\":[\"...\"]}. Identify unresolved feedback and questions to carry into clarification/planning. Do not implement or modify code.","json":true,"askQuestions":false},{"id":"pipeline","configVersion":"step-config-v1","reads":{"scopeExistingWork":"existing-work","scopeAssessment":"assess-existing","scopeSource":"@source","scopeTicket":"@ticket"},"rules":[],"checks":[{"check":"scope-inputs","sources":{"clarify":"scopeClarify","decisions":"scopeDecisions","plan":"scopePlan","existing-work":"scopeExistingWork","assess-existing":"scopeAssessment","source":"scopeSource","ticket":"scopeTicket"}}],"access":{"mode":"workspace"},"instructions":[],"name":"Continue factory pipeline","branches":[],"maxVisits":16,"type":"workflow","workflow":"factory-pipeline"}],"allowedTriggers":["workflow","manual","ticket-assignment"],"launchFields":[{"name":"source","label":"Pull/merge request URL or ticket ID","type":"text","required":true,"placeholder":"Pull/merge request URL or ATT-123","description":"Continue the work described by this source. Existing PRs become draft during factory review.","options":[]},{"name":"prompt","label":"Additional instructions","type":"textarea","required":false,"placeholder":"Anything to add beyond the existing ticket or PR?","options":[]},{"name":"attachments","label":"Attachments","type":"files","required":false,"description":"Attach reference material for this workflow.","options":[]}]},{"id":"factory-pipeline","stepConfigVersion":"step-config-v1","name":"Shared factory pipeline","icon":"🏭","description":"Clarify and plan, then review architecture before coding and deliver repository, external ticket or mixed work with independent evidence and explicit human acceptance.","labels":[],"steps":[{"id":"clarify","configVersion":"step-config-v1","reads":{"scopeClarify":"clarify","scopeDecisions":"decisions","scopePlan":"plan","scopeSource":"@source","scopeTicket":"@ticket"},"output":{"format":"clarify-v1"},"rules":[],"checks":["architecture-revision",{"check":"scope-inputs","sources":{"clarify":"scopeClarify","decisions":"scopeDecisions","plan":"scopePlan","existing-work":"scopeExistingWork","assess-existing":"scopeAssessment","source":"scopeSource","ticket":"scopeTicket"}}],"access":{"mode":"workspace"},"instructions":["delivery","delivery-clarify"],"name":"Clarify requirements","branches":[],"maxVisits":16,"type":"agent","prompt":"Read the input, all comments, metadata, assets and previous answers. Determine whether you fully understand the requirements. Ask only questions that materially affect implementation. If the input says backlog only, planning only, or do not implement yet, and no later user instruction explicitly authorizes implementation, ask whether to proceed with implementation now or retain that restriction before returning empty questions. Do not infer authorization from answers about feature scope. Do not assume answers or implement anything. Return {\"questions\":[\"...\"],\"questionRecommendations\":[{\"questionIndex\":0,\"answer\":\"recommended answer\",\"reason\":\"evidence-based explanation\"}],\"decisions\":[{\"question\":\"...\",\"answer\":\"...\",\"reason\":\"...\"}],\"requirements\":[\"...\"]}. For selectable alternatives, use questionChoices with questionIndex, selection (single or multiple), options (unique id, answer, optional reason) and optional preselectedOptionIds. Do not use questionRecommendations for the same question. Custom text is always available and defaults require explicit submission. Empty questions means everything is understood. Preserve all answered decisions across rounds.{{instruction:delivery}}{{instruction:delivery-clarify}}","json":true,"askQuestions":true},{"id":"decisions","configVersion":"step-config-v1","reads":{"draftPr":"draft-pr","ci":"ci","guide":"guide","reviewGate":"review-gate","handoff":"handoff","merge":"merge","qaReview":"visual-review","capture":"capture","scope":"visual-scope","qaGate":"visual-gate","clarify":"clarify","plan":"plan","implementation":"implement","scopeClarify":"clarify","scopeDecisions":"decisions","scopePlan":"plan","scopeSource":"@source","scopeTicket":"@ticket"},"rules":[],"checks":[{"check":"scope-inputs","sources":{"clarify":"scopeClarify","decisions":"scopeDecisions","plan":"scopePlan","existing-work":"scopeExistingWork","assess-existing":"scopeAssessment","source":"scopeSource","ticket":"scopeTicket"}}],"access":{"mode":"workspace"},"instructions":[],"name":"Record decisions","branches":[],"maxVisits":200,"type":"tool","tool":"record-decisions","args":[]},{"id":"plan","configVersion":"step-config-v1","reads":{"scopeClarify":"clarify","scopeDecisions":"decisions","scopePlan":"plan","scopeSource":"@source","scopeTicket":"@ticket"},"output":{"format":"plan-v1"},"rules":[],"checks":["architecture-revision",{"check":"ticket-milestone","kind":"plan"},"delivery-contract",{"check":"scope-inputs","sources":{"clarify":"scopeClarify","decisions":"scopeDecisions","plan":"scopePlan","existing-work":"scopeExistingWork","assess-existing":"scopeAssessment","source":"scopeSource","ticket":"scopeTicket"}}],"access":{"mode":"workspace"},"instructions":["delivery-plan","implementation-scope","delivery","ticket-plan"],"name":"Write implementation plan","branches":[],"maxVisits":16,"type":"agent","prompt":"Write a lean, complete implementation plan from the original input, ALL comments/metadata, clarified requirements/decision records, and any plan-review feedback. When taking over, include the existing-work and assess-existing results and PR review discussion; preserve completed work and plan only the remaining changes. Include the existing PR URL/branch and require continuing it. Return {\"plan\":\"detailed self-contained Markdown implementation plan with acceptance criteria and validation\",\"assets\":[{\"path\":\"absolute downloaded asset path or URL\",\"purpose\":\"...\"}]}. Include everything the implementer needs: it will receive ONLY this result, never the ticket. Include repository scope, base branch and delivery expectations. {{instruction:implementation-scope}} Do not implement.{{instruction:ticket-plan}}{{instruction:delivery}}{{instruction:delivery-plan}}","json":true,"askQuestions":false},{"id":"plan-review","configVersion":"step-config-v1","reads":{"scopeClarify":"clarify","scopeDecisions":"decisions","scopePlan":"plan","scopeSource":"@source","scopeTicket":"@ticket"},"output":{"format":"plan-review-v1"},"rules":[],"checks":["architecture-revision",{"check":"scope-inputs","sources":{"clarify":"scopeClarify","decisions":"scopeDecisions","plan":"scopePlan","existing-work":"scopeExistingWork","assess-existing":"scopeAssessment","source":"scopeSource","ticket":"scopeTicket"}}],"access":{"mode":"workspace"},"instructions":["implementation-scope","delivery","delivery-plan-review"],"name":"Review implementation plan","next":"delivery-route-accept","branches":[{"when":{"path":"approved","equals":false},"next":"plan"}],"maxVisits":16,"type":"agent","prompt":"Review the plan against ALL input/comments/metadata and decisions. {{instruction:implementation-scope}} Reject invented approval gates for routine dependency edits within the accepted requirements and architecture. Do not implement. Return {\"approved\":true,\"feedback\":[]} or {\"approved\":false,\"feedback\":[\"specific missing requirements or improvements\"]}. Approve a practical MVP plan when complete.{{instruction:delivery}}{{instruction:delivery-plan-review}}","json":true,"askQuestions":false},{"id":"architecture","configVersion":"step-config-v1","reads":{"scopeClarify":"clarify","scopeDecisions":"decisions","scopePlan":"plan","scopeSource":"@source","scopeTicket":"@ticket"},"output":{"format":"architecture-checkin-v1"},"rules":[],"checks":["architecture-revision","architecture-proposal",{"check":"scope-inputs","sources":{"clarify":"scopeClarify","decisions":"scopeDecisions","plan":"scopePlan","existing-work":"scopeExistingWork","assess-existing":"scopeAssessment","source":"scopeSource","ticket":"scopeTicket"}}],"access":{"mode":"workspace"},"instructions":["implementation-scope","architecture-continuation"],"name":"Prepare the check-in","branches":[],"maxVisits":16,"type":"agent","prompt":"Before Bob builds anything, he checks his plan with the human, the way a good colleague walks over and says \"got two minutes before I start?\". Your output is that check-in, plus the complete plan and evidence the automated reviewer verifies.\n\nInspect the selected repositories, actual module boundaries and conventions, all requirements, comments, answers and decisions, the draft plan and prior candidate-review feedback. Preserve Takeover's completed work, PR URL and branch. Propose the smallest adequate design; do not implement or invent human acceptance. Routine unsplit changes using established patterns may bypass approval with a concrete rationale; meaningful responsibilities, boundaries, interfaces or trade-offs require human acceptance.\n\n{{instruction:implementation-scope}}\n\n{{instruction:architecture-continuation}}\n\nWHY THE HUMAN IS ASKED\nAn independent reviewer already checks that every requirement is traced, files are real and the plan is consistent. The human is asked only for what a human can catch while it is still cheap to change course: you misunderstood what they want; a call you made does not fit their product, customers or team; the consequences for people are unacceptable; or the work is the wrong size. Write the check-in for exactly that.\n\nTHE CHECK-IN (talk) - spoken, first person, everyday words, about two minutes to read in total (at most 350 words across all talk fields). No file paths, class names, endpoints or jargon a product owner would not use; say what people experience. Concrete numbers where they matter (\"every 30 seconds\", \"up to 128 waiting devices\").\n- understood (max 360): \"You want ... so that ...\", then what done looks like to them. This is the first thing the human confirms, so restate their goal in their terms, not your solution.\n- plan (max 480): \"I'd ...\" in two to four sentences: the approach, not the task list.\n- scenes: 1-3 whiteboard sketches of what a person or device experiences, before and after, as short steps (max 90 characters each; before 1-5 steps, after 1-6). Pick the moments the change is really about, e.g. title \"A new reader joins\": before [\"Reader connects\", \"It is registered automatically\"], after [\"Reader shows a code that changes every 30 seconds\", \"An administrator types or scans the code\", \"Only then is the reader registered\"].\n- notice: up to 5 groups of people, devices, integrations or operators that will notice once this ships, and how (who max 40, what max 200). Include upgrades, configuration they must set and anything that stops working. [] only when nobody outside the code notices.\n- checks: up to 3 calls you made that need human judgment (product, customers, cost, habits), the least certain first. say (max 260): \"I went with ... because ...\"; instead (max 220): the other way and what it would mean for people. Link decision when the call is one of decisions. Do not list calls the repository or the human's answers already settle; those stay in decisions. Open decisions are questions, never checks.\n- size (max 240): how big this is in human terms: how many separate things change, which parts of the product, rough effort. split (max 240, optional): a sensible way to split it into smaller deliveries if one exists, and what each would deliver first.\n\nWHAT THE REVIEWER CHECKS (Bob's notes; the human opens these only to dig)\n- title (max 80): what will be true afterwards. summary (max 320): current gap, proposed change, scope boundary.\n- problem: 1-3 findings about how things behave today, tied to inspected files. No invented defects.\n- decisions: every real choice with 2-4 concrete options. Decide it yourself (decidedBy=bob) when repository evidence or requirements settle it; mark it open only for human-dependent habits, scope or cost, give why, and set lean to the option you would take. Open decisions block approval; never hide a real choice or leave open one the repository settles.\n- criteria: EVERY original acceptance criterion, including independent/external/hardware checks this PR cannot complete; preserve meaning and source. Without explicit criteria, derive clearly sourced requirements. Coverage is what this plan will deliver, not completed evidence; partial means useful preparation with an explicit remaining part; deferred has no deliverable. The human sees partial and deferred items as \"what this will not fully prove\", so make their reason plain.\n- nonGoals: specific exclusions. acceptance: 3-6 measurable checks; never claim future physical tests or independent review have passed. risks: up to 6 concrete product/technical consequences with what limits each; workflow or ticket status is not a risk. Do not defer mandatory baseline security if the request makes it a prerequisite.\n- map: the system view for engineers: 1-4 areas, at most 10 parts (label max 24, note max 32), links with 1-2 word labels. unchanged parts give context only and cannot also be listed for file changes. Add option previews when an alternative changes the map.\n- evidence: why this design fits the existing architecture, tied to inspected paths.\n- candidate: the COMPLETE self-contained implementation plan; the implementer receives only the accepted plan and assets. Each step: what gets built and observable behavior, kind, relative size, traces ({\"criterion\":\"AC1\"} for requested work or {\"added\":\"concrete necessity and why it was not requested\"} for Bob-added work; never hide extras behind unrelated criteria) and every anticipated file change with exact repo-relative path and new/edit/delete, including tests, docs, configuration and known conditional edits with their triggers. Inspect callers and test wiring before estimating. Do not invent files or add UI/screenshots for a backend-only task without an explicit reason. Name the number and subject of documents. For limits chosen through measurement, state the selection rule and starting constraints; never invent measured values.\n\nNEW VERSIONS\nList every change to the plan since the previous version in changes (max 200 each; from=you when the human asked for it, bob when you added it) and set decidedBy=you for human-settled decisions. The human reads changes first on a new version, so say plainly what you did with each of their notes. Describe what changed in the plan, never approval or authorization status, reviewer process or what was not changed; the runtime tracks those. Read architectureProposals and architectureDecisions for feedback; explanation requests are not authorization.\n\nLIMITS\nproblem observations and nonGoals 320; criterion text 1200; criterion reason, deliverable what and acceptance checks 480; added-work reason 320; deliverable title and decision question 120; IDs and option name 60; option upside/catch 160; decision why, map detail and risks 240; evidence at most 6.\n\nReturn ONLY architecture-v1 with briefVersion=2:\n{\"architectureContract\":\"architecture-v1\",\"briefVersion\":2,\"classification\":\"meaningful or routine\",\"rationale\":\"concrete classification reason\",\"title\":\"...\",\"summary\":\"...\",\"talk\":{\"understood\":\"You want ...\",\"plan\":\"I'd ...\",\"scenes\":[{\"title\":\"...\",\"before\":[\"...\"],\"after\":[\"...\"]}],\"notice\":[{\"who\":\"...\",\"what\":\"...\"}],\"checks\":[{\"decision\":\"optional decision id\",\"say\":\"I went with ...\",\"instead\":\"...\"}],\"size\":\"...\",\"split\":\"optional\"},\"problem\":[{\"repository\":\"selected repo\",\"paths\":[\"inspected existing file\"],\"observation\":\"...\"}],\"decisions\":[{\"id\":\"storage\",\"question\":\"plain question\",\"why\":\"required when open\",\"status\":\"decided or open\",\"pick\":\"option id, only when decided\",\"decidedBy\":\"bob or you, only when decided\",\"lean\":\"option id, only when open\",\"options\":[{\"id\":\"a\",\"name\":\"concrete option\",\"upside\":\"...\",\"catch\":\"...\",\"preview\":{\"parts\":[],\"links\":[],\"hide\":[]}}]}],\"criteria\":[{\"id\":\"AC1\",\"text\":\"complete original criterion text\",\"source\":\"ticket identifier and criterion number, or user requirement\",\"url\":\"optional actual source HTTP URL\",\"status\":\"covered or partial or deferred\",\"reason\":\"...\"}],\"nonGoals\":[\"...\"],\"acceptance\":[\"...\"],\"changes\":[{\"text\":\"...\",\"from\":\"you or bob\"}],\"risks\":[\"...\"],\"map\":{\"areas\":[{\"id\":\"area\",\"name\":\"Area name\"}],\"parts\":[{\"id\":\"part\",\"label\":\"...\",\"note\":\"...\",\"detail\":\"plain sentence\",\"file\":\"optional repo-relative path\",\"area\":\"area\",\"status\":\"new or changed or unchanged or outside\"}],\"links\":[{\"from\":\"part\",\"to\":\"part\",\"label\":\"optional\"}]},\"evidence\":[{\"repository\":\"selected repo\",\"paths\":[\"actual inspected path\"],\"observation\":\"...\"}],\"candidate\":{\"plan\":\"COMPLETE self-contained implementation plan incorporating every accepted requirement/decision, repository/base/delivery targets, inherited Takeover PR/work and validation expectations\",\"steps\":[{\"id\":\"D1\",\"title\":\"...\",\"what\":\"...\",\"kind\":\"code or test or docs or config\",\"size\":\"S or M or L\",\"traces\":[{\"criterion\":\"AC1\"}],\"files\":[{\"path\":\"complete repo-relative file path\",\"change\":\"new or edit or delete\",\"repository\":\"selected repo id; required for grouped repositories\"}]}],\"assets\":[{\"path\":\"absolute path or HTTP URL\",\"purpose\":\"...\"}]}}\n\nMeaningful proposals need a map and at least one decision. Routine outputs may omit map and decisions but still need the check-in and scope fields. Never return footprint/counts or approval fields; the runtime computes footprint from listed files and actual repository boundaries. Independent child delivery is separate future work, not executable scheduling here.","json":true,"askQuestions":false},{"id":"architecture-review","configVersion":"step-config-v1","reads":{"proposal":"architecture","scopeClarify":"clarify","scopeDecisions":"decisions","scopePlan":"plan","scopeSource":"@source","scopeTicket":"@ticket"},"output":{"format":"architecture-review-v1"},"rules":[],"checks":["architecture-revision","architecture-candidate",{"check":"scope-inputs","sources":{"clarify":"scopeClarify","decisions":"scopeDecisions","plan":"scopePlan","existing-work":"scopeExistingWork","assess-existing":"scopeAssessment","source":"scopeSource","ticket":"scopeTicket"}}],"access":{"mode":"workspace"},"instructions":["architecture-questions","implementation-scope","architecture-continuation","architecture-questions-brief"],"name":"Review the check-in","branches":[{"when":{"path":"approved","equals":false},"next":"architecture"}],"maxVisits":16,"type":"agent","prompt":"Review the check-in and its complete implementation plan against ALL requirements, comments, answers, decisions and inherited Takeover work. Require briefVersion=2 and a check-in a product owner can read in about two minutes: understood restates the human's goal in their terms; plan states the approach; scenes show what people or devices experience before and after as short observable steps; notice names every group that will notice, including upgrades, required configuration and anything that stops working; checks list only calls that need human judgment with the honest alternative; size and split are truthful. Reject jargon, file paths or class names in the check-in, benefit statements in place of behavior, consequences missing from notice, and calls that only the human can judge hidden in decisions. Also require concrete current-state findings, observable deliverables with anticipated files/operations/size estimates and criterion traces, every original acceptance criterion with honest covered/partial/deferred status and plain reason, justified Bob-added work, explicit non-goals, measurable acceptance checks and open decisions with Bob's lean. {{instruction:implementation-scope}} Reject invented approval gates for routine dependency edits within the accepted requirements and architecture. {{instruction:architecture-continuation}} Only when the COMPLETE candidate remains within that latest human acceptance, with no open decisions or unresolved uncertainty, include continuation:{proposalId:\"exact accepted proposal ID\",version:1,digest:\"exact accepted digest\",reason:\"concrete evidence that cumulative changes preserve the accepted requirements, decisions, boundaries, limits, exclusions and delivery targets\"}. This is an independent continuity assessment, never a new human acceptance. Omit continuation for initial proposals, material changes, explicit reapproval requirements, rejection or uncertainty. Compare the check-in to the full plan: reject hidden deliverables, omitted known conditional work or criteria, vague options, limits whose values or measurement selection rules appear only in the full plan, unsupported coverage claims, unnecessary packages or frontend work, and process status masquerading as technical risk. Inspect runtime footprint warnings, including invalid paths, operation mismatches and unchanged map parts listed for work; require correction or a concrete explanation of intentional cross-area/config changes. Assess repository evidence, decisions and options, map, readability and routine classification. Reject proposals that hide a real choice or leave a decision open that the repository already settles. Do not implement. {{instruction:architecture-questions-brief}} Return {\"approved\":true,\"feedback\":[]} or {\"approved\":false,\"feedback\":[\"concrete required changes\"]}.","json":true,"askQuestions":false},{"id":"architecture-decision","configVersion":"step-config-v1","reads":{"proposal":"architecture","review":"architecture-review","plan":"plan","revise":"architecture","scopeClarify":"clarify","scopeDecisions":"decisions","scopePlan":"plan","scopeSource":"@source","scopeTicket":"@ticket","draftPr":"draft-pr","ci":"ci","guide":"guide","reviewGate":"review-gate","handoff":"handoff","merge":"merge"},"rules":[],"checks":[{"check":"scope-inputs","sources":{"clarify":"scopeClarify","decisions":"scopeDecisions","plan":"scopePlan","existing-work":"scopeExistingWork","assess-existing":"scopeAssessment","source":"scopeSource","ticket":"scopeTicket"}}],"access":{"mode":"workspace"},"instructions":[],"name":"Check in with you","next":"implement","branches":[{"when":{"path":"decision","equals":"revise"},"next":"architecture"}],"maxVisits":200,"type":"tool","tool":"architecture-decision","args":[],"arguments":{"proposal":"architecture","review":"architecture-review","planOutput":"plan","revise":"architecture","approval":"meaningful","continueAccepted":true}},{"id":"implement","configVersion":"step-config-v1","reads":{"plan":"plan"},"output":{"format":"implement-v1"},"rules":[{"id":"completion","message":"Blocked implementation requires a question to resolve the blocker; completed implementation must have no questions","require":{"any":[{"all":[{"path":"/status","equals":"blocked"},{"any":[{"path":"/questions","empty":false},{"path":"/architectureRevision","equals":true}]}]},{"all":[{"path":"/status","notEquals":"blocked"},{"path":"/questions","empty":true},{"path":"/architectureRevision","notEquals":true}]}]}}],"checks":["architecture-revision",{"check":"ticket-milestone","kind":"implementation"}],"access":{"mode":"workspace"},"instructions":["implementation-scope","implementation-architecture-revision"],"name":"Implement accepted plan","branches":[],"maxVisits":16,"type":"agent","prompt":"Implement the provided plan and use its assets. Read /answers alongside /plan for subsequent human responses, including resolution of implementation blockers. {{instruction:implementation-scope}} Follow repository conventions and appropriate verification. If implementation is forbidden, deferred, or blocked by missing access or a necessary decision, preserve completed work and return {\"status\":\"blocked\",\"summary\":\"concrete blocker\",\"checks\":[\"commands and outcomes\"],\"questions\":[\"specific question or action needed to unblock implementation\"]}. The workflow waits for an answer and resumes this role; do not report deferred or unfinished work as completed. Only after completing implementation return {\"status\":\"completed\",\"summary\":\"...\",\"checks\":[\"commands and outcomes\"],\"questions\":[]}. Do not create or publish a PR; the next step handles delivery.{{instruction:implementation-architecture-revision}}","inputs":["plan"],"json":true,"askQuestions":true},{"id":"draft-pr","configVersion":"step-config-v1","reads":{"draftPr":"draft-pr","ci":"ci","guide":"guide","reviewGate":"review-gate","handoff":"handoff","merge":"merge","qaReview":"visual-review","capture":"capture","scope":"visual-scope","qaGate":"visual-gate","clarify":"clarify","plan":"plan","implementation":"implement","scopeClarify":"clarify","scopeDecisions":"decisions","scopePlan":"plan","scopeSource":"@source","scopeTicket":"@ticket"},"rules":[],"checks":[{"check":"scope-inputs","sources":{"clarify":"scopeClarify","decisions":"scopeDecisions","plan":"scopePlan","existing-work":"scopeExistingWork","assess-existing":"scopeAssessment","source":"scopeSource","ticket":"scopeTicket"}}],"access":{"mode":"workspace"},"instructions":[],"name":"Push and create draft PR","branches":[],"maxVisits":200,"type":"tool","tool":"draft-pr","args":[]},{"id":"assess-impact","configVersion":"step-config-v1","reads":{"inventory":"extract-requirements","fanout":"specialist-review","ci":"ci","feedback":"@feedback","scopeClarify":"clarify","scopeDecisions":"decisions","scopePlan":"plan","scopeSource":"@source","scopeTicket":"@ticket"},"output":{"format":"impact-v1"},"rules":[],"checks":["architecture-revision",{"check":"impact-reuse","maxUnchangedCycles":3},{"check":"scope-inputs","sources":{"clarify":"scopeClarify","decisions":"scopeDecisions","plan":"scopePlan","existing-work":"scopeExistingWork","assess-existing":"scopeAssessment","source":"scopeSource","ticket":"scopeTicket"}}],"access":{"mode":"workspace"},"instructions":[],"name":"Assess changed work and retained evidence","next":"impact-checks","branches":[{"when":{"path":"correctionRequired","equals":true},"next":"ci-fix"},{"when":{"path":"readinessOnly","equals":true},"next":"ci"},{"when":{"path":"extractRequirements","equals":true},"next":"extract-requirements"}],"maxVisits":200,"type":"agent","prompt":"Independently assess /impactSnapshot, actual repository diffs (including cumulative changes since prior explicit approval), prior original receipts and unresolved findings. Fixer summaries never authorize reuse. Discover commands and conventions in ALL selected repositories; never infer safety from filenames, line count or unchanged head alone. Inspect whether test changes weaken assertions or coverage. Assess combined merge trees and target-only changes separately from task regressions. Unknown dependencies, conflicts, migrations, security boundaries, changed scope or unavailable evidence require broader inspection and relevant validation. Select only configured reviewer IDs from the snapshot. First review executes all roles. Reuse only completed resolved receipts with runtime dependency provenance; supply their exact receipt digest, boundary and a concrete independence reason. Unaffected areas retain original evidence, never claim a new review executed. Track future QA/guide/human/provider obligations at their own gates. Optional cleanup remains visible and nonblocking. Prior explicit approval can continue for an evidenced safe minor correction, including production code, only after all required evidence passes; uncertain or meaningful changes and human rejection require renewed approval. Assess the cumulative delta. Return impact-v1 with status, summary, correctionRequired:boolean, readinessOnly:boolean, commentAssessments:[{id,repositoryId (required for grouped deliveries unless id is repositoryId:commentId),bodySha256,disposition:\"informational|consequential|accepted-unchanged\",reason}], classification:\"none|affected|full\", rationale, uncertainty:[], extractRequirements:boolean, scopeReuse:{inventoryDigest,originalSourceDigest,reason} only when independently inspecting new feedback proves accepted requirements unchanged, specialists:[configured IDs], requirementIds:[], checks:[{id,repositoryId,command,reason,environment:{isolation:\"worktree\"} or {isolation:\"shared\",resources:[stable identities]}}], qaCriteria:[criterion IDs], qaReuse:[{criterionId,originalDigest,reason}], reuse:[{reviewer,receiptDigest,reason,boundary:{requirementIds,areas,dependencies,independence}}], invalidate:[{receiptDigest,reason}], targetCompatible:boolean, testAssertions:{inspected,weakened,evidence}, humanReview:\"no-prior-approval|continue-after-checks|renew\", approvalRationale and questions:[]. Missing inputs require blocked and a specific question. commentAssessments may identify ONLY supplied PR feedback from /feedback/readiness/unassessedComments, using its exact IDs and bodySha256 values. Originating ticket comments, assignment notices and chat messages are task inputs, never PR comment assessments. Return commentAssessments:[] when no PR feedback is supplied. Do not mutate files or run corrective agents. Every original configured role needs fresh execution or explicit valid reuse. Missing legacy provenance requires fresh review.","json":true,"askQuestions":true},{"id":"extract-requirements","configVersion":"step-config-v1","reads":{"scopeClarify":"clarify","scopeDecisions":"decisions","scopePlan":"plan","scopeSource":"@source","scopeTicket":"@ticket"},"output":{"format":"inventory-v1"},"rules":[],"checks":["architecture-revision","inventory-evidence",{"check":"scope-inputs","sources":{"clarify":"scopeClarify","decisions":"scopeDecisions","plan":"scopePlan","existing-work":"scopeExistingWork","assess-existing":"scopeAssessment","source":"scopeSource","ticket":"scopeTicket"}}],"revision":"bound","access":{"mode":"workspace"},"instructions":["review-stage-inventory","impact-inventory"],"name":"Extract requirements","next":"impact-checks","branches":[],"maxVisits":16,"type":"agent","prompt":"Extract scope independently of the implementation. Read complete originalInput (parse embedded JSON), ticket/acceptance criteria, ALL paginated comments, attachments/assets, clarification answers and accepted decisions/plan, later chat/human steering, takeover/PR discussions and past review rounds/dispositions through factory-context. Use /contextMemory/reviewLedger and /contextMemory/reviewRounds for historical claims and reasoning, following original outputPath records when scope or disagreement evidence is needed. Follow nextOffset to null. Missing source access requires a concrete questions entry; never omit unavailable scope. Read previous inventories, retain every historical ID and decision, and record amendments/supersessions with changeReason. Suggestions are not accepted scope. Contradictions stay in conflicts and questions until explicitly resolved outside fanout. Scope decisions require explicit human acceptance, rationale and source, not a reviewer preference. Follow the runtime decision-attribution rule: use a recorded name when available, otherwise identify the Factory operator with the name not recorded; do not ask for a name merely to complete attribution. Use kind:\"skip\" only for an explicit scope waiver, and list the precise requirementIds it authorizes skipping; other accepted scope decisions use kind:\"scope\". List considered sources and unavailable sources in sourceReceipt. Semantic extraction completeness needs source inspection; structural validation alone cannot prove it.\nReturn {\"schemaVersion\":1,\"requirements\":[{\"id\":\"R1\",\"criterion\":\"testable accepted outcome\",\"classification\":\"active or suggestion or superseded\",\"sources\":[{\"source\":\"originalInput or context record or source URL\",\"reference\":\"JSON Pointer/comment/attachment identifier\"}],\"changeReason\":\"required for an amendment\",\"supersedes\":[]}],\"decisions\":[{\"id\":\"D1\",\"acceptedBy\":\"recorded person or Factory operator (name not recorded)\",\"kind\":\"scope or skip\",\"requirementIds\":[\"R1\"],\"rationale\":\"accepted scope rationale\",\"source\":{\"source\":\"source\",\"reference\":\"record identifier\"}}],\"conflicts\":[{\"id\":\"C1\",\"description\":\"unresolved scope question\",\"sources\":[{\"source\":\"source\",\"reference\":\"record\"}]}],\"sourceReceipt\":{\"considered\":[{\"source\":\"source\",\"reference\":\"record\"}],\"unavailable\":[]},\"questions\":[]}. Runtime owns inventory version/digest. Do not change product files.{{instruction:impact-inventory}}","json":true,"askQuestions":true},{"id":"impact-checks","configVersion":"step-config-v1","reads":{"impact":"assess-impact","scopeClarify":"clarify","scopeDecisions":"decisions","scopePlan":"plan","scopeSource":"@source","scopeTicket":"@ticket","draftPr":"draft-pr","ci":"ci","guide":"guide","reviewGate":"review-gate","handoff":"handoff","merge":"merge"},"rules":[],"checks":["impact-boundary",{"check":"scope-inputs","sources":{"clarify":"scopeClarify","decisions":"scopeDecisions","plan":"scopePlan","existing-work":"scopeExistingWork","assess-existing":"scopeAssessment","source":"scopeSource","ticket":"scopeTicket"}}],"access":{"mode":"workspace"},"instructions":[],"name":"Run independently selected checks","next":"specialist-review","branches":[],"maxVisits":200,"type":"tool","tool":"impact-checks","args":[]},{"id":"specialist-review","configVersion":"step-config-v1","reads":{"inventory":"extract-requirements","impact":"assess-impact","scopeClarify":"clarify","scopeDecisions":"decisions","scopePlan":"plan","scopeSource":"@source","scopeTicket":"@ticket"},"rules":[],"checks":["review-boundary","impact-boundary",{"check":"scope-inputs","sources":{"clarify":"scopeClarify","decisions":"scopeDecisions","plan":"scopePlan","existing-work":"scopeExistingWork","assess-existing":"scopeAssessment","source":"scopeSource","ticket":"scopeTicket"}}],"access":{"mode":"workspace"},"instructions":[],"name":"Parallel specialist review","branches":[],"maxVisits":16,"type":"fanout","groups":[[{"id":"security-review","configVersion":"step-config-v1","reads":{"scopeSource":"@source","scopeTicket":"@ticket"},"output":{"format":"specialist-v1"},"rules":[],"checks":["specialist-evidence",{"check":"scope-inputs","sources":{"clarify":"scopeClarify","decisions":"scopeDecisions","plan":"scopePlan","existing-work":"scopeExistingWork","assess-existing":"scopeAssessment","source":"scopeSource","ticket":"scopeTicket"}}],"revision":"bound","access":{"mode":"workspace"},"instructions":["review-stage-specialist","review-completion"],"name":"Security and data protection","branches":[],"maxVisits":16,"type":"agent","prompt":"Own authorization, trust boundaries, secrets, untrusted input and consequential data exposure. Avoid general style or business scope review.\nRead /reviewBaseline first. Review ONLY the frozen clean head/base and requirement inventory in that baseline. All reviewers receive the same immutable context and history cutoff. Read /contextMemory/reviewLedger and /contextMemory/reviewRounds when present; these preserve previous findings, fixer dispositions and review reasoning. Use original outputPath records for relevant disagreement or evidence details, rather than rereading every old review output. Without compact memory, read complete previous review rounds and fixer dispositions. Preserve stable local finding IDs. Reassess every prior open rating 2/3 finding. Settled findings may reopen only with freshEvidence describing new evidence or changed requirements. Resolved or accepted-rejection needs concrete evidence and reason. A fixer saying fixed is not proof. Preserve contradictory recommendations in disagreements until evidence resolves them. Removing a prior disagreement requires disputeResolutions:[{disagreement,reason,evidence}]. To reassess an inherited finding from a removed reviewer, use inheritedDispositions:[{id:\"reviewer:local-id\",status:\"resolved or accepted-rejection\",reason,evidence}]. Unmentioned inherited complaints remain open. Do not change product files, commit, publish, run hidden harness subagents or ask a question inside fanout. Report missing evidence instead of inventing a pass. Ratings: 1 nonblocking observation, 2 consequential should-fix, 3 must-fix.\nReturn {\"summary\":\"concrete result\",\"findings\":[{\"id\":\"stable-local-id\",\"rating\":2,\"summary\":\"concrete failure\",\"evidence\":\"file:line or actual check receipt\",\"status\":\"open or resolved or accepted-rejection\",\"requirementIds\":[\"stable inventory ID\"],\"reason\":\"required for settled dispositions\",\"freshEvidence\":\"required for reopening settled findings\"}],\"disagreements\":[\"unresolved conflicting recommendation and evidence\"]}. Runtime owns reviewer/revision/round stamps. Do not claim later QA executed; distinguish current code/local checks from future QA.","json":true,"askQuestions":false}],[{"id":"architecture-review","configVersion":"step-config-v1","reads":{"scopeSource":"@source","scopeTicket":"@ticket"},"output":{"format":"specialist-v1"},"rules":[],"checks":["specialist-evidence",{"check":"scope-inputs","sources":{"clarify":"scopeClarify","decisions":"scopeDecisions","plan":"scopePlan","existing-work":"scopeExistingWork","assess-existing":"scopeAssessment","source":"scopeSource","ticket":"scopeTicket"}}],"revision":"bound","access":{"mode":"workspace"},"instructions":["review-stage-specialist","review-completion"],"name":"Architecture and module boundaries","branches":[],"maxVisits":16,"type":"agent","prompt":"Own responsibilities, dependency direction, domain/API seams and interface compatibility. Avoid speculative redesign and local style.\nRead /reviewBaseline first. Review ONLY the frozen clean head/base and requirement inventory in that baseline. All reviewers receive the same immutable context and history cutoff. Read /contextMemory/reviewLedger and /contextMemory/reviewRounds when present; these preserve previous findings, fixer dispositions and review reasoning. Use original outputPath records for relevant disagreement or evidence details, rather than rereading every old review output. Without compact memory, read complete previous review rounds and fixer dispositions. Preserve stable local finding IDs. Reassess every prior open rating 2/3 finding. Settled findings may reopen only with freshEvidence describing new evidence or changed requirements. Resolved or accepted-rejection needs concrete evidence and reason. A fixer saying fixed is not proof. Preserve contradictory recommendations in disagreements until evidence resolves them. Removing a prior disagreement requires disputeResolutions:[{disagreement,reason,evidence}]. To reassess an inherited finding from a removed reviewer, use inheritedDispositions:[{id:\"reviewer:local-id\",status:\"resolved or accepted-rejection\",reason,evidence}]. Unmentioned inherited complaints remain open. Do not change product files, commit, publish, run hidden harness subagents or ask a question inside fanout. Report missing evidence instead of inventing a pass. Ratings: 1 nonblocking observation, 2 consequential should-fix, 3 must-fix.\nReturn {\"summary\":\"concrete result\",\"findings\":[{\"id\":\"stable-local-id\",\"rating\":2,\"summary\":\"concrete failure\",\"evidence\":\"file:line or actual check receipt\",\"status\":\"open or resolved or accepted-rejection\",\"requirementIds\":[\"stable inventory ID\"],\"reason\":\"required for settled dispositions\",\"freshEvidence\":\"required for reopening settled findings\"}],\"disagreements\":[\"unresolved conflicting recommendation and evidence\"]}. Runtime owns reviewer/revision/round stamps. Do not claim later QA executed; distinguish current code/local checks from future QA.","json":true,"askQuestions":false}],[{"id":"integration-review","configVersion":"step-config-v1","reads":{"scopeSource":"@source","scopeTicket":"@ticket"},"output":{"format":"specialist-v1"},"rules":[],"checks":["specialist-evidence",{"check":"scope-inputs","sources":{"clarify":"scopeClarify","decisions":"scopeDecisions","plan":"scopePlan","existing-work":"scopeExistingWork","assess-existing":"scopeAssessment","source":"scopeSource","ticket":"scopeTicket"}}],"revision":"bound","access":{"mode":"workspace"},"instructions":["review-stage-specialist","review-completion"],"name":"Repository fit and integration","branches":[],"maxVisits":16,"type":"agent","prompt":"Own repository conventions, established reuse, config/migration wiring and surrounding integrations. Identify concrete omitted integration sites.\nRead /reviewBaseline first. Review ONLY the frozen clean head/base and requirement inventory in that baseline. All reviewers receive the same immutable context and history cutoff. Read /contextMemory/reviewLedger and /contextMemory/reviewRounds when present; these preserve previous findings, fixer dispositions and review reasoning. Use original outputPath records for relevant disagreement or evidence details, rather than rereading every old review output. Without compact memory, read complete previous review rounds and fixer dispositions. Preserve stable local finding IDs. Reassess every prior open rating 2/3 finding. Settled findings may reopen only with freshEvidence describing new evidence or changed requirements. Resolved or accepted-rejection needs concrete evidence and reason. A fixer saying fixed is not proof. Preserve contradictory recommendations in disagreements until evidence resolves them. Removing a prior disagreement requires disputeResolutions:[{disagreement,reason,evidence}]. To reassess an inherited finding from a removed reviewer, use inheritedDispositions:[{id:\"reviewer:local-id\",status:\"resolved or accepted-rejection\",reason,evidence}]. Unmentioned inherited complaints remain open. Do not change product files, commit, publish, run hidden harness subagents or ask a question inside fanout. Report missing evidence instead of inventing a pass. Ratings: 1 nonblocking observation, 2 consequential should-fix, 3 must-fix.\nReturn {\"summary\":\"concrete result\",\"findings\":[{\"id\":\"stable-local-id\",\"rating\":2,\"summary\":\"concrete failure\",\"evidence\":\"file:line or actual check receipt\",\"status\":\"open or resolved or accepted-rejection\",\"requirementIds\":[\"stable inventory ID\"],\"reason\":\"required for settled dispositions\",\"freshEvidence\":\"required for reopening settled findings\"}],\"disagreements\":[\"unresolved conflicting recommendation and evidence\"]}. Runtime owns reviewer/revision/round stamps. Do not claim later QA executed; distinguish current code/local checks from future QA.","json":true,"askQuestions":false}],[{"id":"simplicity-review","configVersion":"step-config-v1","reads":{"scopeSource":"@source","scopeTicket":"@ticket"},"output":{"format":"specialist-v1"},"rules":[],"checks":["specialist-evidence",{"check":"scope-inputs","sources":{"clarify":"scopeClarify","decisions":"scopeDecisions","plan":"scopePlan","existing-work":"scopeExistingWork","assess-existing":"scopeAssessment","source":"scopeSource","ticket":"scopeTicket"}}],"revision":"bound","access":{"mode":"workspace"},"instructions":["review-stage-specialist","review-completion"],"name":"Simplicity and maintainability","branches":[],"maxVisits":16,"type":"agent","prompt":"Own unnecessary abstraction, duplication, speculative extensibility and disproportionate complexity. Explain maintenance cost and a smaller sufficient alternative.\nRead /reviewBaseline first. Review ONLY the frozen clean head/base and requirement inventory in that baseline. All reviewers receive the same immutable context and history cutoff. Read /contextMemory/reviewLedger and /contextMemory/reviewRounds when present; these preserve previous findings, fixer dispositions and review reasoning. Use original outputPath records for relevant disagreement or evidence details, rather than rereading every old review output. Without compact memory, read complete previous review rounds and fixer dispositions. Preserve stable local finding IDs. Reassess every prior open rating 2/3 finding. Settled findings may reopen only with freshEvidence describing new evidence or changed requirements. Resolved or accepted-rejection needs concrete evidence and reason. A fixer saying fixed is not proof. Preserve contradictory recommendations in disagreements until evidence resolves them. Removing a prior disagreement requires disputeResolutions:[{disagreement,reason,evidence}]. To reassess an inherited finding from a removed reviewer, use inheritedDispositions:[{id:\"reviewer:local-id\",status:\"resolved or accepted-rejection\",reason,evidence}]. Unmentioned inherited complaints remain open. Do not change product files, commit, publish, run hidden harness subagents or ask a question inside fanout. Report missing evidence instead of inventing a pass. Ratings: 1 nonblocking observation, 2 consequential should-fix, 3 must-fix.\nReturn {\"summary\":\"concrete result\",\"findings\":[{\"id\":\"stable-local-id\",\"rating\":2,\"summary\":\"concrete failure\",\"evidence\":\"file:line or actual check receipt\",\"status\":\"open or resolved or accepted-rejection\",\"requirementIds\":[\"stable inventory ID\"],\"reason\":\"required for settled dispositions\",\"freshEvidence\":\"required for reopening settled findings\"}],\"disagreements\":[\"unresolved conflicting recommendation and evidence\"]}. Runtime owns reviewer/revision/round stamps. Do not claim later QA executed; distinguish current code/local checks from future QA.","json":true,"askQuestions":false}],[{"id":"correctness-review","configVersion":"step-config-v1","reads":{"scopeSource":"@source","scopeTicket":"@ticket"},"output":{"format":"specialist-v1"},"rules":[],"checks":["specialist-evidence",{"check":"scope-inputs","sources":{"clarify":"scopeClarify","decisions":"scopeDecisions","plan":"scopePlan","existing-work":"scopeExistingWork","assess-existing":"scopeAssessment","source":"scopeSource","ticket":"scopeTicket"}}],"revision":"bound","access":{"mode":"workspace"},"instructions":["review-stage-specialist","review-completion"],"name":"Correctness and verification","branches":[],"maxVisits":16,"type":"agent","prompt":"Own behavioral failures, boundaries, state/concurrency, error handling and actual verification gaps. Ground complaints in reproduction or code evidence.\nRead /reviewBaseline first. Review ONLY the frozen clean head/base and requirement inventory in that baseline. All reviewers receive the same immutable context and history cutoff. Read /contextMemory/reviewLedger and /contextMemory/reviewRounds when present; these preserve previous findings, fixer dispositions and review reasoning. Use original outputPath records for relevant disagreement or evidence details, rather than rereading every old review output. Without compact memory, read complete previous review rounds and fixer dispositions. Preserve stable local finding IDs. Reassess every prior open rating 2/3 finding. Settled findings may reopen only with freshEvidence describing new evidence or changed requirements. Resolved or accepted-rejection needs concrete evidence and reason. A fixer saying fixed is not proof. Preserve contradictory recommendations in disagreements until evidence resolves them. Removing a prior disagreement requires disputeResolutions:[{disagreement,reason,evidence}]. To reassess an inherited finding from a removed reviewer, use inheritedDispositions:[{id:\"reviewer:local-id\",status:\"resolved or accepted-rejection\",reason,evidence}]. Unmentioned inherited complaints remain open. Do not change product files, commit, publish, run hidden harness subagents or ask a question inside fanout. Report missing evidence instead of inventing a pass. Ratings: 1 nonblocking observation, 2 consequential should-fix, 3 must-fix.\nReturn {\"summary\":\"concrete result\",\"findings\":[{\"id\":\"stable-local-id\",\"rating\":2,\"summary\":\"concrete failure\",\"evidence\":\"file:line or actual check receipt\",\"status\":\"open or resolved or accepted-rejection\",\"requirementIds\":[\"stable inventory ID\"],\"reason\":\"required for settled dispositions\",\"freshEvidence\":\"required for reopening settled findings\"}],\"disagreements\":[\"unresolved conflicting recommendation and evidence\"]}. Runtime owns reviewer/revision/round stamps. Do not claim later QA executed; distinguish current code/local checks from future QA.","json":true,"askQuestions":false}],[{"id":"requirements-review","configVersion":"step-config-v1","reads":{"scopeSource":"@source","scopeTicket":"@ticket"},"output":{"format":"coverage-v1"},"rules":[],"checks":[{"check":"specialist-evidence","coverage":true},{"check":"scope-inputs","sources":{"clarify":"scopeClarify","decisions":"scopeDecisions","plan":"scopePlan","existing-work":"scopeExistingWork","assess-existing":"scopeAssessment","source":"scopeSource","ticket":"scopeTicket"}}],"revision":"bound","access":{"mode":"workspace"},"instructions":["review-stage-coverage","review-completion"],"name":"Business requirements and acceptance","branches":[],"maxVisits":16,"type":"agent","prompt":"Own complete acceptance coverage. Assess EVERY active requirement exactly once; preserve superseded/suggestion records as context. Return coverage:[{requirementId,status:'met or not_met or deliberately_skipped',evidence:['concrete evidence at frozen revision'],reason:'why',decisionId:'accepted decision for deliberate skip'}] alongside review fields. Missing or inconclusive evidence is not_met, with an actionable open rating 2/3 finding referencing the ID. A skip needs an explicitly accepted decision, recorded person or unnamed Factory operator, rationale and source. Missing personal-name metadata alone cannot block coverage. Do not let reviewer/fixer preference waive scope.\nRead /reviewBaseline first. Review ONLY the frozen clean head/base and requirement inventory in that baseline. All reviewers receive the same immutable context and history cutoff. Read /contextMemory/reviewLedger and /contextMemory/reviewRounds when present; these preserve previous findings, fixer dispositions and review reasoning. Use original outputPath records for relevant disagreement or evidence details, rather than rereading every old review output. Without compact memory, read complete previous review rounds and fixer dispositions. Preserve stable local finding IDs. Reassess every prior open rating 2/3 finding. Settled findings may reopen only with freshEvidence describing new evidence or changed requirements. Resolved or accepted-rejection needs concrete evidence and reason. A fixer saying fixed is not proof. Preserve contradictory recommendations in disagreements until evidence resolves them. Removing a prior disagreement requires disputeResolutions:[{disagreement,reason,evidence}]. To reassess an inherited finding from a removed reviewer, use inheritedDispositions:[{id:\"reviewer:local-id\",status:\"resolved or accepted-rejection\",reason,evidence}]. Unmentioned inherited complaints remain open. Do not change product files, commit, publish, run hidden harness subagents or ask a question inside fanout. Report missing evidence instead of inventing a pass. Ratings: 1 nonblocking observation, 2 consequential should-fix, 3 must-fix.\nReturn {\"summary\":\"concrete result\",\"findings\":[{\"id\":\"stable-local-id\",\"rating\":2,\"summary\":\"concrete failure\",\"evidence\":\"file:line or actual check receipt\",\"status\":\"open or resolved or accepted-rejection\",\"requirementIds\":[\"stable inventory ID\"],\"reason\":\"required for settled dispositions\",\"freshEvidence\":\"required for reopening settled findings\"}],\"disagreements\":[\"unresolved conflicting recommendation and evidence\"]}. Runtime owns reviewer/revision/round stamps. Do not claim later QA executed; distinguish current code/local checks from future QA.","json":true,"askQuestions":false}]]},{"id":"review-gate","configVersion":"step-config-v1","reads":{"fix":"code-fix","inventory":"extract-requirements","fanout":"specialist-review","impact":"assess-impact","scopeClarify":"clarify","scopeDecisions":"decisions","scopePlan":"plan","scopeSource":"@source","scopeTicket":"@ticket","draftPr":"draft-pr","ci":"ci","guide":"guide","reviewGate":"review-gate","handoff":"handoff","merge":"merge"},"rules":[],"checks":["review-boundary","impact-boundary",{"check":"scope-inputs","sources":{"clarify":"scopeClarify","decisions":"scopeDecisions","plan":"scopePlan","existing-work":"scopeExistingWork","assess-existing":"scopeAssessment","source":"scopeSource","ticket":"scopeTicket"}},"review-evidence","review-assistance"],"access":{"mode":"workspace"},"instructions":[],"name":"Check review findings","branches":[{"when":{"path":"reviewIncomplete","equals":true},"next":"assess-impact"},{"when":{"path":"reviewBlocked","equals":true},"next":"code-fix"},{"when":{"path":"approved","equals":false},"next":"code-fix"}],"maxVisits":200,"type":"check","check":{"results":{"approved":{"all":[{"count":"/evidence/review-evidence/findings","where":{"all":[{"path":"/status","equals":"open"},{"path":"/rating","min":2}]},"max":0},{"path":"/evidence/review-evidence/disagreements","empty":true},{"any":[{"all":[{"path":"/evidence/review-evidence/reviewers","exists":true},{"each":"/evidence/review-evidence/reviewers","require":{"all":[{"path":"/status","equals":"completed"},{"path":"/blockers","empty":true}]}},{"count":"/evidence/review-evidence/coverage","where":{"path":"/status","equals":"not_met"},"max":0}]},{"all":[{"not":{"path":"/evidence/review-evidence/reviewers","exists":true}},{"path":"/evidence/review-evidence/status","equals":"completed"},{"path":"/evidence/review-evidence/blockers","empty":true}]}]}]},"findings":{"aggregate":"filter","path":"/evidence/review-evidence/findings","where":{"all":[{"path":"/status","equals":"open"},{"path":"/rating","min":2}]}},"reviewIncomplete":{"path":"/evidence/review-evidence/reviewIncomplete","equals":true},"reviewBlocked":{"path":"/evidence/review-evidence/reviewBlocked","equals":true},"questions":{"select":"/evidence/review-evidence/questions"},"rawFindings":{"select":"/evidence/review-evidence/rawFindings"},"coverage":{"select":"/evidence/review-evidence/coverage"},"reviewers":{"select":"/evidence/review-evidence/reviewers"},"disagreements":{"select":"/evidence/review-evidence/disagreements"}},"passed":{"path":"/results/approved","equals":true}}},{"id":"ci","configVersion":"step-config-v1","reads":{"draftPr":"draft-pr","ci":"ci","guide":"guide","reviewGate":"review-gate","handoff":"handoff","merge":"merge","qaReview":"visual-review","capture":"capture","scope":"visual-scope","qaGate":"visual-gate","fix":"ci-fix","impact":"assess-impact","scopeClarify":"clarify","scopeDecisions":"decisions","scopePlan":"plan","scopeSource":"@source","scopeTicket":"@ticket"},"rules":[],"checks":["impact-boundary",{"check":"scope-inputs","sources":{"clarify":"scopeClarify","decisions":"scopeDecisions","plan":"scopePlan","existing-work":"scopeExistingWork","assess-existing":"scopeAssessment","source":"scopeSource","ticket":"scopeTicket"}}],"access":{"mode":"workspace"},"instructions":[],"name":"Watch merge readiness","branches":[{"when":{"path":"impactRequired","equals":true},"next":"assess-impact"},{"when":{"path":"retainQa","equals":true},"next":"guide"},{"when":{"path":"fix","equals":true},"next":"ci-fix"}],"maxVisits":200,"type":"tool","tool":"ci","args":[]},{"id":"visual-scope","configVersion":"step-config-v1","reads":{"mergeReadiness":"@mergeReadiness","scopeClarify":"clarify","scopeDecisions":"decisions","scopePlan":"plan","scopeSource":"@source","scopeTicket":"@ticket"},"output":{"format":"qa-scope-v1"},"rules":[{"id":"video-contract","message":"Invalid input: expected \"video-v1\"","path":"/videoContract","require":{"path":"/videoContract","equals":"video-v1"}}],"checks":["architecture-revision",{"check":"ids-resolve","adapter":"qa-scope"},{"check":"scope-inputs","sources":{"clarify":"scopeClarify","decisions":"scopeDecisions","plan":"scopePlan","existing-work":"scopeExistingWork","assess-existing":"scopeAssessment","source":"scopeSource","ticket":"scopeTicket"}}],"access":{"mode":"workspace"},"instructions":["incremental-visual-scope","video-scope","impact-scope","inventory-qa"],"name":"Plan QA stories and screenshots","branches":[],"maxVisits":16,"type":"agent","prompt":"Read the accepted requirements, all recorded decisions/expectations, plan, implementation receipts, relevant history and exact cumulative base-to-head PR diff (including inherited takeover work). Plan observable QA for ALL changed behavior: UI, API, CLI and other interfaces. Declare environment:{isolation:\"worktree\"} only when all QA uses independent per-worktree servers, databases and fixtures. For shared clusters, databases, fixtures or browser control return environment:{isolation:\"shared\",resources:[\"stable shared resource identity\"]}; use the same identity across repositories/runs using that resource. Unknown isolation requires shared protection, never assume a worktree isolates external resources. Cover happy paths and consequential failure, permission and boundary cases proportionately. Trace stories to agreed requirements; do not invent business requirements or turn subjective preferences into blocking criteria. Explain any requirement/diff area outside executable QA in exclusions. Assess navigation, feedback, readability and recovery where relevant.\nReturn {\"qaContract\":\"qa-v1\",\"changed\":false,\"areas\":[],\"captureBudget\":24,\"stories\":[{\"id\":\"stable-story-id\",\"goal\":\"user goal\",\"requirementRefs\":[\"requirements/0 or decisions/0 or answers/0 (existing zero-based accepted record)\"],\"interface\":\"ui or api or cli or other\",\"preconditions\":[\"setup\"],\"fixtures\":[\"access or data needed\"],\"actions\":[\"ordered executable action\"],\"criteria\":[{\"id\":\"globally unique stable criterion ID\",\"expected\":\"observable expected outcome\"}],\"evidenceInstructions\":\"how to execute and record evidence\",\"screenshotTasks\":[{\"area\":\"exact selected area\",\"state\":\"exact selected state at a defined point in these actions\"}]}],\"exclusions\":[{\"requirementRef\":\"requirement/diff area\",\"reason\":\"concrete reason outside executable QA\"}]}.\nchanged refers only to VISUAL scope. Nonvisual changes still need executable stories with real behavioral checks and may have zero screenshots. No changed executable behavior may use stories=[] only with a concrete notApplicableReason; no visual changes is insufficient. Inspect relevant existing tests before selecting them as criterion evidence.\nFor visuals return changed=true and areas:[{name,url,states:[\"single concrete representative state\"],instructions,rationale,dependencies,changed}]. Normally choose 1–2 states per area and at most 24 screenshots. Group co-visible elements. Never multiply viewport/language/role combinations or comma-separated alternatives. Additional states must show distinct changed rendering risk. Up to 48 needs a concrete budgetReason. Every selected area/state must be linked to a story; API/CLI checks do not need artificial images. Dependencies are exact repository files or directory/** paths. Do not change code, execute QA or take screenshots.{{instruction:video-scope}}{{instruction:inventory-qa}}{{instruction:impact-scope}}","json":true,"askQuestions":false},{"id":"capture","configVersion":"step-config-v1","reads":{"qaReuse":"@qaReuse","qaReview":"visual-review","scope":"visual-scope","qaGate":"visual-gate","answers":"@answers","scopeClarify":"clarify","scopeDecisions":"decisions","scopePlan":"plan","scopeSource":"@source","scopeTicket":"@ticket"},"output":{"format":"qa-capture-v1"},"rules":[{"id":"video-contract","message":"Invalid input: expected \"video-v1\"","path":"/videoContract","require":{"path":"/videoContract","equals":"video-v1"}}],"checks":["architecture-revision","capture-evidence","qa-environment",{"check":"media-valid","adapter":"capture","video":true},{"check":"scope-inputs","sources":{"clarify":"scopeClarify","decisions":"scopeDecisions","plan":"scopePlan","existing-work":"scopeExistingWork","assess-existing":"scopeAssessment","source":"scopeSource","ticket":"scopeTicket"}}],"access":{"mode":"workspace"},"instructions":["incremental-capture","video-capture","impact-capture"],"name":"Execute QA and capture screenshots","next":"visual-review","branches":[],"maxVisits":16,"type":"agent","prompt":"Execute EVERY planned QA story and acceptance criterion from visual-scope, including nonvisual API/CLI behavior. Read /answers for resolved access, fixtures and tooling blockers. Set up the application once when needed, use appropriate actual fixtures, and execute browser/HTTP/CLI/tests as instructed. Inspect test coverage and run the checks; source inspection or an implementation receipt alone cannot establish a pass. Compare observed outcomes with each exact expected outcome. Assess applicable navigation, feedback, readability and recovery. Do not modify product code or repair failures.\nReturn {\"qaContract\":\"qa-v1\",\"results\":[{\"storyId\":\"planned ID\",\"outcome\":\"passed or failed or blocked\",\"criteria\":[{\"criterionId\":\"planned ID\",\"outcome\":\"passed or failed or blocked\",\"expected\":\"exact expected outcome from scope\",\"observed\":\"actual observed outcome\",\"blockedReason\":\"concrete assistance needed when blocked\",\"evidence\":[{\"kind\":\"command or test or http or browser or log\",\"executed\":true,\"action\":\"actual command/request/actions performed\",\"details\":\"exit/result/request-response/log details demonstrating this criterion\",\"exitCode\":0,\"screenshotTasks\":[{\"area\":\"selected area\",\"state\":\"selected state\"}]}]}]}],\"findings\":[{\"id\":\"stable finding ID\",\"rating\":3,\"summary\":\"consequential requirement failure\",\"evidence\":\"concrete receipt\",\"status\":\"open\",\"storyId\":\"planned ID\",\"criterionId\":\"planned criterion ID\",\"requirementRefs\":[\"accepted requirement\"],\"reproduction\":[\"steps\"],\"expected\":\"expected behavior\",\"actual\":\"actual behavior\"}],\"observations\":[{\"id\":\"stable observation ID\",\"summary\":\"optional UI/UX improvement\",\"evidence\":\"observed details\",\"storyId\":\"story ID\"}],\"screenshots\":[{\"path\":\"absolute real image path\",\"caption\":\"what it demonstrates\",\"area\":\"exact area\",\"state\":\"exact state\"}],\"unavailable\":[{\"area\":\"selected area\",\"reason\":\"concrete missing access/tooling/setup or failed behavior\",\"cause\":\"access or product\"}]}.\nOne result per story and criterion. Ratings 2/3 are consequential failures against agreed requirements; keep optional preferences in observations. Product failures are failed with actionable findings. If failed product behavior prevents a selected screenshot, report unavailable with cause:\"product\" linked to that failing story; missing access/tooling uses cause:\"access\". Missing access, fixtures or tooling is blocked with a concrete reason; never pass an unexecuted check. Story outcome must agree with criterion outcomes. Do not supply a revision claim; runtime stamps provenance. Execute criteria freshly on each visit; image reuse never establishes a behavioral pass.\nCapture exactly the selected representative screenshot tasks at their defined points DURING the story flows. Keep the captureBudget (normally 24, justified maximum 48), one real PNG/JPEG per exact area/state. Do not invent states or expand combinations. Save images under the supplied evidence directory with fresh filenames for each revision; inspect actual captures for readability. Keep the complete inventory, including provenance-eligible explicitly accepted unchanged images. Never claim images or checks that do not exist. Stop only servers you started, after all testing and captures finish.{{instruction:video-capture}}{{instruction:impact-capture}}","json":true,"askQuestions":false},{"id":"visual-review","configVersion":"step-config-v1","reads":{"capture":"capture","scope":"visual-scope","scopeClarify":"clarify","scopeDecisions":"decisions","scopePlan":"plan","scopeSource":"@source","scopeTicket":"@ticket"},"output":{"format":"qa-review-v1"},"rules":[{"id":"recovery-reason","message":"Blocked or failed review requires a concrete recovery reason","when":{"path":"/status","notEquals":"completed"},"require":{"any":[{"path":"/blockers","empty":false},{"path":"/summary","empty":false}]}},{"id":"completed-without-blockers","message":"Completed review cannot retain missing-input/tooling blockers","when":{"path":"/status","equals":"completed"},"require":{"path":"/blockers","empty":true}}],"checks":["architecture-revision","qa-review-evidence",{"check":"scope-inputs","sources":{"clarify":"scopeClarify","decisions":"scopeDecisions","plan":"scopePlan","existing-work":"scopeExistingWork","assess-existing":"scopeAssessment","source":"scopeSource","ticket":"scopeTicket"}}],"revision":"bound","access":{"mode":"workspace"},"instructions":["incremental-visual-review","review-completion","video-gate"],"name":"Review QA and screenshots","next":"visual-gate","branches":[],"maxVisits":16,"type":"agent","prompt":"Review the current diff against the accepted plan. Use /contextMemory/reviewLedger and /contextMemory/reviewRounds for ALL distinct historical review findings and fixer responses when available; original rounds remain accessible through source references. Read old output details only when relevant evidence is needed. Use stable finding IDs; do not reopen resolved findings without fresh evidence. A fixer may reject a complaint with evidence; assess that evidence and either accept or reject the rejection with reasoning. Return {\"findings\":[{\"id\":\"stable-id\",\"rating\":2,\"summary\":\"...\",\"evidence\":\"file:line and concrete failure\",\"status\":\"open\"}],\"summary\":\"...\"}. Ratings: 1 nitpick, 2 should fix, 3 must fix. Include unresolved rating 2/3 findings from earlier rounds. Return no findings only when all consequential complaints are resolved or their rejections accepted. Do not modify code.\nThis is a QA AND SCREENSHOT review. Return qaContract:\"qa-v1\" alongside the review fields. Inspect accepted business requirements and expectations, cumulative diff, planned stories, complete criterion coverage, executed test receipts, failures, blocked checks, optional observations and all retained disputes. A screenshot alone cannot prove behavior, and an agent saying passed without actual executed evidence is insufficient. Missing/blocked required QA cannot be approved. Failed required behavior requires a fix and retest even when a fixer rejects a complaint. Corrections to erroneous scenarios must match accepted requirements and record a rationale.\nOpen the actual selected screenshots. Return acceptedScreenshots:[{area,state,imageSha256}] for every individually inspected good image, using its exact supplied hash. Exclude images affected by unresolved findings. Missing critical SELECTED states is rating 3; do not invent larger viewport/language/role matrices. Request only minimum targeted replacements by exact area/state. Preserve explicitly accepted unchanged image receipts and optional observations without making preferences blocking. Return complete current coverage, not merely the latest delta. Do not execute QA again, change code or recapture images.{{instruction:video-gate}}","json":true,"askQuestions":false},{"id":"visual-gate","configVersion":"step-config-v1","reads":{"qaReview":"visual-review","scope":"visual-scope","capture":"capture","review":"visual-review","fix":"visual-fix","scopeClarify":"clarify","scopeDecisions":"decisions","impact":"assess-impact","scopePlan":"plan","scopeSource":"@source","scopeTicket":"@ticket","draftPr":"draft-pr","ci":"ci","guide":"guide","reviewGate":"review-gate","handoff":"handoff","merge":"merge"},"rules":[],"checks":["qa-evidence",{"check":"media-valid","adapter":"qa-gate","video":true},"impact-boundary",{"check":"scope-inputs","sources":{"clarify":"scopeClarify","decisions":"scopeDecisions","plan":"scopePlan","existing-work":"scopeExistingWork","assess-existing":"scopeAssessment","source":"scopeSource","ticket":"scopeTicket"}},"review-evidence","review-assistance","qa-gate-evidence"],"access":{"mode":"workspace"},"instructions":[],"name":"Check QA and screenshots","next":"guide","branches":[{"when":{"path":"qaRetry","equals":true},"next":"capture"},{"when":{"path":"qaBlocked","equals":true},"next":"capture"},{"when":{"path":"captureBlocked","equals":true},"next":"capture"},{"when":{"path":"reviewIncomplete","equals":true},"next":"assess-impact"},{"when":{"path":"reviewBlocked","equals":true},"next":"visual-fix"},{"when":{"path":"approved","equals":false},"next":"visual-fix"}],"maxVisits":200,"type":"check","check":{"results":{"approved":{"all":[{"path":"/evidence/qa-gate-evidence","exists":true},{"path":"/evidence/review-evidence/incomplete","equals":false},{"path":"/evidence/qa-gate-evidence/findings","empty":true},{"path":"/evidence/qa-gate-evidence/evidenceErrors","empty":true},{"path":"/evidence/qa-gate-evidence/evidenceBlocked","empty":true}]},"findings":{"select":"/evidence/qa-gate-evidence/findings"},"reviewIncomplete":{"all":[{"path":"/evidence/review-evidence/incomplete","equals":true},{"path":"/evidence/qa-gate-evidence/findings","empty":true}]},"reviewBlocked":{"path":"/evidence/review-evidence/reviewBlocked","equals":true},"questions":{"select":"/evidence/review-evidence/questions"},"qaContract":{"select":"/evidence/qa-gate-evidence/qaContract"},"observations":{"select":"/evidence/qa-gate-evidence/observations"},"headSha":{"select":"/evidence/qa-gate-evidence/headSha"},"scopeHash":{"select":"/evidence/qa-gate-evidence/scopeHash"},"captureHash":{"select":"/evidence/qa-gate-evidence/captureHash"},"reviewHash":{"select":"/evidence/qa-gate-evidence/reviewHash"},"evidenceIssues":{"select":"/evidence/qa-gate-evidence/evidenceIssues"},"qaRetry":{"select":"/evidence/qa-gate-evidence/qaRetry"},"qaBlocked":{"select":"/evidence/qa-gate-evidence/qaBlocked"},"captureBlocked":{"select":"/evidence/qa-gate-evidence/captureBlocked"}},"passed":{"path":"/results/approved","equals":true}}},{"id":"code-fix","configVersion":"step-config-v1","reads":{"reviewFix":"@reviewFix","reviewGate":"review-gate","publication":"draft-pr","scopeClarify":"clarify","scopeDecisions":"decisions","scopePlan":"plan","scopeSource":"@source","scopeTicket":"@ticket"},"output":{"format":"review-fix-v1"},"rules":[{"id":"architecture-handback","message":"Architecture revision requires status=blocked and questions=[]; the configured proposal route owns review and any required acceptance","when":{"path":"/architectureRevision","equals":true},"require":{"all":[{"path":"/status","equals":"blocked"},{"path":"/questions","exists":true},{"path":"/questions","maxLength":0}]}}],"checks":["architecture-revision","optional-questions","review-dispositions",{"check":"scope-inputs","sources":{"clarify":"scopeClarify","decisions":"scopeDecisions","plan":"scopePlan","existing-work":"scopeExistingWork","assess-existing":"scopeAssessment","source":"scopeSource","ticket":"scopeTicket"}}],"access":{"mode":"push"},"instructions":["incremental-review-fix","review-fix"],"name":"Fix review findings","next":"assess-impact","branches":[],"maxVisits":16,"type":"agent","prompt":"Fix all open rating 2/3 findings. Use /contextMemory/reviewLedger and /contextMemory/reviewRounds for ALL distinct past findings and fixer dispositions when available, reading original source references only when needed; avoid alternating fixes or reopening settled issues without evidence. You may reject a complaint with concrete evidence. Return {\"dispositions\":[{\"id\":\"finding-id\",\"status\":\"fixed or rejected\",\"reason\":\"...\"}],\"summary\":\"...\",\"questions\":[]}. Run relevant checks, commit and push changes to the same draft PR. Do not merge or mark the PR ready.\n{{instruction:review-fix}}","json":true,"askQuestions":false},{"id":"ci-fix","configVersion":"step-config-v1","reads":{"ci":"ci","feedback":"@feedback","mergeReadiness":"@mergeReadiness","publication":"draft-pr","scopeClarify":"clarify","scopeDecisions":"decisions","scopePlan":"plan","scopeSource":"@source","scopeTicket":"@ticket"},"output":{"format":"ci-fix-v1"},"rules":[{"id":"architecture-handback","message":"Architecture revision requires status=blocked and questions=[]; the configured proposal route owns review and any required acceptance","when":{"path":"/architectureRevision","equals":true},"require":{"all":[{"path":"/status","equals":"blocked"},{"path":"/questions","exists":true},{"path":"/questions","maxLength":0}]}}],"checks":["architecture-revision","optional-questions","feedback-assessment",{"check":"scope-inputs","sources":{"clarify":"scopeClarify","decisions":"scopeDecisions","plan":"scopePlan","existing-work":"scopeExistingWork","assess-existing":"scopeAssessment","source":"scopeSource","ticket":"scopeTicket"}}],"access":{"mode":"push"},"instructions":["incremental-ci-fix","ci-fix-runtime","ci-assessment"],"name":"Fix CI failures","next":"after-ci-fix-observe","branches":[],"maxVisits":16,"type":"agent","prompt":"Diagnose and fix CI failures, merge conflicts, stale branches and actionable PR review comments in the supplied merge-readiness receipt and full history. Fetch the base before resolving conflicts. For each supplied unresolved review thread, address it or post an evidence-backed response before resolving it using the selected Git provider (GitHub: write a token-free JSON request file with method POST, path graphql and body {query,variables}, set repoUrl to the selected HTTPS repository URL and requestFile to that file, then run sh -c \"$BOBS_FACTORY_GITHUB_CREDENTIAL_COMMAND github-api \\\"\\$@\\\"\" bobs-factory --repo \"$repoUrl\" --request \"$requestFile\" with the resolveReviewThread mutation; GitLab: glab api PUT the MR discussion with resolved=true; custom: the configured adapter). Do not dismiss reviews or bypass rules. Required reviewer approvals must wait for the reviewer; do not impersonate one. Assess every supplied new PR comment. Act on requested corrections or document why a comment is informational. Record its ID in addressedCommentIds after assessment, and include disposition/reason in the summary. Add <!-- generated-by-bobs-factory --> to any PR reply you write. Retain all discussion and report addressed comment/thread IDs. Run relevant checks, commit and push to the same draft PR. Return {\"summary\":\"...\",\"checks\":[\"...\"],\"addressedReviewIds\":[\"review IDs\"],\"addressedCommentIds\":[\"comment IDs\"]}. Do not merge or mark ready.{{instruction:ci-assessment}}","json":true,"askQuestions":false},{"id":"after-ci-fix-observe","configVersion":"step-config-v1","reads":{"draftPr":"draft-pr","ci":"ci","guide":"guide","reviewGate":"review-gate","handoff":"handoff","merge":"merge","qaReview":"visual-review","capture":"capture","scope":"visual-scope","qaGate":"visual-gate","fix":"ci-fix","impact":"assess-impact","scopeClarify":"clarify","scopeDecisions":"decisions","scopePlan":"plan","scopeSource":"@source","scopeTicket":"@ticket"},"rules":[],"checks":["impact-boundary",{"check":"scope-inputs","sources":{"clarify":"scopeClarify","decisions":"scopeDecisions","plan":"scopePlan","existing-work":"scopeExistingWork","assess-existing":"scopeAssessment","source":"scopeSource","ticket":"scopeTicket"}}],"access":{"mode":"workspace"},"instructions":[],"name":"Inspect current review and provider evidence","next":"after-ci-fix","branches":[],"maxVisits":200,"type":"tool","tool":"inspect-review-readiness","args":[]},{"id":"after-ci-fix","configVersion":"step-config-v1","reads":{"draftPr":"draft-pr","ci":"ci","guide":"guide","reviewGate":"review-gate","handoff":"handoff","merge":"merge","qaReview":"visual-review","capture":"capture","scope":"visual-scope","qaGate":"visual-gate","fix":"ci-fix","impact":"assess-impact","scopeClarify":"clarify","scopeDecisions":"decisions","scopePlan":"plan","scopeSource":"@source","scopeTicket":"@ticket","observation":"after-ci-fix-observe","observations":"after-ci-fix-observe/observations"},"rules":[],"checks":["impact-boundary",{"check":"scope-inputs","sources":{"clarify":"scopeClarify","decisions":"scopeDecisions","plan":"scopePlan","existing-work":"scopeExistingWork","assess-existing":"scopeAssessment","source":"scopeSourc