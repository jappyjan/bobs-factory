import {spawn,execFileSync} from 'node:child_process';
import {createHash} from 'node:crypto';
import {mkdirSync,writeFileSync,readFileSync,openSync,closeSync,readlinkSync} from 'node:fs';
const cwd='/Users/jappy/.t3/worktrees/bobs-factory/taskbot-140-views';
const out='/tmp/taskbot140-round6-complete-validation';mkdirSync(out,{recursive:true,mode:0o700});
const git=(...args)=>execFileSync('git',args,{cwd,encoding:'utf8'}).trim();
const head=git('rev-parse','HEAD');
if(!process.env.EXPECTED_HEAD||process.env.EXPECTED_HEAD!==head)throw Error('Expected exact frozen head');
if(git('status','--short'))throw Error('Frozen checkout must be clean');
const pointer='docs/run-backups/manual-ca2bb7eb-c67e-4b8b-ac2f-1e62bf6cad37/run-backup.zip';
const files=git('ls-files','-s').split('\n').map(line=>{const [meta,path]=line.split('\t');return {path,mode:meta.split(' ')[0]};}).filter(({path})=>!path.startsWith('apps/f1/test-drives/')&&!path.startsWith('CHANGELOG'));
const hash=bytes=>createHash('sha256').update(bytes).digest('hex');
const fileBytes=(path,mode)=>path===pointer?execFileSync('git',['show',`${head}:${path}`],{cwd}):mode==='120000'?Buffer.from(readlinkSync(`${cwd}/${path}`)):readFileSync(`${cwd}/${path}`);
const manifest=()=>files.map(({path,mode})=>({path,mode,bytes:fileBytes(path,mode).length,sha256:hash(fileBytes(path,mode)),...(path===pointer?{nonRuntimeGitLfsPointer:true}:{} )}));
const initial=manifest(), fingerprint=hash(JSON.stringify(initial));
writeFileSync(`${out}/source-inputs.json`,JSON.stringify({head,tree:git('rev-parse','HEAD^{tree}'),fingerprint,files:initial,nonRuntimeLfs:'Literal unchanged Git LFS pointer only; hydrated private backup is not read/exported or a build/runtime/resource input.'},null,2));
const receipt={head,tree:git('rev-parse','HEAD^{tree}'),base:git('merge-base','HEAD','origin/main'),branch:git('branch','--show-current'),cwd,node:process.version,pid:process.pid,startedAt:new Date().toISOString(),sourceFingerprint:fingerprint,commands:[],result:'running'};
const save=()=>writeFileSync(`${out}/gates.json`,JSON.stringify(receipt,null,2));save();
let child, stopping=false;
for(const sig of ['SIGINT','SIGTERM'])process.on(sig,()=>{stopping=true;receipt.stopSignal=sig;save();if(child)try{process.kill(-child.pid,sig);}catch{}});
const binary='/tmp/taskbot140-round6-native-build/bobs-factory-1.0.0-beta-darwin-arm64/bobs-factory';
const commands=[
 ['install','pnpm',['install','--frozen-lockfile'],{}],
 ['audit','pnpm',['audit','--json'],{}],
 ['build','pnpm',['build'],{}],
 ['typecheck','pnpm',['typecheck'],{}],
 ['lint','pnpm',['lint'],{}],
 ['f1','node',['apps/f1/test-drives/assets/taskbot140-views-round6.mjs'],{F1_AGENT_MODE:'mock',F1_EXPECTED_SOURCE_COMMIT:head}],
 ['f1-dispatch','node',['apps/f1/test-drives/assets/taskbot140-dispatch-round6.mjs'],{F1_AGENT_MODE:'mock',F1_EXPECTED_SOURCE_COMMIT:head}],
 ['f1-assets','node',['apps/f1/test-drives/assets/taskbot140-history-assets-round6.mjs'],{F1_AGENT_MODE:'mock',F1_EXPECTED_SOURCE_COMMIT:head}],
 ['f1-native-queue','node',['apps/f1/test-drives/assets/taskbot140-native-delivery-round6.mjs'],{F1_AGENT_MODE:'mock',F1_EXPECTED_SOURCE_COMMIT:head}],
 ['packages','pnpm',['test:packages:run'],{VITEST_MAX_WORKERS:'1',npm_config_workspace_concurrency:'1'}],
 ['apps','pnpm',['--workspace-concurrency=1','-r','--filter','./apps/*','test:run'],{VITEST_MAX_WORKERS:'1'}],
 ['scripts','/bin/zsh',['-f','-c','node --test --test-concurrency=2 scripts/tests/*.test.mjs'],{}],
 ['native-build','bun',['run','scripts/build-binary.ts','--target','darwin-arm64','--output','/tmp/taskbot140-round6-native-build'],{}],
 ['native-standard-smoke','/bin/bash',['scripts/smoke-binary.sh',binary],{BOBS_FACTORY_SMOKE_PORT:'46508'}],
 ['native-views','node',['apps/f1/test-drives/assets/taskbot140-views-native.mjs','--binary',binary,'--output','/tmp/taskbot140-round6-native-views'],{}],
];
for(const [name,command,args,env] of commands){
 if(stopping)break;
 if(hash(JSON.stringify(manifest()))!==fingerprint||git('rev-parse','HEAD')!==head)throw Error('Frozen source drift before '+name);
 const path=`${out}/${name}.log`, fd=openSync(path,'wx');
 const row={name,command,args,env,log:path,startedAt:new Date().toISOString()};receipt.commands.push(row);save();console.log(JSON.stringify({phase:'start',...row}));
 const result=await new Promise((resolve,reject)=>{child=spawn(command,args,{cwd,env:{...process.env,...env},stdio:['ignore',fd,fd],detached:true});row.pid=child.pid;save();child.once('error',reject);child.once('close',(code,signal)=>resolve({code,signal}));});
 closeSync(fd);child=undefined;Object.assign(row,result,{finishedAt:new Date().toISOString(),bytes:readFileSync(path).length,sha256:hash(readFileSync(path)),sourceAfter:hash(JSON.stringify(manifest()))});save();console.log(JSON.stringify({phase:'finish',...row}));
 if(result.code!==0||result.signal||row.sourceAfter!==fingerprint){receipt.result=stopping?'stopped':'fail';break;}
}
receipt.finishedAt=new Date().toISOString();if(receipt.result==='running')receipt.result=stopping?'stopped':'pass';receipt.finalStatus=git('status','--short');save();console.log(JSON.stringify({result:receipt.result,out,head}));process.exitCode=receipt.result==='pass'?0:1;
