import assert from 'node:assert/strict';
import {randomUUID} from 'node:crypto';
import {mkdtempSync,writeFileSync,mkdirSync,realpathSync} from 'node:fs';
import {tmpdir} from 'node:os';
import {join} from 'node:path';
const root='/Users/jappy/.t3/worktrees/bobs-factory/taskbot-140-review-r2';
const {defaultWorkflows}=await import(root+'/packages/edge-worker/dist/factory/defaultWorkflows.js');
const {WorkflowRuntime}=await import(root+'/packages/edge-worker/dist/factory/WorkflowRuntime.js');
const {validateWorkflows}=await import(root+'/packages/edge-worker/dist/factory/Workflow.js');
const {CodexRunner}=await import(root+'/packages/codex-runner/dist/CodexRunner.js');
const {publicFailure}=await import(root+'/packages/core/dist/index.js');
const wait=async(fn)=>{const deadline=Date.now()+10000;while(!fn()){if(Date.now()>deadline)throw Error('Probe timeout');await new Promise(r=>setTimeout(r,10));}};
const results=[];
for(const mode of ['answer','native-error']) {
 const home=realpathSync(mkdtempSync(join(tmpdir(),'taskbot140-r2-probe-')));
 const published=[];
 const runtime=new WorkflowRuntime(home,{agent:async()=> {
  if(mode==='answer')return 'CURRENT_PUBLIC_ANSWER';
  const cwd=join(home,'empty');mkdirSync(cwd,{mode:0o700});
  const runner=new CodexRunner({workingDirectory:cwd,factoryHome:home,toolProfile:'context-only',codexHome:join(home,'codex'),codexPath:join(home,'private-provider-name','codex-unavailable'),childEnvironment:{HOME:home,PATH:'/usr/bin:/bin'},mcpConfig:{'factory-context':{command:'/usr/bin/true'}}});
  runner.on('error',()=>{});
  await runner.start('This must never reach a model');
  const result=runner.getMessages().filter(x=>x.type==='result').at(-1);
  assert.equal(result.is_error,true);
  throw new Error('Agent step failed: '+publicFailure(JSON.stringify(result)));
 },tool:async()=>{throw Error('Unexpected tool');},script:async()=>{throw Error('Unexpected script');},viewDecision:async(_run,text)=>published.push(text)});
 const definitions=validateWorkflows([...defaultWorkflows,{id:'probe',name:'Probe',stepConfigVersion:'step-config-v1',steps:[{id:'choose',name:'Choose',type:'decide',view:{version:'view-v1',components:[{id:'brief',type:'markdown',data:{literal:{text:'Public view'}}}]},decide:{items:{literal:[{id:'a',title:'Public item'}]},actions:[{id:'skip',label:'Skip'}],ask:{prompt:'Explain context only'}}}]}]);
 runtime.updateWorkflows(definitions);
 const run=runtime.create({repositoryId:'probe',workspace:home,input:'Controlled probe',workflow:definitions.at(-1),workflowDefinitions:definitions,triggerOrigin:{type:'manual',workflowId:'probe'}});
 void runtime.launch(run);
 await wait(()=>run.status==='waiting'&&published.length===1);
 const before=structuredClone(run.viewDecision);
 await runtime.askView(run.id,{batchId:before.id,digest:before.digest,itemId:'a',question:'CURRENT_PUBLIC_QUESTION',requestId:randomUUID()});
 await wait(()=>['answered','failed'].includes(run.viewDecision.threads?.a?.[0]?.status));
 const current=structuredClone(run.viewDecision),text=runtime.humanViews.displayText(run);
 const row={mode,home,batch:before.id,initialDigest:before.digest,currentDigest:current.digest,status:current.threads.a[0].status,publishedCount:published.length,publishedHasCurrentDigest:published.at(-1).includes(current.digest),publishedHasQuestion:published.at(-1).includes('CURRENT'),dynamicTextHasQuestion:text.includes('CURRENT'),publicThread:current.threads.a[0],dynamicText:text};
 assert.notEqual(before.digest,current.digest);
 assert.equal(row.publishedCount,1);
 assert.equal(row.publishedHasCurrentDigest,false);
 // Native-error hypothesis is recorded without assuming private-path disclosure.
 results.push(row);
 await runtime.flush(run.id);await runtime.shutdown();
}
writeFileSync('/tmp/taskbot140-review-r2/probe-results.json',JSON.stringify(results,null,2));
console.log(JSON.stringify(results.map(({dynamicText,publicThread,...r})=>({...r,publicError:publicThread.error})),null,2));
