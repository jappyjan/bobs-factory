import json,hashlib,copy,subprocess
from pathlib import Path
root=Path.cwd()
old_path=Path('apps/f1/test-drives/assets/taskbot140-views/ui/repairs/identity.json')
old=json.loads(old_path.read_text());new=json.loads(Path('/tmp/taskbot140-round3-ui/identity.json').read_text())
sha=lambda b:hashlib.sha256(b).hexdigest()
proof={'claim':'Reuse original12 component and8 builder appearance screenshots only. Fresh changed backend/text/failure evidence is separate; no backend/approval/native/digest equivalence is inferred.','head':subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip(),'originalIdentity':str(old_path),'currentIdentity':'/tmp/taskbot140-round3-ui/identity.json','byteIdenticalSources':{},'projections':[],'images':[],'limits':['Only id/digest/createdAt snapshot roots and run-list wave/child identity href keys are normalized. All visible text,statuses,actions,components and bindings remain exact.','Builder images reuse only unchanged renderer/controller appearance inputs; current backend tests/F1/native are fresh.','Current three failure/answer browser images and360audits are new; old complete builder interaction protocol was not replayed.']}
inputs=['declarative-view.tsx','declarative-view.css','focus.tsx','styles.css','app.tsx','human-step-settings.tsx','human-preview-session.ts','recipe-builder.tsx','recipe-graph.ts']
old_inputs=json.loads(Path('apps/f1/test-drives/assets/taskbot140-views/round2/gates/source-inputs.json').read_text())['files'];old_hash={x['path']:x['sha256'] for x in old_inputs}
for name in inputs:
 p='packages/edge-worker/src/factory/web/'+name
 if not Path(p).exists(): continue
 current=sha(Path(p).read_bytes());assert current==old_hash[p],p
 proof['byteIdenticalSources'][p]=current

def norm(snapshot):
 value=copy.deepcopy(snapshot)
 for key in ['id','digest','createdAt']:value.pop(key,None)
 for component in value.get('view',{}).get('components',[]):
  if component['type']=='runList':
   for wave in component['data']['waves']:
    wave.pop('id',None)
    for run in wave['runs']:run.pop('id',None)
 return value
for kind in ['decide','approve','runs']:
 a=old['original']['runs'][kind];b=new['original']['runs'][kind]
 assert a['status']==b['status']=='waiting'
 assert norm(a['decision'])==norm(b['decision']),kind
 proof['projections'].append({'kind':kind,'projection':'decision','normalizedSha256':sha(json.dumps(norm(a['decision']),sort_keys=True,separators=(',',':')).encode())})
 if kind=='runs':
  a=[norm(x['snapshot']) for x in a['records'] if x['snapshot']['kind']=='show'];b=[norm(x['snapshot']) for x in b['records'] if x['snapshot']['kind']=='show'];assert a==b
  proof['projections'].append({'kind':'runs','projection':'Show','normalizedSha256':sha(json.dumps(a,sort_keys=True,separators=(',',':')).encode())})
assert old['assets']==new['assets']
proof['shell']=new['build'];proof['shellAssets']=new['assets']
for directory in [Path('apps/f1/test-drives/assets/taskbot140-views/ui/final'),Path('apps/f1/test-drives/assets/taskbot140-views/round2/ui')]:
 for p in sorted(directory.rglob('*.png')):
  if directory.name=='final' and not p.name.startswith(('approve-','decide-','run-list-')):continue
  proof['images'].append({'path':str(p),'bytes':p.stat().st_size,'sha256':sha(p.read_bytes())})
proof['result']='PASS'
Path('/tmp/taskbot140-round3-ui-reuse.json').write_text(json.dumps(proof,indent=2)+'\n')
print(json.dumps({'result':'PASS','inputCount':len(proof['byteIdenticalSources']),'projections':len(proof['projections']),'images':len(proof['images']),'shell':proof['shell']}))
