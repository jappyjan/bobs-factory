let holdPreview = false;
let previewSequence = 0;
const pendingPreviews = new Map();
const previewRequests = new Map();
const releasePreview = (id) => {
	const targets = id
		? [pendingPreviews.get(Number(id))].filter(Boolean)
		: [...pendingPreviews.values()];
	if (!id) holdPreview = false;
	for (const pending of targets) {
		pending.event.releasedAt = new Date().toISOString();
		pendingPreviews.delete(pending.event.id);
		pending.release();
	}
	save();
	console.log(
		JSON.stringify({
			previewGate: "released",
			ids: targets.map(({ event }) => event.id),
			pending: [...pendingPreviews.keys()],
		}),
	);
};
const launchServer = async () => {
