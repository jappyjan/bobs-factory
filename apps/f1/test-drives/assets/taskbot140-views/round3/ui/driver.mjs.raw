const hooks = {
	prepare: async (run) => {
		assert(
			Object.values(ids).includes(run.id) ||
				run.recipeParent?.runId === ids.runs,
			"Only exact disposable fixture runs execute",
		);
		if (run.workspace) return;
		const workspace = join(directory, "worktrees", run.id);
		mkdirSync(join(directory, "worktrees"), { recursive: true });
		git(
			repositoryPath,
			"worktree",
			"add",
			"-b",
			`fixture/${run.id}`,
			workspace,
			"main",
		);
		run.workspace = workspace;
		run.repositories = run.repositories.map((repo) => ({ ...repo, workspace }));
		run.setupComplete = true;
		prepared.push({
			runId: run.id,
			workspace,
			revision: git(workspace, "rev-parse", "HEAD"),
		});
		await runtime.save(run);
		await runtime.flush(run.id);
	},
	agent: async (context) => {
		calls.push({
			runId: context.run.id,
			step: context.step.id,
			key: context.stepKey,
			at: new Date().toISOString(),
