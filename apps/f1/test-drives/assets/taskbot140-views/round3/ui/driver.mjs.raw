			],
			sessions: () => [],
			entries: () => [],
			start: blocked,
			stop: (id) => runtime.stop(id),
			defaultRunner: () => "claude",
		},
		factoryAccess(port),
	);
	// Delay only this real authenticated endpoint. The production handler still
	// resolves the actual accepted input snapshot and returns its own response.
	server.app.addHook("preHandler", async (request) => {
		if (
			request.method !== "POST" ||
			request.url !== "/api/recipes/view-preview"
		)
			return;
		const body = JSON.stringify(request.body);
		const event = {
			id: ++previewSequence,
			requestedAt: new Date().toISOString(),
			held: holdPreview,
			requestBody: request.body,
			requestSha256: hash(body),
		};
		receipt.previewGate.push(event);
		previewRequests.set(request.id, event);
		save();
		if (holdPreview) {
			console.log(
				JSON.stringify({
					previewGate: "held",
					id: event.id,
					requestSha256: event.requestSha256,
				}),
			);
			await new Promise((release) =>
				pendingPreviews.set(event.id, { event, release }),
			);
		}
		event.handlerStartedAt = new Date().toISOString();
		event.requestStreamAborted = request.raw.aborted;
		save();
	});
	server.app.addHook("onSend", async (request, reply, payload) => {
		const event = previewRequests.get(request.id);
		if (!event) return payload;
		event.responseAt = new Date().toISOString();
		event.status = reply.statusCode;
		event.responseStreamDestroyed = reply.raw.destroyed;
		if (typeof payload === "string") {
			event.responseSha256 = hash(payload);
			try {
				event.response = JSON.parse(payload);
			} catch {
				event.nonJsonResponse = true;
			}
		}
		previewRequests.delete(request.id);
		save();
		return payload;
	});
	await server.start(port);
};
const observation = () => ({
	at: new Date().toISOString(),
	calls: [...calls],
	notifications: [...notifications],
	prepared: [...prepared],
	runs: Object.fromEntries(
		Object.entries(ids).map(([kind, id]) => {
			const run = runtime.get(id);
			return [
				kind,
				{
					id,
					status: run.status,
					error: run.error,
					decision: run.viewDecision,
					displays: run.viewDisplays,
					outputs: run.outputs,
					history: run.history,
					records: run.viewRecords?.map(({ snapshot, answer }) => ({
						snapshot,
						answer,
					})),
					batches: Object.fromEntries(
						Object.entries(run.launchActions ?? {}).map(([key, batch]) => [
							key,
							launchBatchProjection(batch),
						]),
					),
				},
			];
		}),
	),
});
const record = () => {
	const observed = observation();
	receipt.observations.push(observed);
	save();
	return observed;
};
const request = async (path, body) => {
	const response = await fetch(origin + path, {
		method: body ? "POST" : "GET",
		headers: {
			"Content-Type": "application/json",
			"X-Factory-Request": "1",
			"X-Factory-Build": shell.build,
			Origin: origin,
		},
		...(body ? { body: JSON.stringify(body) } : {}),
	});
	const result = await response.json();
	receipt.apiEvents.push({
		at: new Date().toISOString(),
		path,
		body,
		status: response.status,
		result,
	});
	save();
	return { status: response.status, result };
};
const verify = async () => {
	const choose = runtime.get(ids.decide),
		artifact = runtime.get(ids.approve);
	assert.equal(
		calls.filter(
			(call) => call.runId === ids.decide && call.step === "research",
		).length,
		1,
		"Ask does not rerun research",
	);
	assert.equal(
		calls.filter((call) => call.step === "view-follow-up").length,
		1,
		"Exactly one dedicated follow-up",
	);
	assert(
		choose.viewDecision?.answer,
		"Dashboard submitted a retained decision",
	);
	assert.equal(choose.outputs.choose.hasFollowUps, true);
	assert(
		choose.history.some((entry) => entry.step === "followups"),
		"Ordinary hasFollowUps route executed",
	);
	assert(
		!choose.history.some((entry) => entry.step === "finished"),
		"Fallback route did not execute",
	);
	assert.deepEqual(
		choose.outputs.research.items,
		findings,
		"Accepted source research is unchanged",
	);
	assert(
		artifact.viewDecision?.answer,
		"Dashboard submitted an approval answer",
	);
	for (const id of Object.values(ids)) {
		const seen = new Set();
		for (const notification of notifications.filter(
			(entry) => entry.runId === id,
		)) {
			assert(
				!seen.has(notification.text),
				"No duplicate notification text for this fixture run",
			);
			seen.add(notification.text);
		}
	}
	const original = choose.viewRecords.find((entry) => entry.answer);
	const repeats = await Promise.all([
		request(`/api/runs/${ids.decide}/view-answer`, original.answer.request),
		request(`/api/runs/${ids.decide}/view-answer`, original.answer.request),
	]);
	assert(
		repeats.every((response) => response.status === 200),
		"Identical accepted submissions are idempotent",
	);
	assert.deepEqual(
		choose.viewDecision.answer,
		original.answer.output,
		"Retries preserve original accepted output",
	);
	receipt.assertions.push(
		"Dashboard choices produced itemsByAction/followUps/hasFollowUps and the ordinary configured route",
		"Dedicated Ask executed once without repeating source research",
		"Accepted answers and source outputs retained; concurrent identical retries idempotent",
		"Decision notifications deduplicated by durable batch identity",
	);
	record();
	console.log(
		JSON.stringify({
			verified: true,
			sourceCalls: calls.length,
			notifications: notifications.length,
		}),
	);
};
const close = async (code = 0) => {
	releasePreview();
	if (stopping) return;
	stopping = true;
	if (runtime && Object.values(ids).every((id) => runtime.runs.has(id)))
		record();
	await runtime?.shutdown();
	await server?.stop();
	receipt.stoppedAt = new Date().toISOString();
	save();
	console.log(
		`${code ? "FAIL" : "PASS"} declarative views UI fixture stopped; disposable state retained`,
	);
	process.exit(code);
};
process.once("SIGTERM", () => void close());
process.once("SIGINT", () => void close());
try {
	await launchServer();
	const definitions = validateWorkflows([
		...runtime.listWorkflows(),
		...recipes,
	]);
	runtime.updateWorkflows(definitions);
	for (const [kind, id] of Object.entries(ids)) {
		const recipeId = kind === "runs" ? "views-runs-ui" : `views-${kind}-ui`;
		const run = runtime.create({
			id,
			repositoryId: "ui-project",
			repositories: [
				{
					id: "ui-project",
					name: "Disposable views project",
					repositoryPath,
					workspace: "",
					baseBranch: "main",
				},
			],
			workspace: "",
			workflow: definitions.find((definition) => definition.id === recipeId),
			workflowDefinitions: definitions,
			input: "Scripted declarative view browser verification",
			triggerOrigin: {
				type: "manual",
				workflowId: recipeId,
				at: new Date().toISOString(),
			},
		});
		runtime.updateTitle(
			run.id,
			run.titleGeneration,
			kind === "decide"
				? "Review findings · choose next work"
				: kind === "approve"
					? "Delivery brief · exact content approval"
					: "Independent work · dependency waves",
		);
		void runtime.launch(run);
	}
	await waitFor(
		() =>
			Object.values(ids).every((id) => runtime.get(id).status === "waiting") &&
			runtime
				.get(ids.runs)
				.viewDisplays?.some((display) =>
					display.view.components.some(
						(component) => component.type === "runList",
					),
				),
		"real human waits and generic run-list Show",
	);
	for (const id of Object.values(ids)) await runtime.flush(id);
	receipt.original = observation();
	receipt.readyAt = new Date().toISOString();
	receipt.assertions.push(
		"Saved generic custom recipes reached actual Decide/Approve and nonblocking Show through production runtime",
		"Agent emitted and validated a view-v1 artifact consumed via an explicit declared binding",
		"Launch runs created three real child worktrees with waiting/running/completed and queued/blocked dependency states",
		"Generic runList Show resolved only the explicit public @childRuns projection",
	);
	save();
	console.log(
		JSON.stringify({
			ready: true,
			origin,
			urls: receipt.urls,
			builderUrl: receipt.builderUrl,
			evidence,
			directory,
			build: shell.build,
		}),
	);
	createInterface({ input: process.stdin }).on("line", (line) => {
		if (line === "hold-preview") {
			holdPreview = true;
			console.log(
				JSON.stringify({
					previewGate: "holding",
					pending: [...pendingPreviews.keys()],
				}),
			);
		}
		if (line === "release-preview" || line.startsWith("release-preview "))
			releasePreview(line.split(" ")[1]);
		if (line === "exit") void close();
		if (line === "status") console.log(JSON.stringify(record()));
		if (line.startsWith("record ")) {
			receipt.browser.push({
				at: new Date().toISOString(),
				...JSON.parse(line.slice(7)),
			});
			save();
			console.log("Browser receipt retained");
		}
		if (line === "verify")
			void verify().catch(async (error) => {
				receipt.error = error.stack;
				console.error(error.stack);
				await close(1);
			});
		if (line === "restart" && !restarting) {
			restarting = true;
			void (async () => {
				const before = observation(),
					accepted = Object.fromEntries(
						Object.values(ids).map((id) => [
							id,
							JSON.stringify(runtime.get(id).viewRecords),
						]),
					),
					notificationCount = notifications.length;
				for (const id of Object.values(ids)) await runtime.flush(id);
				await runtime.shutdown();
				await server.stop();
				await launchServer();
				for (const id of Object.values(ids))
					assert.equal(
						JSON.stringify(runtime.get(id).viewRecords),
						accepted[id],
						"Real reconstruction preserves original snapshots and answers exactly",
					);
				runtime.resumeAll();
				await delay(300);
				assert.equal(
					notifications.length,
					notificationCount,
					"Restart cannot duplicate decision notices",
				);
				receipt.restarts.push({
					at: new Date().toISOString(),
					before,
					after: observation(),
				});
				save();
				console.log(
					JSON.stringify({
						restarted: true,
						notifications: notifications.length,
						decisions: Object.fromEntries(
							Object.entries(ids).map(([kind, id]) => [
								kind,
								runtime.get(id).viewDecision,
							]),
						),
					}),
				);
			})()
				.catch(async (error) => {
					receipt.error = error.stack;
					console.error(error.stack);
					await close(1);
				})
				.finally(() => {
					restarting = false;
				});
		}
	});
} catch (error) {
	receipt.error = error instanceof Error ? error.stack : String(error);
	console.error(receipt.error);
	save();
	await close(1);
}
