                const runner=new CodexRunner({factoryHome:home,workingDirectory:cwd,toolProfile:"context-only",codexHome:join(directory,"synthetic-native-home"),codexPath:join(directory,"private-provider-name","codex-unavailable"),childEnvironment:{HOME:join(directory,"synthetic-native-home"),PATH:"/usr/bin:/bin"},mcpConfig:{"factory-context":{command:"/usr/bin/true"}}});
                runner.on("error",()=>{});await runner.start("No executable; no model calls");
                const result=runner.getMessages().filter(message=>message.type==="result").at(-1);
                assert(result.is_error);throw Error(`Agent step failed: ${publicFailure(JSON.stringify(result))}`);
            }

