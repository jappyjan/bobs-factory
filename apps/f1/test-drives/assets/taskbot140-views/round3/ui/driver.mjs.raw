						note: "Original stock screens remain unchanged.",
					},
					"What changes",
				),
				literal(
					"checks",
					"checklist",
					{
						items: [
							{ label: "Schema validation on save and render", state: "done" },
							{ label: "Exact human acceptance", state: "open" },
						],
					},
					"Acceptance",
				),
				literal(
					"proof",
					"table",
					{
						columns: ["Area", "Evidence"],
						rows: [
							["Source", "Declared inputs only"],
							["Approval", "Displayed content digest"],
							["Malicious strings", "Inert text"],
						],
					},
					"Evidence",
				),
				literal(
					"code",
					"code",
					{
						file: "src/example.ts",
						language: "typescript",
						startLine: 1,
						excerpt:
							'const inert = "<script>window.__viewAttack=1</script>";\n// ' +
							"long-safe-token-".repeat(30),
					},
					"Code reference",
				),
				literal(
					"measure",
					"chart",
					{
						kind: "bar",
						unit: "cases",
						series: [
							{ label: "Inert strings", value: 3 },
							{ label: "Accepted decisions", value: 0 },
						],
					},
					"Validation overview",
				),
				literal(
					"stages",
					"steps",
					{
						items: [
							{ label: "Compose artifact", status: "completed" },
							{ label: "Human review", status: "running" },
							{ label: "Retain exact answer", status: "pending" },
						],
					},
					"Review stages",
				),
				literal(
