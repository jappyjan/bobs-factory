								type: "checkbox",
								required: true,
							},
						],
					},
					"Review context",
				),
			);
		}
		if (context.run.id === ids.runs) {
			if (context.step.id === "propose") return { items: runItems };
			assert.equal(context.step.id, "observe");
			await waitFor(() => {
				const batch = childBatch();
				return (
					batch?.progress.readiness.status === "waiting" &&
					batch.progress.runtime.status === "running" &&
					batch.progress.documentation.status === "completed" &&
					batch.progress.integration.status === "queued" &&
					batch.progress.followup.status === "blocked"
				);
			}, "genuine child statuses");
			return { observed: true };
		}
		assert.equal(context.run.recipeParent?.runId, ids.runs);
		const item = context.run.recipeParent.itemId;
		if (item === "readiness")
			return { questions: ["Confirm the dependency readiness plan?"] };
		if (item === "documentation")
			return {
				questions: [],
				complete: true,
				summary: "Completed without claiming provider merge proof.",
			};
		assert.equal(item, "runtime", "Queued and blocked children cannot execute");
		await new Promise((resolveWait) =>
			context.signal.aborted
				? resolveWait()
				: context.signal.addEventListener("abort", resolveWait, { once: true }),
		);
		return { questions: [], stopped: true };
	},
	script: blocked,
	tool: blocked,
	viewDecision: async (run, text) => {
		notifications.push({
