								id: "bounded",
								title: "Bounded data scope",
								body: "Only explicitly declared inputs reach this view.",
								details: [{ label: "Source", value: "Accepted agent output" }],
							},
						],
					},
					"Artifact details",
				),
				literal(
					"summary-actions",
