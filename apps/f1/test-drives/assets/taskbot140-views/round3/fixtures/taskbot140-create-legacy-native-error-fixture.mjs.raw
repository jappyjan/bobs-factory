import {mkdtempSync,mkdirSync,cpSync,writeFileSync,readFileSync,readdirSync,realpathSync} from 'node:fs';
import {tmpdir} from 'node:os';import {join,resolve} from 'node:path';import {createHash,randomUUID} from 'node:crypto';import {execFileSync} from 'node:child_process';
const repo=process.cwd();const {WorkflowRuntime}=await import(repo+'/packages/edge-worker/dist/factory/WorkflowRuntime.js');const {defaultWorkflows}=await import(repo+'/packages/edge-worker/dist/factory/defaultWorkflows.js');const {validateWorkflows}=await import(repo+'/packages/edge-worker/dist/factory/Workflow.js');const {taskbotSource}=await import(repo+'/packages/edge-worker/dist/factory/TicketTracking.js');
const {CodexRunner}=await import(repo+'/packages/codex-runner/dist/CodexRunner.js');const {publicFailure}=await import(repo+'/packages/core/dist/index.js');
const out=join(repo,'packages/edge-worker/test/fixtures/taskbot140-legacy-views');mkdirSync(out,{recursive:true});
const sha=x=>createHash('sha256').update(x).digest('hex');const wait=async f=>{const deadline=Date.now()+5000;while(!f()){if(Date.now()>deadline)throw Error('Fixture generation timeout');await new Promise(r=>setTimeout(r,5));}};
const provenance={source:'66668d8fffc63fc5dfcb37c9940f123491cd4c0f',publishedEquivalent:'339f0573f2b4bac37accf1783a552ddb08e0fd26',createdAt:new Date().toISOString(),driverSha256:sha(readFileSync(import.meta.filename)),compiled:{},fixtures:[]};for(const file of ['ViewRuntime.js','WorkflowRuntime.js','HumanStep.js'])provenance.compiled[file]=sha(readFileSync(join(repo,'packages/edge-worker/dist/factory',file)));
for(const mode of ['raw-native-failure']){
 const home=realpathSync(mkdtempSync(join(tmpdir(),'taskbot140-old-store-')));let entered=false,release;
 const held=new Promise((_,reject)=>{release=()=>reject(Error('Synthetic process interruption after persisted original checkpoint'));});held.catch(()=>{});
 const runtime=new WorkflowRuntime(home,{agent:async()=> {const cwd=join(home,'empty');mkdirSync(cwd,{mode:0o700});const runner=new CodexRunner({workingDirectory:cwd,factoryHome:home,toolProfile:'context-only',codexHome:join(home,'codex'),codexPath:join(home,'private-provider-name','codex-unavailable'),childEnvironment:{HOME:home,PATH:'/usr/bin:/bin'},mcpConfig:{'factory-context':{command:'/usr/bin/true'}}});runner.on('error',()=>{});await runner.start('Must not invoke a model');const result=runner.getMessages().filter(x=>x.type==='result').at(-1);throw Error('Agent step failed: '+publicFailure(JSON.stringify(result)));},tool:async()=>{throw Error('No tools')},script:async()=>{throw Error('No scripts')},track:async()=>{}});
 if(mode==='notified-crash-gap')runtime.publishViewDecision=async()=>{entered=true;await held;};
 const definitions=validateWorkflows([...defaultWorkflows,{id:'ticket-views',name:'Legacy saved human decision',stepConfigVersion:'step-config-v1',steps:[{id:'choose',name:'Choose safely',type:'decide',view:{version:'view-v1',components:[{id:'brief',type:'markdown',data:{literal:{text:'Original accepted public definition'}}}]},decide:{items:{literal:[{id:'item0',title:'Original item'}]},actions:[{id:'skip',label:'Skip'}],ask:{prompt:'Only supplied context'}}}]}]);runtime.updateWorkflows(definitions);
 const run=runtime.create({repositoryId:'fixture',workspace:home,input:'Original synthetic ticket',workflow:definitions.at(-1),workflowDefinitions:definitions,triggerOrigin:{type:'manual',workflowId:'ticket-views'}});run.ticketReference={...taskbotSource('https://taskbot.example/p/fixture/t/77'),server:'taskbot'};
 void runtime.launch(run).catch(()=>{});await wait(()=>run.status==='waiting'&&run.viewRecords?.[0]?.notified&&(mode!=='notified-crash-gap'||entered));
 if(mode==='raw-native-failure'){
  await wait(()=>run.ticketSync?.receipts.some(r=>r.key==='view:'+run.viewDecision.id));
  const before=run.viewDecision;await runtime.askView(run.id,{batchId:before.id,digest:before.digest,itemId:'item0',question:'Explain old native startup failure safely',requestId:randomUUID()});await wait(()=>run.viewDecision.threads.item0[0].status==='failed');await runtime.flush(run.id);
 }
 cpSync(join(home,'factory'),join(out,mode,'factory'),{recursive:true});
 const files={};const collect=(base,prefix='')=>{for(const e of readdirSync(base,{withFileTypes:true})){const rel=join(prefix,e.name),p=join(base,e.name);if(e.isDirectory())collect(p,rel);else files[rel]=sha(readFileSync(p));}};collect(join(out,mode));
 provenance.fixtures.push({mode,runId:run.id,batchId:run.viewDecision.id,digest:run.viewDecision.digest,files});
 if(mode==='notified-crash-gap')release();await runtime.shutdown();
}
writeFileSync(join(out,'provenance-native-error.json.raw'),JSON.stringify(provenance,null,2)+'\n');console.log(JSON.stringify(provenance.fixtures.map(x=>({mode:x.mode,files:Object.keys(x.files).length,run:x.runId})),null,2));
