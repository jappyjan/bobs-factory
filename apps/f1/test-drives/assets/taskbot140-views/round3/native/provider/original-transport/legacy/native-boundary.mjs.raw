import {appendFileSync} from 'node:fs';import {spawnSync} from 'node:child_process';const args=process.argv.slice(2);const row={args,data:process.env.XDG_DATA_HOME,modelsFetch:process.env.OPENCODE_DISABLE_MODELS_FETCH};appendFileSync("/private/var/folders/5m/3pxzz_nd1v7f34rd9vnm01380000gn/T/taskbot140-round3-native-provider-5JAyxI/legacy/native-invocations.jsonl",JSON.stringify(row)+'\n');if(args[0]==='run'){process.stdout.write(JSON.stringify({type:'step_start',sessionID:'ses_owned_context'})+'\n'+JSON.stringify({type:'text',part:{text:'Controlled no-model context answer'}})+'\n'+JSON.stringify({type:'step_finish',reason:'stop'})+'\n');process.exit(0)}const r=spawnSync("/tmp/taskbot140-r2-standards/package/bin/opencode",args,{env:process.env,encoding:'utf8',timeout:5000});appendFileSync("/private/var/folders/5m/3pxzz_nd1v7f34rd9vnm01380000gn/T/taskbot140-round3-native-provider-5JAyxI/legacy/native-metadata-output.jsonl",JSON.stringify({...row,status:r.status,stdout:r.stdout,stderr:r.stderr})+'\n');process.stdout.write(r.stdout??'');process.stderr.write(r.stderr??'');process.exit(r.status??1);
