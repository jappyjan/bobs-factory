import assert from 'node:assert/strict';
import {spawnSync,execFileSync} from 'node:child_process';
import {createHash} from 'node:crypto';
import {appendFileSync,existsSync,mkdirSync,mkdtempSync,readFileSync,readdirSync,realpathSync,rmSync,writeFileSync} from 'node:fs';
import {tmpdir,platform,arch,release} from 'node:os';import {join} from 'node:path';
const repo=process.cwd(),out='/tmp/taskbot140-round3-native-provider';mkdirSync(out,{recursive:true,mode:0o700});
const {OpenCodeRunner}=await import(repo+'/packages/opencode-runner/dist/OpenCodeRunner.js');
const {initializeStore}=await import(repo+'/packages/opencode-runner/test/fixtures/context-store.ts');
const root=realpathSync(mkdtempSync(join(tmpdir(),'taskbot140-round3-native-provider-')));
const binary='/tmp/taskbot140-r2-standards/package/bin/opencode',sha=b=>createHash('sha256').update(b).digest('hex');
assert.equal(sha(readFileSync(binary)),'3036292cd25a74682d08545ae12de2cf1df864fea812934bfee1ec759f301083');
const receipt={result:'FAIL',head:execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim(),tree:execFileSync('git',['rev-parse','HEAD^{tree}'],{encoding:'utf8'}).trim(),dirty:execFileSync('git',['status','--porcelain'],{encoding:'utf8'}).trim(),at:new Date().toISOString(),node:process.version,bun:execFileSync('bun',['--version'],{encoding:'utf8'}).trim(),platform:platform(),arch:arch(),kernel:release(),native:{version:'1.2.27',path:binary,sha256:sha(readFileSync(binary))},driverSha256:sha(readFileSync(import.meta.filename)),directory:root,inputs:{},cases:[],paidCalls:0,nativeModelTurns:0,limits:['All authentication/history/files are disposable synthetic fixtures; no operator store or credential is read.','Native version/provider metadata commands execute the official pinned binary. Model run transport alone is intercepted; no native provider/model/network turn occurs.','Built-in SQLite is tested under source Node24 and Bun1.4.2, separately from the fresh native Factory binary smoke.','Repeated filesystem/WAL identity checks are not an atomic lock against external native-store replacement.']};
for(const p of ['packages/opencode-runner/src/OpenCodeRunner.ts','packages/opencode-runner/src/context-store.ts','packages/opencode-runner/src/config.ts','packages/opencode-runner/src/types.ts','packages/opencode-runner/src/node-sqlite.d.ts','packages/opencode-runner/dist/OpenCodeRunner.js','packages/opencode-runner/dist/context-store.js','packages/opencode-runner/test/fixtures/context-store.ts'])receipt.inputs[p]=sha(readFileSync(join(repo,p)));
function inventory(data){const rows={};function visit(dir,prefix=''){for(const entry of readdirSync(dir,{withFileTypes:true})){const rel=join(prefix,entry.name),path=join(dir,entry.name);if(entry.isDirectory())visit(path,rel);else rows[rel]={bytes:readFileSync(path).length,sha256:sha(readFileSync(path))};}}visit(data);return rows;}
function fixture(name){const home=join(root,name),dataHome=join(home,'data'),data=join(dataHome,'opencode'),calls=join(home,'native-invocations.jsonl'),wrapper=join(home,'native-boundary.mjs');for(const path of [data,join(home,'cwd'),join(home,'user-home')])mkdirSync(path,{recursive:true,mode:0o700});
 writeFileSync(wrapper,`#!/usr/bin/env node\nimport {appendFileSync} from 'node:fs';import {spawnSync} from 'node:child_process';const args=process.argv.slice(2);const row={args,data:process.env.XDG_DATA_HOME,modelsFetch:process.env.OPENCODE_DISABLE_MODELS_FETCH};appendFileSync(${JSON.stringify(calls)},JSON.stringify(row)+'\\n');if(args[0]==='run'){process.stdout.write(JSON.stringify({type:'step_start',sessionID:'ses_owned_context'})+'\\n'+JSON.stringify({type:'text',part:{text:'Controlled no-model context answer'}})+'\\n'+JSON.stringify({type:'step_finish',reason:'stop'})+'\\n');process.exit(0)}const r=spawnSync(${JSON.stringify(binary)},args,{env:process.env,encoding:'utf8',timeout:5000});appendFileSync(${JSON.stringify(join(home,'native-metadata-output.jsonl'))},JSON.stringify({...row,status:r.status,stdout:r.stdout,stderr:r.stderr})+'\\n');process.stdout.write(r.stdout??'');process.stderr.write(r.stderr??'');process.exit(r.status??1);\n`,{mode:0o700});
 return {home,dataHome,data,calls,config:{factoryHome:join(home,'factory'),workingDirectory:join(home,'cwd'),openCodePath:wrapper,toolProfile:'context-only',model:'openai/unused-no-model',childEnvironment:{PATH:process.env.PATH,HOME:join(home,'user-home'),XDG_DATA_HOME:dataHome},mcpConfig:{'factory-context':{type:'http',url:'http://127.0.0.1:1/context'}},onError:()=>{}}};}
function legacy(data){const files={'auth.json':{'https://unsafe.invalid':{type:'wellknown',key:'SYNTHETIC_AUTH',token:'synthetic-not-a-credential'}},'storage/project/proj_fixture.json':{worktree:'/synthetic',vcs:'git',time:{created:1,updated:1},sandboxes:[]},'storage/session/proj_fixture/ses_fixture.json':{slug:'fixture',directory:'/synthetic',title:'Synthetic native history',version:'1',time:{created:1,updated:1}},'storage/message/ses_fixture/msg_fixture.json':{role:'user',time:{created:1}},'storage/part/msg_fixture/prt_fixture.json':{type:'text',text:'SYNTHETIC FULL HISTORY MUST NOT BE IMPORTED DURING METADATA REFUSAL',time:{created:1}}};for(const[p,v]of Object.entries(files)){mkdirSync(join(data,p,'..'),{recursive:true});writeFileSync(join(data,p),JSON.stringify(v));}}
try{
 const old=fixture('legacy');legacy(old.data);const before=inventory(old.data),runner=new OpenCodeRunner(old.config);await runner.start('Refuse before every native metadata/version/run command');const after=inventory(old.data);assert.deepEqual(after,before);assert.equal(existsSync(join(old.data,'opencode.db')),false);assert.equal(existsSync(old.calls),false);assert.equal(runner.getMessages().at(-1).is_error,true);receipt.cases.push({name:'actual-legacy-store-before-any-native-invocation',before,after,databaseCreated:false,nativeInvocations:0,result:runner.getMessages().at(-1)});
 const initialized=fixture('initialized');initializeStore(initialized.dataHome,'ses_owned_context');writeFileSync(join(initialized.data,'auth.json'),JSON.stringify({synthetic:{type:'api',key:'synthetic-not-a-real-key'}}));const stable=inventory(initialized.data),safe=new OpenCodeRunner(initialized.config);const first=await safe.start('Only metadata is native; no native model run');assert.equal(safe.getMessages().at(-1).is_error,false);assert.deepEqual(inventory(initialized.data),stable);const calls=readFileSync(initialized.calls,'utf8').trim().split('\n').map(JSON.parse);assert.deepEqual(calls.map(x=>x.args[0]),['--version','providers','run']);assert.notEqual(calls[0].data,initialized.dataHome);assert.equal(calls[1].data,initialized.dataHome);assert.equal(calls[1].modelsFetch,'1');assert.deepEqual(calls[1].args,['providers','list','--print-logs']);receipt.cases.push({name:'actual-initialized-native-version-provider-metadata-and-controlled-model-transport',before:stable,after:inventory(initialized.data),calls,sessionId:first.sessionId,nativeMetadataCommands:2,nativeModelTurns:0,controlledTransportTurns:1});
 const bun=spawnSync('bun',['--eval',`import {inspectContextStore} from ${JSON.stringify(repo+'/packages/opencode-runner/dist/context-store.js')};const state=inspectContextStore(${JSON.stringify(initialized.dataHome)},'ses_owned_context');state.verify();console.log(JSON.stringify({bun:Bun.version,fresh:state.fresh,remoteOrg:state.remoteOrg}));`],{encoding:'utf8',timeout:5000});assert.equal(bun.status,0,bun.stderr);receipt.bunReadOnlyMetadata=JSON.parse(bun.stdout);assert.deepEqual(inventory(initialized.data),stable);
 rmSync(join(initialized.data,'opencode.db'));legacy(initialized.data);const lost=inventory(initialized.data),originalCalls=readFileSync(initialized.calls,'utf8');const resumed=new OpenCodeRunner({...initialized.config,resumeSessionId:'ses_owned_context'});const identity=await resumed.start('Retain native ID; never migrate or replace on resume');assert.equal(identity.sessionId,'ses_owned_context');assert.equal(resumed.getMessages().at(-1).is_error,true);assert.equal(readFileSync(initialized.calls,'utf8'),originalCalls);assert.deepEqual(inventory(initialized.data),lost);assert.equal(existsSync(join(initialized.data,'opencode.db')),false);receipt.cases.push({name:'attested-resume-after-marker-loss',before:lost,after:inventory(initialized.data),additionalNativeInvocations:0,sessionId:identity.sessionId,databaseCreated:false,result:resumed.getMessages().at(-1)});
 receipt.result='PASS';
}catch(error){receipt.error=error.stack;process.exitCode=1;}
receipt.finishedAt=new Date().toISOString();writeFileSync(join(out,'receipt.json'),JSON.stringify(receipt,null,2)+'\n');console.log(JSON.stringify({result:receipt.result,head:receipt.head,directory:root,scenarios:receipt.cases.length,paidCalls:0,nativeModelTurns:0}));
