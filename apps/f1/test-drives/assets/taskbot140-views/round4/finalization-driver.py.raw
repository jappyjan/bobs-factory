import json,re,hashlib,subprocess
from pathlib import Path
repo=Path.cwd();root=repo/'apps/f1/test-drives/assets/taskbot140-views';out=root/'round4';gates=Path('/tmp/taskbot140-round4-complete-validation')
sha=lambda b:hashlib.sha256(b).hexdigest()
r=json.loads((gates/'gates.json').read_text());assert r['result']=='pass'
log=(gates/'packages.log').read_text();packages=[];name=None
for line in log.splitlines():
 m=re.match(r'> (bobs-factory-[^@]+)@.* test:run ',line)
 if m:name=m[1]
 if re.match(r'\s*Test Files\s',line):
  files={k:int(v) for v,k in re.findall(r'(\d+) (passed|skipped)',line)}
 if re.match(r'\s*Tests\s',line):
  row={k:int(v) for v,k in re.findall(r'(\d+) (passed|skipped)',line)}
  assert name and 'passed' in row,line
  packages.append({'package':name,'files':{'passed':files.get('passed',0),'skipped':files.get('skipped',0)},'passed':row['passed'],'skipped':row.get('skipped',0)})
assert len(packages)==16,len(packages)
counts={'packages':packages,'passed':sum(p['passed'] for p in packages),'skipped':sum(p['skipped'] for p in packages),'passedFiles':sum(p['files']['passed'] for p in packages),'skippedFiles':sum(p['files']['skipped'] for p in packages),'logSha256':sha((gates/'packages.log').read_bytes())}
(out/'gates/package-counts.json').write_text(json.dumps(counts,indent=2)+'\n')
source=json.loads((gates/'source-inputs.json').read_text());native=json.loads((out/'native/build/build.json.raw').read_text());f1=json.loads((out/'f1/results.json.raw').read_text())
old=json.loads((root/'round3/input-equivalence.json').read_text())
assert native['commit']==source['head']==r['head']==f1['revision']
assert native['dirty'] is False
assert native['resourceDigest']==old['nativeBuild']['resourceDigest']
assert source['tree']==r['tree']==f1['tree']
assert source['fingerprint']==r['sourceFingerprint']
assert all(row['sourceAfter']==source['fingerprint'] and row['code']==0 and not row['signal'] for row in r['commands'])
assert len(r['commands'])==10
assert f1['deltaSha256']=='e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855'
assert f1['driverSha256']==sha(Path('apps/f1/test-drives/assets/taskbot140-views-round4.mjs').read_bytes())
assert len(f1['results'])==7 and f1['paidCalls']==0
assert re.search(r'(?:#|ℹ) pass 179(?:\n|$)', (gates/'scripts.log').read_text())
drivers=[]
for p in [row['path'] for row in old['drivers']]+['apps/f1/test-drives/assets/taskbot140-views-round4.mjs']:
 b=Path(p).read_bytes();drivers.append({'path':p,'mode':'100644','bytes':len(b),'sha256':sha(b)})
equiv={'validatedHead':source['head'],'validatedTree':source['tree'],'sourceFingerprint':source['fingerprint'],'sourceInputPaths':len(source['files']),'literalInputs':len(source['files'])-1,'drivers':drivers,'nonRuntimeLfsPointer':old['nonRuntimeLfsPointer'],'excludedAfterFreeze':'Only changelog/test-drive report/evidence paths may change. All production/test/config/dependency/resource literal bytes remain frozen3111; no changed backend reuse from94/3802.','nativeBuild':native,'reuse':'reuse/proof.json.raw','pinnedOriginal186Inventory':sha((root/'archive-sha256.json').read_bytes()),'pinnedOriginal577Inventory':sha((root/'round3/archive-sha256.json').read_bytes()),'historicalTargets':old['historicalTargets']+['94d809ff0c02fa5c07677d2f81d0c4b42641ff34','998de5de891db2000099e44fe6938c0a5b3bd375','20dc81e7aa61b2af924325c8b3f34875fa4fa683']}
(out/'input-equivalence.json').write_text(json.dumps(equiv,indent=2)+'\n')
text=Path('/tmp/taskbot140-round4-report-draft.md').read_text()
edge=next(p for p in packages if p['package']=='bobs-factory-edge-worker')
lint=(gates/'lint.log').read_text();lintfiles=re.search(r'Checked (\d+) files',lint)[1]
table=f'''| Command | Fresh result |
| --- | --- |
| `pnpm build` / `pnpm typecheck` | Exit0 / exit0. |
| `pnpm lint` | Exit0: {lintfiles}files,0errors,37 retained warnings. |
| `VITEST_MAX_WORKERS=1 npm_config_workspace_concurrency=1 pnpm test:packages:run` | Exit0: {counts['passed']}passed/{counts['skipped']}skipped,16packages; {counts['passedFiles']}passed files+{counts['skippedFiles']}native opt-in file skipped. Edge{edge['passed']}passed/{edge['skipped']}skipped/{edge['files']['passed']}files. |
| Serial `pnpm -r --filter './apps/*' test:run` | Exit0:255CLI+41desktop+17F1=313passed,1desktop skip. |
| `node --test --test-concurrency=2 scripts/tests/*.test.mjs` | Exit0:179passed,0fail/skips. |
| Actual current EdgeWorker/CLI F1 | Exit0:6root runs/7named rows,{f1['httpRequests']}protected requests,{f1['activityCount']}activities,13scripted role constructions+1actual unavailable-native start,zero paid calls. |
| Native ARM64 compilation / standard smoke / view smoke | All exit0; isolated startup/assets/protectedAPI/scopedMCP/shutdown/restart and26actual catalogue/schema/save/preview/reconstruction responses. |
'''
text=text.replace('__GATE_TABLE__',table)
text=text.replace('__F1_IDENTITY__',f"Executed driver SHA256 `{f1['driverSha256']}`; source3111/tree4f02, backend fingerprint `{f1['backendSourceSha256']}`, measured local whole-dist `{f1['buildSha256']}`. Six saved root runs/seven named rows,41protected requests/9activities,13scripted role constructions plus one actual unavailable Codex start; title mocks are separate.")
text=text.replace('__NATIVE_IDENTITY__',f"Fresh Factory executable **{native['executable']['size']}bytes**, SHA256 `{native['executable']['sha256']}`, clean3111/Bun{native['tooling']['bun']}/version{native['version']}/darwin-arm64.29-resource digest `{native['resourceDigest']}`. This is not an independently reproduced whole-dist aggregate claim.")
receipts=list((out/'native/views').rglob('native-views.json.raw'));assert len(receipts)==1
text=text.replace('__NATIVE_RECEIPT__',str(receipts[0].relative_to(repo/'apps/f1/test-drives')))
assert '__' not in text.replace('`__',''), 'Unfilled report placeholder'
(repo/'apps/f1/test-drives/2026-10-22-taskbot140-views-round4.md').write_text(text)
print(json.dumps({'counts':counts,'sourceInputs':len(source['files']),'drivers':len(drivers),'f1':f1['directory'],'native':native['executable']}))
