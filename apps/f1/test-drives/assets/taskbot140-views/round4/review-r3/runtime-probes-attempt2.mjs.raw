import assert from 'node:assert/strict';
import {randomUUID} from 'node:crypto';
import {mkdtempSync,mkdirSync,realpathSync,writeFileSync} from 'node:fs';
import {tmpdir} from 'node:os';import {join} from 'node:path';
const root=process.cwd(),out='/tmp/taskbot140-review-r3-fast2';
const {WorkflowRuntime}=await import(root+'/packages/edge-worker/dist/factory/WorkflowRuntime.js');
const {defaultWorkflows}=await import(root+'/packages/edge-worker/dist/factory/defaultWorkflows.js');
const {validateWorkflows}=await import(root+'/packages/edge-worker/dist/factory/Workflow.js');
const {TicketTracking,taskbotAdapter,taskbotSource}=await import(root+'/packages/edge-worker/dist/factory/TicketTracking.js');
const {CodexRunner}=await import(root+'/packages/codex-runner/dist/CodexRunner.js');
const {publicFailure}=await import(root+'/packages/core/dist/index.js');
const {viewRecordDigest}=await import(root+'/packages/edge-worker/dist/factory/ViewPresentation.js');
const {runPushEvent}=await import(root+'/packages/edge-worker/dist/factory/PushEvents.js');
const wait=async(fn)=>{let end=Date.now()+15000;while(!await fn()){if(Date.now()>end)throw Error('Probe timeout');await new Promise(r=>setTimeout(r,10));}};
const defer=()=>{let resolve;const promise=new Promise(r=>resolve=r);return{promise,resolve}};
const receipt={head:'94d809ff0c02fa5c07677d2f81d0c4b42641ff34',cases:[]};
async function fixture(child=false){
 const home=realpathSync(mkdtempSync(join(tmpdir(),'taskbot140-review-r3-probe-'))),childGate=defer(),askGate=defer(),readGate=defer();
 let holdRead=false,readEntered=false,diagnostic='',mode='held',runtime;
 const ticket={id:1,project:'synthetic',status:'backlog',body:'Public scope',comments:[],attachments:[]};
 const ref={...taskbotSource('https://taskbot.example/p/synthetic/t/1'),server:'taskbot'};
 const adapter=taskbotAdapter(ref,async(tool,args)=>{if(tool==='get_ticket'){if(holdRead){holdRead=false;readEntered=true;await readGate.promise;}return{content:[{type:'text',text:JSON.stringify(ticket)}]}}if(tool==='comment'){ticket.comments.push({body:args.body});return{content:[]}}if(tool==='set_status'){ticket.status=args.to;return{content:[]}}throw Error(tool)});
 const service=new TicketTracking(async()=>adapter,run=>runtime.save(run),()=>{});
 const hooks={agent:async context=>{
  if(context.step.id==='child'){context.signal.addEventListener('abort',()=>childGate.resolve(),{once:true});await childGate.promise;return{done:true}}
  if(mode==='held'){context.signal.addEventListener('abort',()=>askGate.resolve(),{once:true});await askGate.promise;return'Public held answer'}
  if(mode==='success')return'Public subsequent answer';
  const cwd=join(home,'empty-private-cwd');mkdirSync(cwd,{recursive:true,mode:0o700});
  const runner=new CodexRunner({workingDirectory:cwd,factoryHome:home,toolProfile:'context-only',codexHome:join(home,'codex'),codexPath:join(home,'private-provider-name','codex-unavailable'),childEnvironment:{HOME:home,PATH:'/usr/bin:/bin'},mcpConfig:{'factory-context':{command:'/usr/bin/true'}}});runner.on('error',()=>{});await runner.start('Unavailable executable; no model');const result=runner.getMessages().findLast(m=>m.type==='result');assert(result.is_error);diagnostic='Agent step failed: '+publicFailure(JSON.stringify(result));throw Error(diagnostic);
 },tool:async()=>{throw Error('Unexpected tool')},script:async()=>{throw Error('Unexpected script')},track:(run,m)=>service.record(run,m)};
 runtime=new WorkflowRuntime(home,hooks);
 const definitions=validateWorkflows([...defaultWorkflows,...(child?[{id:'child-recipe',name:'Child',stepConfigVersion:'step-config-v1',allowedTriggers:['workflow'],steps:[{id:'child',name:'Child',type:'agent',prompt:'Controlled child'}]}]:[]),{id:'probe',name:'Probe',stepConfigVersion:'step-config-v1',steps:[...(child?[{id:'launch',name:'Launch',type:'launch-runs',launchRuns:{items:{values:[{id:'a',title:'Child',prompt:'Child'}]},workflow:'child-recipe',wait:false,inputMapping:{prompt:'/prompt'}}}]:[]),{id:'choose',name:'Choose',type:'decide',notifications:{push:'view-text'},reads:child?{children:'@childRuns'}:{},view:{version:'view-v1',components:child?[{id:'children',type:'runList',data:{path:'/inputs/children'}}]:[{id:'brief',type:'markdown',data:{literal:{text:'Public artifact'}}}]},decide:{items:{literal:[{id:'a',title:'Public item'}]},actions:[{id:'skip',label:'Skip'}],ask:{prompt:'Context only'}}}]}]);runtime.updateWorkflows(definitions);
 const run=runtime.create({repositoryId:'synthetic',workspace:home,input:'Controlled probe',workflow:definitions.at(-1),workflowDefinitions:definitions,triggerOrigin:{type:'manual',workflowId:'probe'}});run.ticketReference=ref;void runtime.launch(run);
 const displays=()=>ticket.comments.filter(c=>c.body.includes('Decision batch:')).map(c=>c.body);
 await wait(()=>run.status==='waiting'&&displays().length===1);
 const ask=question=>runtime.askView(run.id,{batchId:run.viewDecision.id,digest:run.viewDecision.digest,itemId:'a',question,requestId:randomUUID()});
 return{home,run,service,hooks,get runtime(){return runtime},setMode:x=>mode=x,diagnostic:()=>diagnostic,displays,ask,childGate,askGate,readGate,hold:()=>holdRead=true,entered:()=>readEntered,reconstruct:async()=>{await runtime.flush(run.id);await runtime.shutdown();runtime=new WorkflowRuntime(home,hooks);const restored=runtime.get(run.id);void runtime.launch(restored);await wait(()=>restored.status==='waiting');return restored},stop:async()=>{childGate.resolve();askGate.resolve();readGate.resolve();await runtime.shutdown();service.stop()}};
}
const live=await fixture(true);
try{
 live.hold();await live.ask('Pending explanation while child changes');await wait(live.entered);
 const pending=structuredClone(live.run.viewDecision);live.childGate.resolve();await wait(()=>Object.values(live.run.launchActions)[0].progress.a.status==='completed');
 live.readGate.resolve();await wait(()=>live.displays().length>=2);
 const delivered=live.displays().at(-1),submitted={batchId:pending.id,digest:pending.digest,accepted:true,choices:[{itemId:'a',action:'skip'}]};
 let error;try{await live.runtime.replyView(live.run.id,'/view-answer '+JSON.stringify(submitted))}catch(e){error=e.message}
 receipt.cases.push({name:'held-ticket-read-real-child-source-change',home:live.home,initialBatch:pending.id,initialDigest:pending.digest,displayedChild:pending.view.components[0].data,currentChild:Object.values(live.run.launchActions)[0].progress.a.status,delivered,deliveredOldDigest:delivered.includes(pending.digest),replyError:error,renewedBatch:live.run.viewDecision.id,renewedDigest:live.run.viewDecision.digest});
 assert(error?.includes('Displayed content changed'));await wait(()=>live.run.viewDecision.id!==pending.id);
}finally{await live.stop()}
const privacy=await fixture();
try{
 privacy.setMode('failure');await privacy.ask('Explain native startup failure safely');await wait(()=>privacy.run.viewDecision.threads.a[0].status==='failed');await wait(()=>privacy.displays().at(-1).includes(privacy.run.viewDecision.digest));
 const record=privacy.run.viewRecords[0],before=structuredClone(record),initial=record.snapshot.digest;
 assert(privacy.diagnostic().includes('private-provider-name'));assert.equal(record.snapshot.threads.a[0].error,privacy.diagnostic());
 const alternative=structuredClone(record);alternative.snapshot.threads.a[0].error='Different PRIVATE diagnostics only';assert.equal(viewRecordDigest(privacy.run.id,alternative),viewRecordDigest(privacy.run.id,record));assert.deepEqual(record,before);
 for(const text of [JSON.stringify(privacy.runtime.humanViews.snapshot(privacy.run)),privacy.runtime.humanViews.displayText(privacy.run),...privacy.displays(),JSON.stringify(runPushEvent(privacy.run))])assert(!text.includes('private-provider-name'));
 privacy.setMode('success');await privacy.ask('A new independent Ask');await wait(()=>privacy.run.viewDecision.threads.a[1].status==='answered');await wait(()=>privacy.displays().at(-1).includes(privacy.run.viewDecision.digest));
 const restored=await privacy.reconstruct();assert(restored.viewRecords[0].snapshot.threads.a[0].error.includes('private-provider-name'));assert(restored.viewDecision.threads.a[1].answer==='Public subsequent answer');assert(!JSON.stringify(privacy.runtime.humanViews.snapshot(restored)).includes('private-provider-name'));
 receipt.cases.push({name:'actual-native-failure-then-success-restart-private-digest-invariance',home:privacy.home,initialFailedDigest:initial,currentDigest:restored.viewDecision.digest,privateRawRetained:true,publicPrivatePath:false,independentDiagnosticDigestInvariant:true,subsequentAnswer:restored.viewDecision.threads.a[1].answer,published:privacy.displays().length});
}finally{await privacy.stop()}
writeFileSync(out+'/runtime-probes.json',JSON.stringify(receipt,null,2)+'\n');console.log(JSON.stringify(receipt,null,2));
