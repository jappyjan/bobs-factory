import json,hashlib,shutil,subprocess
from pathlib import Path
repo=Path.cwd();dest=repo/'apps/f1/test-drives/assets/taskbot140-views/round4';gates=Path('/tmp/taskbot140-round4-complete-validation');r=json.loads((gates/'gates.json').read_text());assert r['result']=='pass',r['result'];assert all(x.get('code')==0 and not x.get('signal') for x in r['commands']);assert subprocess.check_output(['git','status','--porcelain'],text=True)==''
originals={}
def copy(src,target,raw=False):
 src=Path(src);target=dest/target
 if raw and target.suffix in ('.json','.mjs','.js','.py'):target=target.with_name(target.name+'.raw')
 target.parent.mkdir(parents=True,exist_ok=True);shutil.copyfile(src,target);originals[str(target.relative_to(repo))]=str(src)
def tree(src,target,raw=False):
 for p in sorted(Path(src).rglob('*')):
  if p.is_file():copy(p,Path(target)/p.relative_to(src),raw)
for p in gates.iterdir():
 if p.is_file():copy(p,Path('gates')/p.name,True)
copy('/tmp/taskbot140-round4-gates.mjs','gates/driver.mjs',True);copy('/tmp/taskbot140-round4-complete-gates-driver.log','gates/driver.log')
tree('/tmp/taskbot140-round4-focused','focused',True)
for source,label in [('/tmp/taskbot140-round4-validation','998'),('/tmp/taskbot140-round4-final-validation','20dc')]:tree(source,Path('historical')/label,True)
for source,label in [('/tmp/taskbot140-round4-gates-driver.log','998'),('/tmp/taskbot140-round4-final-gates-driver.log','20dc')]:copy(source,Path('historical')/label/'driver.log')
# Both earlier full drive attempts are authentic separate source identities.
for source,label in [('/private/var/folders/5m/3pxzz_nd1v7f34rd9vnm01380000gn/T/f1-taskbot140-views-round4-Teeu2r','998'),('/private/var/folders/5m/3pxzz_nd1v7f34rd9vnm01380000gn/T/f1-taskbot140-views-round4-ktoTjR','current')]:
 folder=Path(source)
 if label=='current':continue
 for p in folder.iterdir():
  if p.is_file():copy(p,Path('historical')/label/'f1'/p.name,True)
# Find original successful F1 directory from its actual stdout, never invent identity.
rows=[json.loads(line) for line in (gates/'f1.log').read_text().splitlines() if line.startswith('{') and '"result":"PASS"' in line];f1=Path(rows[-1]['directory'])
for p in f1.iterdir():
 if p.is_file():copy(p,Path('f1')/p.name,True)
#20dc successful partial-gate F1 directory is derived independently from that log.
rows=[json.loads(line) for line in Path('/tmp/taskbot140-round4-final-validation/f1.log').read_text().splitlines() if line.startswith('{') and '"result":"PASS"' in line]
for p in Path(rows[-1]['directory']).iterdir():
 if p.is_file():copy(p,Path('historical/20dc/f1')/p.name,True)
for p in Path('/tmp/taskbot140-round4-native-build').rglob('*'):
 if p.is_file() and (p.name in ['build.json','THIRD_PARTY_NOTICES.txt','LICENSE','NOTICE'] or p.name.endswith('.manifest.json')):copy(p,Path('native/build')/p.name,True)
tree('/tmp/taskbot140-round4-native-views','native/views',True)
copy('/tmp/taskbot140-round4-reuse.json','reuse/proof.json',True);copy('/tmp/taskbot140-round4-reuse.py','reuse/driver.py',True)
copy('/tmp/taskbot140-round4-runtime-identity.json','runtime-identity.json',True)
copy('/tmp/taskbot140-round4-runtime-identity.mjs','runtime-identity-driver.mjs',True)
review=Path('/tmp/taskbot140-review-r3-fast2')
for p in sorted(review.glob('runtime-probes*')):
 if p.is_file():copy(p,Path('review-r3')/p.name,True)
copy(review/'source-race.json','review-r3/source-race.json',True)
copy('/tmp/taskbot140-round4-collect.py','collection-driver.py',True)
copy('/tmp/taskbot140-round4-finalize.py','finalization-driver.py',True)
(dest/'original-copies.json').write_text(json.dumps(originals,indent=2)+'\n')
print(json.dumps({'copied':len(originals),'root':str(dest),'f1':str(f1)}))
